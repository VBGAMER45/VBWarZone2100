' Field: NET_LOBBY_OPT_FIELD (1 GNAME, 2 MAPNAME, 3 HOSTNAME)
Public Sub NETsetLobbyOptField(ByVal Value As String, ByVal Field As Long)
    Dim key() As Byte, n As Long
    Select Case Field
    Case NET_LOBBY_OPT_FIELD_GNAME
        gameDetails.name = Value
    Case NET_LOBBY_OPT_FIELD_MAPNAME
        gameDetails.map_name = netGame.formatGameName(Value)
        gameDetails.map_hash = netGame.gameHashString()     ' (!game.hash.isZero()) ? game.hash.toString() : ""
    Case NET_LOBBY_OPT_FIELD_HOSTNAME
        gameDetails.host_name = Value
        n = netGame.getMultiStatsIdentity(realSelectedPlayer, key)   ' getMultiStats(realSelectedPlayer).identity.toBytes(EcKey::Public)
        gameDetails.host_publicIdentity = base64Encode(key, n)
    Case Else
        debug_ 489, LOG_WARNING, "NETsetLobbyOptField", "Invalid field specified for NETsetGameOptField()"
        Exit Sub
    End Select

    NETupdateLobbyGameListing
End Sub

