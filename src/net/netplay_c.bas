'   NOTE: *MUST* be called from the main thread!
' (optional explicitPlayerIdx: hasExplicitPlayerIdx; optional customRejectionMessage: hasCustomRejectionMessage)
Public Function NETsetAsyncJoinApprovalResult(ByVal uniqueJoinID As String, ByVal action As Long, ByVal hasExplicitPlayerIdx As Boolean, _
        ByVal explicitPlayerIdx As Long, Optional ByVal rejectedReason As Long = 0, Optional ByVal hasCustomRejectionMessage As Boolean = False, _
        Optional ByVal customRejectionMessage As String = "") As Boolean
    Dim i As Long
    If action = AsyncJoinApprovalAction_Reject And rejectedReason = ERROR_NOERROR Then
        debug_ 552, LOG_INFO, "NETsetAsyncJoinApprovalResult", "Rejecting join with NOERROR reason changed to ERROR_KICKED"
        rejectedReason = ERROR_KICKED
    End If
    For i = 0 To MAX_TMP_SOCKETS - 1
        If tmp_connectState(i).connectState = TmpConnectState_PendingAsyncApproval And tmp_connectState(i).uniqueJoinID = uniqueJoinID Then
            ' found a match
            tmp_connectState(i).has_asyncJoinApprovalResult = True
            tmp_connectState(i).asyncJoinApprovalResult = action
            tmp_connectState(i).has_asyncJoinApprovalExplicitPlayerIdx = (action = AsyncJoinApprovalAction_Approve) And hasExplicitPlayerIdx
            tmp_connectState(i).asyncJoinApprovalExplicitPlayerIdx = explicitPlayerIdx And &HFF&
            If action <> AsyncJoinApprovalAction_Reject Then
                tmp_connectState(i).asyncJoinRejectCode = ERROR_NOERROR
            Else
                tmp_connectState(i).asyncJoinRejectCode = rejectedReason
            End If
            If hasCustomRejectionMessage Then
                tmp_connectState(i).asyncJoinRejectCustomMessage = customRejectionMessage
            End If
            NETsetAsyncJoinApprovalResult = True
            Exit Function
        End If
    Next

    ' no matching pending join - may have dropped in the interim, etc
    NETsetAsyncJoinApprovalResult = False
End Function

Private Function playersPerTeam() As Long
    Dim v As Long, maxPlayers As Long
    maxPlayers = netGame.gameMaxPlayers()
    For v = maxPlayers - 1 To 2 Step -1
        If maxPlayers Mod v = 0 Then
            playersPerTeam = v
            Exit Function
        End If
    Next
    playersPerTeam = 1
End Function

' Resets network properties of a player to safe defaults. Player slots should always be in this state
' before attemtping to assign a connectign player to it.
'
' Used to reset the player slot in NET_InitPlayer and to reset players slot without modifying ai/team/
' position configuration for the players.
Public Sub initPlayerNetworkProps(ByVal playerIndex As Long)
    Dim hostChatPermissions As Boolean
    ensureNetPlay
    NetPlay.players(playerIndex).allocated = False
    NetPlay.players(playerIndex).autoGame = False
    NetPlay.players(playerIndex).heartattacktime = 0
    NetPlay.players(playerIndex).heartbeat = False
    NetPlay.players(playerIndex).ready = False

    If Not NetPlay.players(playerIndex).wzFiles Is Nothing Then
        Set NetPlay.players(playerIndex).wzFiles = New Collection   ' wzFiles->clear()
    Else
        ASSERT_FAILURE "false", "lib/netplay/netplay.cpp:669", "initPlayerNetworkProps", "PLAYERS.wzFiles is uninitialized??"
    End If
    If playerIndex < MAX_CONNECTED_PLAYERS Then
        ' ingame.JoiningInProgress, PendingDisconnect, joinTimes, lastReadyTimes, lastNotReadyTimes, secondsNotReady,
        ' playerLeftGameTime of playerIndex reset, and its hostChatPermissions set
        If NetPlay.bComms Then hostChatPermissions = NETgetDefaultMPHostFreeChatPreference() Else hostChatPermissions = True
        netGame.initPlayerNetworkPropsIngame playerIndex, hostChatPermissions
    End If
End Sub

Public Sub NET_InitPlayer(ByVal i As Long, ByVal initPosition As Boolean, Optional ByVal initTeams As Boolean = False, Optional ByVal initSpectator As Boolean = False)
    Dim team As Long
    ensureNetPlay
    If Not ULT(i, NetPlay.playersSize) Then ASSERT_FAILURE "i < NetPlay.players.size()", "lib/netplay/netplay.cpp:686", "NET_InitPlayer", "Invalid player_id: (%u)", i: Exit Sub

    initPlayerNetworkProps i

    NetPlay.players(i).difficulty = AIDifficulty_DISABLED
    If netGame.ingameLocalJoiningInProgress() Then
        ' only clear name outside of games.
        netGame.clearPlayerName i
    End If
    If initPosition Then
        netGame.setPlayerColour i, i
        NetPlay.players(i).position = i
        team = i
        If initTeams Then
            If i < netGame.gameMaxPlayers() Then team = i \ playersPerTeam()
        End If
        NetPlay.players(i).team = team
    End If
    If NetPlay.bComms Then
        NetPlay.players(i).ai = AI_OPEN
    Else
        NetPlay.players(i).ai = 0
    End If
    NetPlay.players(i).faction = FACTION_NORMAL
    If initSpectator Then
        NetPlay.players(i).isSpectator = False
    End If
    NetPlay.players(i).isAdmin = False
End Sub

Public Function NET_numHumanPlayers() As Long
    Dim RetVal As Long, Inc As Long
    ensureNetPlay
    For Inc = 0 To MAX_PLAYERS - 1
        If NetPlay.players(Inc).allocated And Not NetPlay.players(Inc).isSpectator Then RetVal = RetVal + 1
    Next
    NET_numHumanPlayers = RetVal
End Function

' std::vector<uint8_t> NET_getHumanPlayers(void): RetVal(0 .. result - 1)
Public Function NET_getHumanPlayers(RetVal() As Long) As Long
    Dim n As Long, Inc As Long
    ensureNetPlay
    ReDim RetVal(0 To MAX_PLAYERS - 1)          ' RetVal.reserve(MAX_PLAYERS)
    For Inc = 0 To MAX_PLAYERS - 1
        If NetPlay.players(Inc).allocated And Not NetPlay.players(Inc).isSpectator Then
