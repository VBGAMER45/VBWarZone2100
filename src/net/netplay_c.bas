' Checks if there are *any* open slots (player *OR* spectator) for an incoming connection
Public Function NET_HasAnyOpenSlots() As Boolean
    Dim i As Long
    For i = 0 To MAX_CONNECTED_PLAYERS - 1
        If i = netGame.scavengerSlot() Then
            ' do not offer up the scavenger slot (this really needs to be refactored later - why is this a variable slot index?!?)
            GoTo continue_
        End If
        If i = PLAYER_FEATURE Then
            ' do not offer up this "player feature" slot - TODO: maybe remove the need for this slot?
            GoTo continue_
        End If
        If Not NetPlay.players(i).allocated And NetPlay.players(i).ai = AI_OPEN Then
            NET_HasAnyOpenSlots = True
            Exit Function
        End If
continue_:
    Next
    NET_HasAnyOpenSlots = False
End Function

' optional<bool> asSpectator: hasAsSpectator (C++'s default is false: hasAsSpectator = True, asSpectator = False)
Public Function NET_IsSlotOpenForPlayerJoin(ByVal i As Long, Optional ByVal forceTakeLowestAvailablePlayerNumber As Boolean = False, _
        Optional ByVal hasAsSpectator As Boolean = True, Optional ByVal asSpectator As Boolean = False) As Boolean
    Dim asSpectatorValueOrFalse As Boolean
    asSpectatorValueOrFalse = hasAsSpectator And asSpectator
    If Not forceTakeLowestAvailablePlayerNumber And Not asSpectatorValueOrFalse Then
        If i >= netGame.gameMaxPlayers() Or i >= MAX_PLAYERS Then
            NET_IsSlotOpenForPlayerJoin = False
            Exit Function
        End If
        If NetPlay.players(i).position >= netGame.gameMaxPlayers() Then
            ' Player slots are only supported where the player index and the player position is <= game.maxPlayers
            ' Skip otherwise
            NET_IsSlotOpenForPlayerJoin = False
            Exit Function
        End If
    End If
    If i = netGame.scavengerSlot() Then
        ' do not offer up the scavenger slot (this really needs to be refactored later - why is this a variable slot index?!?)
        NET_IsSlotOpenForPlayerJoin = False
        Exit Function
    End If
    If i = PLAYER_FEATURE Then
        ' do not offer up this "player feature" slot - TODO: maybe remove the need for this slot?
        NET_IsSlotOpenForPlayerJoin = False
        Exit Function
    End If

    If NetPlay.players(i).allocated Or NetPlay.players(i).ai <> AI_OPEN Then
        ' not an open slot
        NET_IsSlotOpenForPlayerJoin = False
        Exit Function
    End If
    If hasAsSpectator Then
        If asSpectator <> NetPlay.players(i).isSpectator Then
            NET_IsSlotOpenForPlayerJoin = False
            Exit Function
        End If
    End If
    NET_IsSlotOpenForPlayerJoin = True
End Function

' optional<uint32_t>: the result is has_value(), the index in result
Public Function NET_FindOpenSlotForPlayer(result As Long, Optional ByVal forceTakeLowestAvailablePlayerNumber As Boolean = False, _
        Optional ByVal hasAsSpectator As Boolean = True, Optional ByVal asSpectator As Boolean = False) As Boolean
    Dim index As Long, position As Long, i As Long
    index = -1
    position = &H7FFFFFFF                       ' INT_MAX
    For i = 0 To MAX_CONNECTED_PLAYERS - 1
        If Not NET_IsSlotOpenForPlayerJoin(i, forceTakeLowestAvailablePlayerNumber, hasAsSpectator, asSpectator) Then
            GoTo continue_
        End If
        ' find the lowest "position" slot that is available (unless forceTakeLowestAvailablePlayerNumber is set, in which case just take the first available)
        If NetPlay.players(i).position < position Then
            index = i
            position = NetPlay.players(i).position
            If forceTakeLowestAvailablePlayerNumber Then
                Exit For
            End If
        End If
continue_:
    Next

    If index = -1 Then
        NET_FindOpenSlotForPlayer = False
        Exit Function
    End If

    result = index
    NET_FindOpenSlotForPlayer = True
End Function

Public Function NET_CreatePlayerAtIdx(ByVal index As Long, ByVal name_ As String) As Boolean
    Dim buf As String
    If Not (Not NetPlay.players(index).allocated) Then ASSERT_FAILURE "!NetPlay.players[index].allocated", "lib/netplay/netplay.cpp:924", "NET_CreatePlayerAtIdx", "Player index (%u)already allocated!", index: NET_CreatePlayerAtIdx = False: Exit Function

    buf = sstrcpyN(va("A new player has been created. Player, %s, is set to slot %u", name_, index), 250)
    debug_ 929, LOG_NET, "NET_CreatePlayerAtIdx", "%s", buf
    NETlogEntry buf, SYNC_FLAG, index
    NET_InitPlayer index, False  ' re-init everything
    NetPlay.players(index).allocated = True
    NetPlay.players(index).difficulty = AIDifficulty_HUMAN
    NetPlay.players(index).heartbeat = True
    netGame.setPlayerName index, name_
    If Not NetPlay.players(index).isSpectator Then
        NetPlay.playercount = NetPlay.playercount + 1
    End If
    sync_counter.joins = (sync_counter.joins + 1) And &HFFFF&
    NET_CreatePlayerAtIdx = True
End Function

' optional<uint32_t>: the result is has_value(), the index in result
Public Function NET_CreatePlayer(result As Long, ByVal name_ As String, Optional ByVal forceTakeLowestAvailablePlayerNumber As Boolean = False, _
        Optional ByVal hasAsSpectator As Boolean = True, Optional ByVal asSpectator As Boolean = False) As Boolean
    Dim index As Long, s1 As String, s2 As String
    If Not NET_FindOpenSlotForPlayer(index, forceTakeLowestAvailablePlayerNumber, hasAsSpectator, asSpectator) Then
        If Not (hasAsSpectator And asSpectator) Then s1 = "player": s2 = "Could not find a place for player!" Else s1 = "spectator": s2 = "Could not find a place for spectator!"
        debug_ 949, LOG_INFO, "NET_CreatePlayer", "Could not find place for %s %s", s1, name_
        NETlogEntry s2, SYNC_FLAG, -1
        NET_CreatePlayer = False
        Exit Function
    End If

    If Not NET_CreatePlayerAtIdx(index, name_) Then
        ' should not happen
        NET_CreatePlayer = False
        Exit Function
    End If
    result = index
    NET_CreatePlayer = True
End Function

Public Sub NET_DestroyPlayer(ByVal index As Long, Optional ByVal suppressActivityUpdates As Boolean = False)
    Dim wasAllocated As Boolean
    If Not ULT(index, NetPlay.playersSize) Then ASSERT_FAILURE "index < NetPlay.players.size()", "lib/netplay/netplay.cpp:964", "NET_DestroyPlayer", "Invalid player_id: (%u)", index: Exit Sub
    debug_ 965, LOG_NET, "NET_DestroyPlayer", "Freeing slot %u for a new player", index
    NETlogEntry "Freeing slot for a new player.", SYNC_FLAG, index
    wasAllocated = NetPlay.players(index).allocated
    If NetPlay.players(index).allocated Then
        NetPlay.players(index).allocated = False
        If Not NetPlay.players(index).isSpectator Then
            NetPlay.playercount = NetPlay.playercount - 1
        End If
        gameDetails.players_current = NetPlay.playercount
        If allow_joining And NetPlay.isHost Then
            ' Update player count in the lobby by disconnecting
            ' and reconnecting
            NETupdateLobbyGameListing
        End If
    End If
    NET_InitPlayer index, False  ' reinitialize
    If wasAllocated And Not suppressActivityUpdates Then
        ' (ActivityManager::instance().updateMultiplayGameData(game, ingame, NETGameIsLocked()): the activity sinks, not ported)
    End If
End Sub

