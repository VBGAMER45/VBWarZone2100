Attribute VB_Name = "netplay_c"
' lib/netplay/netplay.cpp, lib/netplay/netplay.h: the local half of the message
' traffic: NETsend, NETflush and NETrecvNet (each does nothing without
' NetPlay.bComms; with it, no connection is open before cluster J, so every
' socket is nullptr), NETrecvGame, the delayed disconnects (none without a
' socket error), the players' connection status, messageTypeToString, the
' netcode version (NETisCorrectVersion, NETGetMajorVersion, ...),
' NET_InitPlayer(s) with initPlayerNetworkProps and playersPerTeam (the game's
' parts, multiplay.cpp's ingame and game, clearPlayerName and component.cpp's
' setPlayerColour, through INetGame), the players' info messages
' (NETBroadcastPlayerInfo, NETSendAllPlayerInfoTo, ...), the game's password
' and lock (NETsetGamePassword, NETGameLocked), and the host's start without
' comms (NEThostGame's !NetPlay.bComms branch, which calls the game's
' changeColour through INetGame), NEThaltJoining and NETsetLobbyLimitFlags.
' A PLAYER's wzFiles (the downloads, a host's) is not kept; NetPlay's
' playercount, gamePassword and GamePassworded are kept here (stubs_net's
' NETPLAY_ has the other fields). No lobby is hosted before cluster J
' (lobbyHostingHandler is nullptr), and the ActivityManager's
' updateMultiplayGameData (the activity sink) is not kept. The rest of
' netplay.cpp's settings are still in stubs_net.
Option Explicit

' lib/netplay/netplay_config.h (generated by autorevision_netplay.cmake): a tagged release build's
' NETCODE_VERSION_MAJOR is 0x4000 and NETCODE_VERSION_MINOR the count of annotated version tags up to
' its tag (VCS_TAG_TAG_COUNT). The shallow checkout in ref/warzone2100 has one tag; the official 4.7.0
' build's replays give 104.
Private Const NETCODE_VERSION_MAJOR As Long = &H4000&
Private Const NETCODE_VERSION_MINOR As Long = 104

Private Const AI_OPEN As Long = -2                  ' multiint.h
Private Const FACTION_NORMAL As Long = 0            ' faction.h
Private Const AIDifficulty_DISABLED As Long = -1    ' netplay.h
Private Const AIDifficulty_HUMAN As Long = -2       ' netplay.h
Private Const StringSize As Long = 64               ' netplay.h: size of strings used.
Private Const password_string_size As Long = 64     ' netplay.h: longer passwords slow down the join code
Private Const SYNC_FLAG As Long = &H10000000        ' netplay.h: special flag used for logging.

' src/multiplay.h: the structure limit flags NETsetLobbyLimitFlags reads
Private Const MPFLAGS_NO_TANKS As Long = &H1        ' Flag for tanks disabled
Private Const MPFLAGS_NO_CYBORGS As Long = &H2      ' Flag for cyborgs disabled
Private Const MPFLAGS_NO_VTOLS As Long = &H4        ' Flag for VTOLs disabled

' netlobby.h: enum class StructureLimits : uint8_t
Private Const StructureLimits_NO_TANKS As Long = &H1
Private Const StructureLimits_NO_BORGS As Long = &H2
Private Const StructureLimits_NO_VTOLS As Long = &H4

' NETPLAY NetPlay's fields that stubs_net's NETPLAY_ does not have
Private NetPlay_playercount As Long                 ' uint32_t: Number of players in game.
Private NetPlay_gamePassword As String              ' char[password_string_size]
Private NetPlay_GamePassworded As Boolean           ' if we have a password or not.

Private allow_joining As Boolean
Private lobby_disabled As Boolean                   ' (NET_setLobbyDisabled: the lobby, cluster J)

' static netlobby::GameDetails gameDetails: the fields used so far
Private gameDetails_isPrivate As Boolean
Private gameDetails_limits As Long                  ' uint8_t

' update flags
Public netPlayersUpdated As Boolean

' unsigned NET_PlayerConnectionStatus[CONNECTIONSTATUS_NORMAL][MAX_CONNECTED_PLAYERS]
Private NET_PlayerConnectionStatus(0 To CONNECTIONSTATUS_NORMAL - 1, 0 To MAX_CONNECTED_PLAYERS - 1) As Long

' static std::set<uint32_t> netSendPendingDisconnectPlayerIndexes: only
' NETsend's write errors add to it, and no socket is open here, so it stays
' empty
Private netSendPendingDisconnectCount As Long

Public Function NETisCorrectVersion(ByVal game_version_major As Long, ByVal game_version_minor As Long) As Boolean
    NETisCorrectVersion = NETCODE_VERSION_MAJOR = game_version_major And NETCODE_VERSION_MINOR = game_version_minor
End Function

Public Function NETisGreaterVersion(ByVal game_version_major As Long, ByVal game_version_minor As Long) As Boolean
    NETisGreaterVersion = ULT(NETCODE_VERSION_MAJOR, game_version_major) Or (game_version_major = NETCODE_VERSION_MAJOR And ULT(NETCODE_VERSION_MINOR, game_version_minor))
End Function

Public Function NETGetMajorVersion() As Long
    NETGetMajorVersion = NETCODE_VERSION_MAJOR
End Function

Public Function NETGetMinorVersion() As Long
    NETGetMinorVersion = NETCODE_VERSION_MINOR
End Function

Public Function NETGameIsLocked() As Boolean
    NETGameIsLocked = NetPlay_GamePassworded
End Function

Public Function NET_getLobbyDisabled() As Boolean
    NET_getLobbyDisabled = lobby_disabled
End Function

' Sets if the game is password protected or not
Public Sub NETGameLocked(ByVal flag As Boolean)
    Dim flagChanged As Boolean, s As String
    NetPlay_GamePassworded = flag
    flagChanged = gameDetails_isPrivate <> flag
    gameDetails_isPrivate = flag
    If allow_joining And NetPlay.isHost And flagChanged Then
        debug_ 440, LOG_NET, "NETGameLocked", "Updating game locked status."
        NETupdateLobbyGameListing
    End If
    If flagChanged Then
        ' (ActivityManager::instance().updateMultiplayGameData(game, ingame, NETGameIsLocked()): the activity sink, not kept)
    End If
    NETlogEntry "Password is", SYNC_FLAG, -CLng(NetPlay_GamePassworded)
    If NetPlay_GamePassworded Then s = "TRUE" Else s = "FALSE"
    debug_ 448, LOG_NET, "NETGameLocked", "Passworded game is %s", s
End Sub

' Sets the game password
Public Sub NETsetGamePassword(ByVal password As String)
    NetPlay_gamePassword = Left$(password, password_string_size - 1)    ' sstrcpy
    debug_ 521, LOG_NET, "NETsetGamePassword", "Password entered is: [%s]", NetPlay_gamePassword
    NETGameLocked True
End Sub

Private Function playersPerTeam() As Long
    Dim v As Long, maxPlayers As Long
    maxPlayers = netGame.gameMaxPlayers()
    For v = maxPlayers - 1 To 2 Step -1
        If maxPlayers Mod v = 0 Then
            playersPerTeam = v
            Exit Function
        End If
    Next
    playersPerTeam = 1
End Function

' Resets network properties of a player to safe defaults. Player slots should always be in this state
' before attemtping to assign a connectign player to it.
'
' Used to reset the player slot in NET_InitPlayer and to reset players slot without modifying ai/team/
' position configuration for the players.
Private Sub initPlayerNetworkProps(ByVal playerIndex As Long)
    Dim hostChatPermissions As Boolean
    set_NetPlay_players_allocated playerIndex, False
    set_NetPlay_players_autoGame playerIndex, False
    set_NetPlay_players_heartattacktime playerIndex, 0
    set_NetPlay_players_heartbeat playerIndex, False
    set_NetPlay_players_ready playerIndex, False

    ' (wzFiles->clear(): no downloads are kept; the else branch's ASSERT(false, "PLAYERS.wzFiles is uninitialized??")
    ' cannot happen, PLAYER's member initialiser makes wzFiles)
    If playerIndex < MAX_CONNECTED_PLAYERS Then
        ' ingame.JoiningInProgress, PendingDisconnect, joinTimes, lastReadyTimes, lastNotReadyTimes, secondsNotReady,
        ' playerLeftGameTime of playerIndex reset, and its hostChatPermissions set
        If NetPlay.bComms Then hostChatPermissions = NETgetDefaultMPHostFreeChatPreference() Else hostChatPermissions = True
        netGame.initPlayerNetworkPropsIngame playerIndex, hostChatPermissions
    End If
End Sub

' (VB) NetPlay.playercount for NetApi (the variable is Private here)
Public Function NetPlay_get_playercount() As Long
    NetPlay_get_playercount = NetPlay_playercount
End Function

Public Sub NET_InitPlayer(ByVal i As Long, ByVal initPosition As Boolean, Optional ByVal initTeams As Boolean = False, Optional ByVal initSpectator As Boolean = False)
    Dim team As Long
    If Not ULT(i, NetPlay_players_size()) Then ASSERT_FAILURE "i < NetPlay.players.size()", "lib/netplay/netplay.cpp:686", "NET_InitPlayer", "Invalid player_id: (%u)", i: Exit Sub

    initPlayerNetworkProps i

    set_NetPlay_players_difficulty i, AIDifficulty_DISABLED
    If netGame.ingameLocalJoiningInProgress() Then
        ' only clear name outside of games.
        netGame.clearPlayerName i
    End If
    If initPosition Then
        netGame.setPlayerColour i, i
        set_NetPlay_players_position i, i
        team = i
        If initTeams Then
            If i < netGame.gameMaxPlayers() Then team = i \ playersPerTeam()
        End If
        set_NetPlay_players_team i, team
    End If
    If NetPlay.bComms Then
        set_NetPlay_players_ai i, AI_OPEN
    Else
        set_NetPlay_players_ai i, 0
    End If
    set_NetPlay_players_faction i, FACTION_NORMAL
    If initSpectator Then
        set_NetPlay_players_isSpectator i, False
    End If
    set_NetPlay_players_isAdmin i, False
End Sub

Public Sub NET_InitPlayers(Optional ByVal initTeams As Boolean = False, Optional ByVal initSpectator As Boolean = False)
    Dim i As Long
    For i = 0 To MAX_CONNECTED_PLAYERS - 1
        NET_InitPlayer i, True, initTeams, initSpectator
        ' (the game's ingame.muteChat[i] = false and quickchat.cpp's playerSpamMuteReset(i): the chat, clusters G and J)
        netGame.clearPlayerName i
        NETinitQueue NETnetQueue(i)
    Next
    ' (multistat.cpp's resetRecentScoreData: the recent score data, cluster J)
    NETinitQueue NETbroadcastQueue()

    NetPlay.hostPlayer = NET_HOST_ONLY  ' right now, host starts always at index zero
    NetPlay_playercount = 0
    ' (DownloadingWzFiles.clear() and NET_waitingForIndexChangeAckSince: not kept before cluster J)
    debug_ 759, LOG_NET, "NET_InitPlayers", "Players initialized"
End Sub

' index(0 .. indexLen - 1)
Private Sub NETSendNPlayerInfoTo(index() As Long, ByVal indexLen As Long, ByVal to_ As Long)
    Dim w As MessageWriter, n As Long, genericName As String
    If Not NetPlay.isHost Then ASSERT_FAILURE "false", "lib/netplay/netplay.cpp:764", "NETSendNPlayerInfoTo", "Host only routine detected for client!": Exit Sub
    Set w = NETbeginEncode(NETnetQueue(to_), NET_PLAYER_INFO)
    NETuint32_t_w w, indexLen
    For n = 0 To indexLen - 1
        debug_ 769, LOG_NET, "NETSendNPlayerInfoTo", "sending player's (%u) info to all players", index(n)
        NETlogEntry "Sending player's info to all players", SYNC_FLAG, index(n)
        NETuint32_t_w w, index(n)
        NETbool_w w, NetPlay_players_allocated(index(n))
        NETbool_w w, NetPlay_players_heartbeat(index(n))
        NETbool_w w, False ' to maintain message format, send false in place of old "kick" variable // FUTURE TODO: Remove
        If netGame.isBlindPlayerInfoState() And index(n) < MAX_PLAYER_SLOTS Then ' if in blind player info state and an actual player slot (not a spectator slot)
            ' send a generic player name
            genericName = netGame.getPlayerGenericName(index(n))
            NETstring_w w, genericName, Len(genericName) + 1
        Else
            ' send the actual player name
            NETstring_w w, NetPlay_players_name(index(n)), StringSize
        End If
        NETuint32_t_w w, NetPlay_players_heartattacktime(index(n))
        NETint32_t_w w, NetPlay_players_colour(index(n))
        NETint32_t_w w, NetPlay_players_position(index(n))
        NETint32_t_w w, NetPlay_players_team(index(n))
        NETbool_w w, NetPlay_players_ready(index(n))
        NETint8_t_w w, NetPlay_players_ai(index(n))
        NETint8_t_w w, NetPlay_players_difficulty(index(n))
        NETuint8_t_w w, NetPlay_players_faction(index(n))
        NETbool_w w, NetPlay_players_isSpectator(index(n))
        NETbool_w w, NetPlay_players_isAdmin(index(n))
    Next
    NETend_w w
    ' (ActivityManager::instance().updateMultiplayGameData(game, ingame, NETGameIsLocked()): the activity sink, not kept)
End Sub

Private Sub NETSendPlayerInfoTo(ByVal index As Long, ByVal to_ As Long)
    Dim indices(0 To 0) As Long
    indices(0) = index
    NETSendNPlayerInfoTo indices, 1, to_
End Sub

Public Sub NETSendAllPlayerInfoTo(ByVal to_ As Long)
    Dim indices(0 To MAX_CONNECTED_PLAYERS - 1) As Long, i As Long   ' static uint32_t indices[MAX_CONNECTED_PLAYERS]
    For i = 0 To MAX_CONNECTED_PLAYERS - 1
        indices(i) = i
    Next
    If Not (NetPlay.isHost = True) Then ASSERT_FAILURE "NetPlay.isHost == true", "lib/netplay/netplay.cpp:814", "NETSendAllPlayerInfoTo", "Invalid call for non-host": Exit Sub

    NETSendNPlayerInfoTo indices, MAX_CONNECTED_PLAYERS, to_
End Sub

Public Sub NETBroadcastTwoPlayerInfo(ByVal index1 As Long, ByVal index2 As Long)
    Dim indices(0 To 1) As Long
    If Not NetPlay.isHost Then ASSERT_FAILURE "false", "lib/netplay/netplay.cpp:821", "NETBroadcastTwoPlayerInfo", "Host only routine detected for client!": Exit Sub
    indices(0) = index1
    indices(1) = index2
    NETSendNPlayerInfoTo indices, 2, NET_ALL_PLAYERS
End Sub

Public Sub NETBroadcastPlayerInfo(ByVal index As Long)
    If Not NetPlay.isHost Then
        Exit Sub
    End If
    NETSendPlayerInfoTo index, NET_ALL_PLAYERS
End Sub

Public Sub NETsendProcessDelayedActions()
    If netSendPendingDisconnectCount = 0 Then
        Exit Sub
    End If

    ' (the pending disconnects: NETplayerClientsDisconnect comes with the connections, cluster J)
End Sub

' ////////////////////////////////////////////////////////////////////////
' Send a message to a player, option to guarantee message
Public Function NETsend(ByVal queue As Long, ByVal message As NetMessage) As Boolean
    Dim player As Long, isTmpQueue As Boolean, sender As Long, w As MessageWriter
    player = NETQUEUE_index(queue)

    If Not NetPlay.bComms Then
        NETsend = True
        Exit Function
    End If

    ' IClientConnection** sockets = connected_bsocket; (every socket is nullptr: no connection is open before cluster J)
    isTmpQueue = False
    Select Case NETQUEUE_queueType(queue)
    Case QUEUE_BROADCAST
        If Not (player = NET_ALL_PLAYERS) Then ASSERT_FAILURE "player == NET_ALL_PLAYERS", "lib/netplay/netplay.cpp:1596", "NETsend", "Wrong queue index.": NETsend = False: Exit Function
    Case QUEUE_NET
        If Not (player < MAX_CONNECTED_PLAYERS) Then ASSERT_FAILURE "player < MAX_CONNECTED_PLAYERS", "lib/netplay/netplay.cpp:1599", "NETsend", "Wrong queue index.": NETsend = False: Exit Function
    Case QUEUE_TMP
        ' sockets = tmp_socket;
        isTmpQueue = True

        If Not (player < MAX_TMP_SOCKETS And NetPlay.isHost) Then ASSERT_FAILURE "player < MAX_TMP_SOCKETS && NetPlay.isHost", "lib/netplay/netplay.cpp:1605", "NETsend", "Wrong queue index.": NETsend = False: Exit Function
    Case Else
        ASSERT_FAILURE "false", "lib/netplay/netplay.cpp:1608", "NETsend", "Wrong queue type.": NETsend = False: Exit Function
    End Select

    If NetPlay.isHost Then
        ' We are the host, send directly to player: to each player from
        ' firstPlayer to lastPlayer whose socket is not nullptr and who is not
        ' queue.exclude. (No socket is open yet: nothing is sent.)
        NETsend = True
        Exit Function
    ElseIf player = NetPlay.hostPlayer Then
        ' We are a client, send directly to player, who happens to be the host.
        ' (bsocket is nullptr: no connection is open yet)
    Else
        ' We are a client and can't send the data directly, ask the host to send the data to the player.
        sender = selectedPlayer
        Set w = NETbeginEncode(NETnetQueue(NetPlay.hostPlayer), NET_SEND_TO_PLAYER)
        NETuint8_t_w w, sender
        NETuint8_t_w w, player
        NETnetMessage_w w, message
        NETend_w w
        NETsend = True
        Exit Function
    End If

    NETsend = False
End Function

Public Sub NETflush()
    If Not NetPlay.bComms Then
        Exit Sub
    End If

    NETflushGameQueues

    ' (the sockets' flush: no connection is open before cluster J; with none
    ' open, the host has no player sockets to check or flush, and a client
    ' has no bsocket)
End Sub

' ////////////////////////////////////////////////////////////////////////
' Receive a message over the current connection. We return true if there
' is a message for the higher level code to process, and false otherwise.
' We should not block here.
Public Function NETrecvNet(queue As Long, typ As Long) As Boolean
    If Not NetPlay.bComms Then
        NETrecvNet = False
        Exit Function
    End If

    ' (the connections, NETprocessSystemMessage and the net queues' messages: cluster J)
    NETrecvNet = False
End Function

Public Function NETrecvGame(queue As Long, typ As Long) As Boolean
    Dim current As Long
    For current = 0 To MAX_GAMEQUEUE_SLOTS - 1
        queue = NETgameQueue(current)
        If NETQUEUE_queueIsNull(queue) Then
            GoTo continue_
        End If
        Do While Not netGame.checkPlayerGameTime(current)  ' Check for any messages that are scheduled to be read now.
            If Not NETisMessageReady(queue) Then
                NETrecvGame = False             ' Still waiting for messages from this player, and all players should process messages in the same order. Will have to freeze the game while waiting.
                Exit Function
            End If

            NETreplaySaveNetMessage NETgetMessage(queue), NETQUEUE_index(queue)
            typ = NETgetMessage(queue).type_()

            If typ = GAME_GAME_TIME Then
                netGame.recvPlayerGameTime queue
                NETpop queue
                GoTo nextMessage
            End If

            NETrecvGame = True                  ' Have a message ready to read now.
            Exit Function
nextMessage:
        Loop
continue_:
    Next

    NETrecvGame = False                         ' No messages sceduled to be read yet. Game can continue.
End Function

Private Sub NETupdateLobbyGameListing()
    ' (lobbyHostingHandler is nullptr: no lobby before cluster J)
    Exit Sub
End Sub

Public Sub NETsetLobbyLimitFlags(ByVal ingameLimitFlags As Long)
    Dim priorLimits As Long
    priorLimits = gameDetails_limits

    gameDetails_limits = 0

    If (ingameLimitFlags And MPFLAGS_NO_TANKS) <> 0 Then
        gameDetails_limits = gameDetails_limits Or StructureLimits_NO_TANKS
    End If
    If (ingameLimitFlags And MPFLAGS_NO_CYBORGS) <> 0 Then
        gameDetails_limits = gameDetails_limits Or StructureLimits_NO_BORGS
    End If
    If (ingameLimitFlags And MPFLAGS_NO_VTOLS) <> 0 Then
        gameDetails_limits = gameDetails_limits Or StructureLimits_NO_VTOLS
    End If

    If priorLimits <> gameDetails_limits Then
        NETupdateLobbyGameListing
    End If
End Sub

' (VB) the EcKey playerIdentity is left out: only the connections use it (cluster J)
Public Function NEThostGame(ByVal SessionName As String, ByVal PlayerName As String, ByVal spectatorHost As Boolean, _
                            ByVal gameType As Long, ByVal blindMode As Long, _
                            ByVal plyrs As Long, _
                            ByVal defaultOpenSpectatorSlots As Long, _
                            ByVal alliancesType As Long, ByVal techLevel As Long, ByVal powerLevel As Long, ByVal basesLevel As Long) As Boolean
    Dim playerIndex As Long
    debug_ 4586, LOG_NET, "NEThostGame", "NEThostGame(%s, %s, %u, %u, %u)", SessionName, PlayerName, _
          gameType, blindMode, plyrs

    netPlayersUpdated = True

    For playerIndex = 0 To MAX_CONNECTED_PLAYERS - 1
        initPlayerNetworkProps playerIndex
    Next
    If Not NetPlay.bComms Then
        If Not (Not spectatorHost) Then ASSERT_FAILURE "!spectatorHost", "lib/netplay/netplay.cpp:4597", "NEThostGame", "spectatorHost flag will be ignored"
        selectedPlayer = 0
        realSelectedPlayer = selectedPlayer
        NetPlay.isHost = True
        NetPlay.hostPlayer = selectedPlayer
        set_NetPlay_players_allocated 0, True
        set_NetPlay_players_difficulty 0, AIDifficulty_HUMAN
        NetPlay_playercount = 1
        debug_ 4605, LOG_NET, "NEThostGame", "Hosting but no comms"
        ' Now switch player color of the host to what they normally use for MP games
        If netGame.warGetMPcolour() >= 0 Then
            netGame.changeColour NetPlay.hostPlayer, netGame.warGetMPcolour(), realSelectedPlayer
        End If
        NEThostGame = True
        Exit Function
    End If

    ' (no connection provider before cluster J: the listening socket, the socket set, the lobby's game listing and
    ' the rest of the host's start come with the connections)
    ASSERT_FAILURE "activeConnProvider != nullptr", "lib/netplay/netplay.cpp:4614", "NEThostGame", "Active connection provider is not set!"
    NEThostGame = False
End Function

