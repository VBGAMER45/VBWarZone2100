    If Not NetPlay.isHost Then ASSERT_FAILURE "false", "lib/netplay/netplay.cpp:992", "NETplayerHasConnection", "Host only routine detected for client!": NETplayerHasConnection = False: Exit Function
    If Not ULT(index, MAX_CONNECTED_PLAYERS) Then ASSERT_FAILURE "index < MAX_CONNECTED_PLAYERS", "lib/netplay/netplay.cpp:993", "NETplayerHasConnection", "Invalid index: %u", index: NETplayerHasConnection = False: Exit Function
    NETplayerHasConnection = Not connected_bsocket(index) Is Nothing
