Public Sub NETsendGameFlags()
    Dim w As MessageWriter, i As Long, count As Long
    If Not NetPlay.isHost Then ASSERT_FAILURE "false", "lib/netplay/netplay.cpp:1251", "NETsendGameFlags", "Host only routine detected for client!": Exit Sub
    debug_ 1252, LOG_NET, "NETsendGameFlags", "sending game flags"
    Set w = NETbeginEncode(NETbroadcastQueue(), NET_GAME_FLAGS)
    ' Send the amount of game flags we're about to send
    count = 4                                   ' ARRAY_SIZE(NetGameFlags)
    NETuint8_t_w w, count

    ' Send over all game flags
    For i = 0 To count - 1
        NETint32_t_w w, NetGameFlags(i)
    Next
    NETend_w w
