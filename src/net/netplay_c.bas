' (VB) std::chrono::steady_clock::now(), in milliseconds
Public Function steadyNowMs() As Double
    Dim c As Currency
    If qpcFreq = 0 Then QueryPerformanceFrequency qpcFreq
    QueryPerformanceCounter c
    steadyNowMs = CDbl(c) * 1000# / CDbl(qpcFreq)
End Function

' NETPLAY::NETPLAY() and the file statics' initialisers (masterserver_name and the settings are set by the
' game's configuration); called before NetPlay is first used
Public Sub ensureNetPlay()
    Dim i As Long
    If netPlayReady Then Exit Sub
    netPlayReady = True
    bJoinPrefTryIPv6First = True
    bDefaultHostFreeChatEnabled = True
    bEnableTCPNoDelay = True
    hostJoinOptions_botProt = 0         ' HostJoinOptionValue::BlockAll
    hostJoinOptions_proxyIPs = 1        ' HostJoinOptionValue::BlockSuspicious
    hostJoinOptions_hostingIPs = 0      ' HostJoinOptionValue::BlockAll
    lobbyDirectJoinOption = LobbyHostDirectJoinOption_Local
    ReDim NetPlay.players(0 To MAX_CONNECTED_PLAYERS)       ' (VB) one more for the replay spectator's slot
    NetPlay.playersSize = MAX_CONNECTED_PLAYERS             ' players.resize(MAX_CONNECTED_PLAYERS)
    For i = 0 To MAX_CONNECTED_PLAYERS
        PLAYER_construct NetPlay.players(i)
    Next
    ReDim NetPlay.scriptSetPlayerDataStrings(0 To MAX_PLAYERS - 1)  ' scriptSetPlayerDataStrings.resize(MAX_PLAYERS)
    For i = 0 To MAX_PLAYERS - 1
        Set NetPlay.scriptSetPlayerDataStrings(i) = New Collection
    Next
    ReDim NetPlay.playerReferences(0 To MAX_CONNECTED_PLAYERS - 1)  ' playerReferences.resize(MAX_CONNECTED_PLAYERS)
    For i = 0 To MAX_CONNECTED_PLAYERS - 1
        Set NetPlay.playerReferences(i) = PlayerReference_new(i)
    Next
End Sub

