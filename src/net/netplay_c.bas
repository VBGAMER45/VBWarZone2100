' (suppressActivityUpdates: the activity manager is cluster J's)
Private Sub NET_DestroyPlayer(ByVal index As Long, Optional ByVal suppressActivityUpdates As Boolean = False)
    Dim wasAllocated As Boolean
    If Not ULT(index, NetPlay_players_size()) Then ASSERT_FAILURE "index < NetPlay.players.size()", "lib/netplay/netplay.cpp:964", "NET_DestroyPlayer", "Invalid player_id: (%u)", index: Exit Sub
    debug_ 965, LOG_NET, "NET_DestroyPlayer", "Freeing slot %u for a new player", index
    NETlogEntry "Freeing slot for a new player.", SYNC_FLAG, index
    wasAllocated = NetPlay_players_allocated(index)
    If NetPlay_players_allocated(index) Then
        set_NetPlay_players_allocated index, False
        If Not NetPlay_players_isSpectator(index) Then
            NetPlay_playercount = NetPlay_playercount - 1
        End If
        ' (gameDetails.players.current = NetPlay.playercount, and NETupdateLobbyGameListing when
        ' allow_joining && NetPlay.isHost: the lobby server, cluster J)
    End If
    NET_InitPlayer index, False  ' reinitialize
    ' (wasAllocated && !suppressActivityUpdates: ActivityManager::updateMultiplayGameData, cluster J)
End Sub

' ////////////////////////////////////////////////////////////////////////
'close the open game..
' (VB: no socket is open before cluster J: the sockets' part is left out)
Public Function NETclose() As Long
    Dim i As Long
    NEThaltJoining False

    debug_ 1449, LOG_NET, "NETclose", "Terminating sockets."

    NetPlay.isHost = False
    ' (server_not_there, knownExternalIPv4Info: the sockets')
    allow_joining = False

    For i = 0 To MAX_CONNECTED_PLAYERS - 1
        ' (connected_bsocket[i]: none)
        NET_DestroyPlayer i, True
    Next

    ' (tmp_socket_set, tmp_socket[], client/server_socket_set, server_listen_socket, bsocket: none;
    ' playerManagementRecord: cluster J)
    NETclose = 0
End Function

