' ////////////////////////////////////////////////////////////////////////
' Set a game flag
Public Function NETsetGameFlags(ByVal flag As Long, ByVal value As Long) As Boolean
    If Not NetPlay.bComms Then
        NETsetGameFlags = True
        Exit Function
    End If

    If flag > 0 And flag < 5 Then
        NetGameFlags(flag - 1) = value
        NETsetGameFlags = value <> 0            ' return (NetGameFlags[flag - 1] = value);
        Exit Function
    End If

    NETsendGameFlags

    NETsetGameFlags = True
End Function

' static PortMappingInternetProtocol getPreferredPortMappingProtocol(WzConnectionProvider& connProvider)
Private Function getPreferredPortMappingProtocol(ByVal connProvider As WzConnectionProvider) As Long
    Dim supportedProtocolTypes As Long, res As Long
    ' We currently support creating only IPV4 port mappings.
    Const IPV4_PROTOCOL_KINDS As Long = PortMappingInternetProtocol_TCP_IPV4 Or PortMappingInternetProtocol_UDP_IPV4

    supportedProtocolTypes = connProvider.portMappingProtocolTypes()
    res = supportedProtocolTypes And IPV4_PROTOCOL_KINDS
    If Not (res = PortMappingInternetProtocol_TCP_IPV4 Or res = PortMappingInternetProtocol_UDP_IPV4) Then ASSERT_FAILURE "res == PortMappingInternetProtocol::TCP_IPV4 || res == PortMappingInternetProtocol::UDP_IPV4", "lib/netplay/netplay.cpp:1294", "getPreferredPortMappingProtocol", "Unexpected port mapping protocol"
    getPreferredPortMappingProtocol = res
End Function

Public Sub NETaddRedirects()
    If activeConnProvider Is Nothing Then ASSERT_FAILURE "activeConnProvider != nullptr", "lib/netplay/netplay.cpp:1300", "NETaddRedirects", "No active connection provider": Exit Sub
    ' auto& pmm = PortMappingManager::instance();
    Set ipv4MappingRequest = PortMappingManager_create_port_mapping(gameserver_port, getPreferredPortMappingProtocol(activeConnProvider))
    If ipv4MappingRequest Is Nothing Then
        debug_ 1305, LOG_NET, "NETaddRedirects", "Failed to create port mapping!"
        ' Workaround: Delay console message until next main loop iteration, to ensure it gets displayed in the chat box
        ' (VB: shown at once)
        netGame.addConsoleMessage "Failed to create port mapping" & vbLf & va("Manually configure your router/firewall to open port %d!", NETgetGameserverPort())
        Exit Sub
    End If
    debug_ 1315, LOG_NET, "NETaddRedirects", "Port mapping creation is in progress..."
    ' Report the user-visible status once the discovery is finished.
    PortMappingManager_attach_callback ipv4MappingRequest, PMCB_NETaddRedirects
End Sub

' NETaddRedirects's success callback: [](std::string extIp, uint16_t extPort) { ... }
Public Sub NETaddRedirects_successCb(ByVal extIp As String, ByVal extPort As Long)
    Dim msg As String
    msg = va("Port mapping opened external port: %u", extPort)
    msg = msg & vbLf
    msg = msg & va("Your external IP is: %s", extIp)
    netGame.addConsoleMessage msg
End Sub

' NETaddRedirects's failure callback: [](PortMappingDiscoveryStatus status) { ... }
Public Sub NETaddRedirects_failureCb(ByVal status As PortMappingDiscoveryStatus)
    Dim msg As String
    If status = PortMappingDiscoveryStatus_TIMEOUT Then
        msg = "Failed to create port mapping (timeout)"
    Else
        msg = "Failed to create port mapping"
    End If
    msg = msg & vbLf
    msg = msg & va("Manually configure your router/firewall to open port %d!", NETgetGameserverPort())
    netGame.addConsoleMessage msg
End Sub

Public Sub NETremRedirects()
    If ipv4MappingRequest Is Nothing Then
        Exit Sub
    End If
    If Not PortMappingManager_destroy_port_mapping(ipv4MappingRequest) Then
        debug_ 1348, LOG_ERROR, "NETremRedirects", "Failed to remove IPv4 port mapping for the game. You must manually remove it from your router."
        Exit Sub
    End If
    debug_ 1351, LOG_NET, "NETremRedirects", "Removed port mapping for port %d (IPv4).", gameserver_port
    Set ipv4MappingRequest = Nothing
End Sub

Public Sub NETinitPortMapping()
    If Not NetPlay.isPortMappingEnabled Then
        debug_ 1359, LOG_INFO, "NETinitPortMapping", "Automatic port mapping setup disabled by user."
        Exit Sub
    End If
    PortMappingManager_init
    NETaddRedirects
End Sub

' ////////////////////////////////////////////////////////////////////////
' setup stuff
Public Function NETinit(ByVal pt As Long) As Long
    Dim connProvider As WzConnectionProvider
    debug_ 1370, LOG_NET, "NETinit", "NETinit"
    NETlogEntry "NETinit!", SYNC_FLAG, selectedPlayer
    NET_InitPlayers True, True

    ConnectionProviderRegistry_Register pt
    Set connProvider = ConnectionProviderRegistry_Get(pt)
    If connProvider Is Nothing Then ASSERT_FAILURE "connProvider != nullptr", "lib/netplay/netplay.cpp:1376", "NETinit", "Null connectionProvider": NETinit = 1: Exit Function
    connProvider.initialize
    PendingWritesManagerMap_get(connProvider).initialize connProvider

    If Not (activeConnProvider Is Nothing Or activeConnProvider Is connProvider) Then ASSERT_FAILURE "activeConnProvider == nullptr || activeConnProvider == connProvider", "lib/netplay/netplay.cpp:1380", "NETinit", _
        "Active connection provider is already set. Call NETshutdown() first!"
    Set activeConnProvider = connProvider

    debug_ 1384, LOG_NET, "NETinit", "NETPLAY: Init called, MORNIN'"

    ' wzAsyncExecOnMainThread([pt]() { ... addConsoleMessage(...) }): the game shows it (on this frame, not the next)
    netGame.addConsoleMessage va("Using %s network backend.", ConnectionProviderType_to_string(pt))

    ' NOTE NetPlay.isPortMappingEnabled is already set in configuration.c!
    NetPlay.bComms = True
    NetPlay.GamePassworded = False
    NetPlay.isHostAlive = False
    NetPlay.gamePassword = ""
    NETstartLogging

    NetPlay.GamePassworded = False
    sync_counter.kicks = 0: sync_counter.joins = 0: sync_counter.left_ = 0: sync_counter.drops = 0  ' memset(&sync_counter, 0x0, sizeof(sync_counter))
    sync_counter.cantjoin = 0: sync_counter.banned = 0: sync_counter.rejected = 0

    NETinit = 0
End Function

' to_string(ConnectionProviderType)
Public Function ConnectionProviderType_to_string(ByVal pt As Long) As String
    Select Case pt
    Case ConnectionProviderType_TCP_DIRECT: ConnectionProviderType_to_string = "TCP"
    Case Else: ConnectionProviderType_to_string = "GNS"
    End Select
End Function

' ////////////////////////////////////////////////////////////////////////
' shutdown state related to the active connection
Public Function NETshutdown() As Long
    debug_ 1409, LOG_NET, "NETshutdown", "NETshutdown"
    NETlogEntry "NETshutdown", SYNC_FLAG, selectedPlayer
    If NetPlay.bComms And NetPlay.isPortMappingEnabled Then
        NETremRedirects
        PortMappingManager_shutdown
    End If
    NETstopLogging
    NETpermissionsShutdown
    NETdeleteQueue

    Set activeConnProvider = Nothing

    ' Reset net usage statistics.
    Dim zero As NETSTATS
    nStats = zero
    nStatsLastSec = zero
    nStatsSecondLastSec = zero

    NETshutdown = 0
End Function

' ////////////////////////////////////////////////////////////////////////
' shutdown netplay (to be called at app shutdown only)
Public Function netplayShutDown() As Boolean
    NETshutdown

    PendingWritesManagerMap_Shutdown
    ConnectionProviderRegistry_Shutdown
    netplayShutDown = True
End Function

' ////////////////////////////////////////////////////////////////////////
' return bytes of data sent recently.
' typ: NetStatisticType (0 NetStatisticRawBytes, 1 NetStatisticUncompressedBytes, 2 NetStatisticPackets)
Public Function NETgetStatistic(ByVal typ As Long, ByVal sent As Boolean, Optional ByVal isTotal As Boolean = False) As Double
    Dim time_ As Long
    If typ < 0 Or typ > 2 Then ASSERT_FAILURE "false", "lib/netplay/netplay.cpp:1536", "NETgetStatistic", " ": NETgetStatistic = 0: Exit Function

    time_ = wzGetTicks()
    If Not ULT(time_ - nStatsLastUpdateTime, GAME_TICKS_PER_SEC) Then
        nStatsLastUpdateTime = time_
        nStatsSecondLastSec = nStatsLastSec
        nStatsLastSec = nStats
    End If

    If isTotal Then
        NETgetStatistic = statisticOf(nStats, typ, sent)
        Exit Function
    End If
    NETgetStatistic = statisticOf(nStatsLastSec, typ, sent) - statisticOf(nStatsSecondLastSec, typ, sent)
End Function

' (VB) stats.*statsType.*statisticType
Private Function statisticOf(s As NETSTATS, ByVal typ As Long, ByVal sent As Boolean) As Double
    Dim st As Statistic
    Select Case typ
    Case 0: st = s.rawBytes
    Case 1: st = s.uncompressedBytes
    Case Else: st = s.packets
    End Select
    If sent Then statisticOf = st.sent Else statisticOf = st.received
End Function

Public Sub NETsetPlayerConnectionStatus(ByVal status As Long, ByVal player As Long)
    Dim n As Long, timeout As Long
    ' const int timeouts[] = {GAME_TICKS_PER_SEC * 10, GAME_TICKS_PER_SEC * 10, GAME_TICKS_PER_SEC, GAME_TICKS_PER_SEC / 6};
    ' (ARRAY_SIZE(timeouts) == CONNECTIONSTATUS_NORMAL: 4 == 4, the assert cannot fail)

    If player = NET_ALL_PLAYERS Then
        For n = 0 To MAX_CONNECTED_PLAYERS - 1
            NETsetPlayerConnectionStatus status, n
        Next
        Exit Sub
    End If
    If status = CONNECTIONSTATUS_NORMAL Then
        For n = 0 To CONNECTIONSTATUS_NORMAL - 1
            NET_PlayerConnectionStatus(n, player) = 0
        Next
        Exit Sub
    End If

    Select Case status
    Case 0, 1: timeout = 10000
    Case 2: timeout = 1000
    Case Else: timeout = 166
    End Select
    NET_PlayerConnectionStatus(status, player) = FromU32(U32(netGame.realTime()) + timeout)
End Sub

' True iff connection status icon hasn't expired for this player. CONNECTIONSTATUS_NORMAL means any status, NET_ALL_PLAYERS means all players.
Public Function NETcheckPlayerConnectionStatus(ByVal status As Long, ByVal player As Long) As Boolean
    Dim n As Long

    If player = NET_ALL_PLAYERS Then
        For n = 0 To MAX_CONNECTED_PLAYERS - 1
            If NETcheckPlayerConnectionStatus(status, n) Then
                NETcheckPlayerConnectionStatus = True
                Exit Function
            End If
        Next
        NETcheckPlayerConnectionStatus = False
        Exit Function
    End If
    If status = CONNECTIONSTATUS_NORMAL Then
        For n = 0 To CONNECTIONSTATUS_NORMAL - 1
            If NETcheckPlayerConnectionStatus(n, player) Then
                NETcheckPlayerConnectionStatus = True
                Exit Function
            End If
        Next
        NETcheckPlayerConnectionStatus = False
        Exit Function
    End If

    NETcheckPlayerConnectionStatus = ULT(netGame.realTime(), NET_PlayerConnectionStatus(status, player))
End Function

Public Function messageTypeToString(ByVal messageType_ As Long) As String
    Dim s As String
    ' MESSAGE_TYPES messageType = (MESSAGE_TYPES)messageType_;  // Cast to enum, so switch gives a warning if new message types are added without updating the switch.

    Select Case messageType_
    ' Net-related messages.
    Case NET_MIN_TYPE:                  s = "NET_MIN_TYPE"
    Case NET_PING:                      s = "NET_PING"
    Case NET_PLAYER_STATS:              s = "NET_PLAYER_STATS"
    Case NET_TEXTMSG:                   s = "NET_TEXTMSG"
    Case NET_PLAYERRESPONDING:          s = "NET_PLAYERRESPONDING"
    Case NET_OPTIONS:                   s = "NET_OPTIONS"
    Case NET_KICK:                      s = "NET_KICK"
    Case NET_FIREUP:                    s = "NET_FIREUP"
    Case NET_COLOURREQUEST:             s = "NET_COLOURREQUEST"
    Case NET_FACTIONREQUEST:            s = "NET_FACTIONREQUEST"
    Case NET_AITEXTMSG:                 s = "NET_AITEXTMSG"
    Case NET_BEACONMSG:                 s = "NET_BEACONMSG"
    Case NET_TEAMREQUEST:               s = "NET_TEAMREQUEST"
    Case NET_JOIN:                      s = "NET_JOIN"
    Case NET_ACCEPTED:                  s = "NET_ACCEPTED"
    Case NET_PLAYER_INFO:               s = "NET_PLAYER_INFO"
    Case NET_PLAYER_JOINED:             s = "NET_PLAYER_JOINED"
    Case NET_PLAYER_LEAVING:            s = "NET_PLAYER_LEAVING"
    Case NET_PLAYER_DROPPED:            s = "NET_PLAYER_DROPPED"
    Case NET_GAME_FLAGS:                s = "NET_GAME_FLAGS"
    Case NET_READY_REQUEST:             s = "NET_READY_REQUEST"
    Case NET_REJECTED:                  s = "NET_REJECTED"
    Case NET_POSITIONREQUEST:           s = "NET_POSITIONREQUEST"
    Case NET_DATA_CHECK:                s = "NET_DATA_CHECK"
    Case NET_HOST_DROPPED:              s = "NET_HOST_DROPPED"
    Case NET_SEND_TO_PLAYER:            s = "NET_SEND_TO_PLAYER"
    Case NET_SHARE_GAME_QUEUE:          s = "NET_SHARE_GAME_QUEUE"
    Case NET_FILE_REQUESTED:            s = "NET_FILE_REQUESTED"
    Case NET_FILE_CANCELLED:            s = "NET_FILE_CANCELLED"
    Case NET_FILE_PAYLOAD:              s = "NET_FILE_PAYLOAD"
    Case NET_DEBUG_SYNC:                s = "NET_DEBUG_SYNC"
    Case NET_VOTE:                      s = "NET_VOTE"
    Case NET_VOTE_REQUEST:              s = "NET_VOTE_REQUEST"
    Case NET_SPECTEXTMSG:               s = "NET_SPECTEXTMSG"
    Case NET_PLAYERNAME_CHANGEREQUEST:  s = "NET_PLAYERNAME_CHANGEREQUEST"
    Case NET_PLAYER_SLOTTYPE_REQUEST:   s = "NET_PLAYER_SLOTTYPE_REQUEST"
    Case NET_PLAYER_SWAP_INDEX:         s = "NET_PLAYER_SWAP_INDEX"
    Case NET_PLAYER_SWAP_INDEX_ACK:     s = "NET_PLAYER_SWAP_INDEX_ACK"
    Case NET_DATA_CHECK2:               s = "NET_DATA_CHECK2"
    Case NET_SECURED_NET_MESSAGE:       s = "NET_SECURED_NET_MESSAGE"
    Case NET_TEAM_STRATEGY:             s = "NET_TEAM_STRATEGY"
    Case NET_QUICK_CHAT_MSG:            s = "NET_QUICK_CHAT_MSG"
    Case NET_HOST_CONFIG:               s = "NET_HOST_CONFIG"
    Case NET_MAX_TYPE:                  s = "NET_MAX_TYPE"

    ' Game-state-related messages, must be processed by all clients at the same game time.
    Case GAME_MIN_TYPE:                 s = "GAME_MIN_TYPE"
    Case GAME_DROIDINFO:                s = "GAME_DROIDINFO"
    Case GAME_STRUCTUREINFO:            s = "GAME_STRUCTUREINFO"
    Case GAME_RESEARCHSTATUS:           s = "GAME_RESEARCHSTATUS"
    Case GAME_TEMPLATE:                 s = "GAME_TEMPLATE"
    Case GAME_TEMPLATEDEST:             s = "GAME_TEMPLATEDEST"
    Case GAME_ALLIANCE:                 s = "GAME_ALLIANCE"
    Case GAME_GIFT:                     s = "GAME_GIFT"
    Case GAME_LASSAT:                   s = "GAME_LASSAT"
    Case GAME_GAME_TIME:                s = "GAME_GAME_TIME"
    Case GAME_PLAYER_LEFT:              s = "GAME_PLAYER_LEFT"
    Case GAME_DROIDDISEMBARK:           s = "GAME_DROIDDISEMBARK"
    Case GAME_SYNC_REQUEST:             s = "GAME_SYNC_REQUEST"

    ' The following messages are used for debug mode.
    Case GAME_DEBUG_MODE:               s = "GAME_DEBUG_MODE"
    Case GAME_DEBUG_ADD_DROID:          s = "GAME_DEBUG_ADD_DROID"
    Case GAME_DEBUG_ADD_STRUCTURE:      s = "GAME_DEBUG_ADD_STRUCTURE"
    Case GAME_DEBUG_ADD_FEATURE:        s = "GAME_DEBUG_ADD_FEATURE"
    Case GAME_DEBUG_REMOVE_DROID:       s = "GAME_DEBUG_REMOVE_DROID"
    Case GAME_DEBUG_REMOVE_STRUCTURE:   s = "GAME_DEBUG_REMOVE_STRUCTURE"
    Case GAME_DEBUG_REMOVE_FEATURE:     s = "GAME_DEBUG_REMOVE_FEATURE"
    Case GAME_DEBUG_FINISH_RESEARCH:    s = "GAME_DEBUG_FINISH_RESEARCH"
    ' End of redundant messages.
    Case GAME_SYNC_OPT_CHANGE:          s = "GAME_SYNC_OPT_CHANGE"
    Case GAME_MAX_TYPE:                 s = "GAME_MAX_TYPE"

    ' The following messages are used for playing back replays.
    Case REPLAY_ENDED:                  s = "REPLAY_ENDED"
    ' End of replay messages.
    Case Else:                          s = "(UNUSED)"
    End Select
    messageTypeToString = s
End Function

