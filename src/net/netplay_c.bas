' ////////////////////////////////////////////////////////////////////////
' rename the local player
Public Function NETchangePlayerName(ByVal index As Long, ByVal newName As String) As Boolean
    Dim player As Long, newNameStr As String, w As MessageWriter
    If Not NetPlay.bComms Then
        netGame.setPlayerName 0, newName
        NETchangePlayerName = True
        Exit Function
    End If
    debug_ 1173, LOG_NET, "NETchangePlayerName", "Requesting a change of player name for pid=%u to %s", index, newName
    NETlogEntry "Player wants a name change.", SYNC_FLAG, index
    If Not ULT(index, MAX_CONNECTED_PLAYERS) Then ASSERT_FAILURE "index < MAX_CONNECTED_PLAYERS", "lib/netplay/netplay.cpp:1175", "NETchangePlayerName", "invalid index: %u", index: NETchangePlayerName = False: Exit Function

    netGame.setPlayerName index, newName
    If NetPlay.isHost Then
        NETSendAllPlayerInfoTo NET_ALL_PLAYERS
    Else
        If Not (index <= 255) Then ASSERT_FAILURE "index <= static_cast<uint32_t>(std::numeric_limits<uint8_t>::max())", "lib/netplay/netplay.cpp:1184", "NETchangePlayerName", "index (%u) exceeds supported bounds", index: NETchangePlayerName = False: Exit Function
        If Not (index = selectedPlayer) Then ASSERT_FAILURE "index == selectedPlayer", "lib/netplay/netplay.cpp:1185", "NETchangePlayerName", "Clients can only change their own name!": NETchangePlayerName = False: Exit Function
        player = index
        newNameStr = NetPlay.players(index).name
        Set w = NETbeginEncode(NETnetQueue(NetPlay.hostPlayer), NET_PLAYERNAME_CHANGEREQUEST)
        NETuint8_t_w w, player
        NETwzstring_w w, newNameStr
        NETend_w w
    End If

    NETchangePlayerName = True
End Function

Public Sub NETfixDuplicatePlayerNames()
    Dim name_ As String, i As Long, j As Long, pass As Long
    For i = 1 To MAX_CONNECTED_PLAYERS - 1
        name_ = NetPlay.players(i).name          ' sstrcpy(name, NetPlay.players[i].name)
        If name_ = "" Or Not NetPlay.players(i).allocated Then
            GoTo continue_  ' Ignore empty names.
        End If
        For pass = 0 To 100
            If pass <> 0 Then
                name_ = sstrcpyN(va("%s_%X", NetPlay.players(i).name, pass + 1), StringSize)
            End If

            For j = 0 To i - 1
                If name_ = NetPlay.players(j).name Then
                    Exit For  ' Duplicate name.
                End If
            Next

            If i = j Then
                Exit For  ' Unique name.
            End If
        Next
        If pass <> 0 Then
            NETchangePlayerName i, name_
        End If
continue_:
    Next
End Sub

' ////////////////////////////////////////////////////////////////////////
' return one of the four user flags in the current sessiondescription.
Public Function NETgetGameFlags(ByVal flag As Long) As Long
    If flag < 1 Or flag > 4 Then
        NETgetGameFlags = 0
    Else
