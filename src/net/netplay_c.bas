'   Sets if the game is password protected or not
Public Sub NETGameLocked(ByVal flag As Boolean)
    Dim flagChanged As Boolean, s As String
    NetPlay.GamePassworded = flag
    flagChanged = gameDetails.isPrivate <> flag
    gameDetails.isPrivate = flag
    If allow_joining And NetPlay.isHost And flagChanged Then
        debug_ 440, LOG_NET, "NETGameLocked", "Updating game locked status."
        NETupdateLobbyGameListing
    End If
    If flagChanged Then
        ' (ActivityManager::instance().updateMultiplayGameData(game, ingame, NETGameIsLocked()): the activity sinks, not ported)
    End If
    NETlogEntry "Password is", SYNC_FLAG, -CLng(NetPlay.GamePassworded)
    If NetPlay.GamePassworded Then s = "TRUE" Else s = "FALSE"
    debug_ 448, LOG_NET, "NETGameLocked", "Passworded game is %s", s
End Sub

' SpectatorInfo SpectatorInfo::currentNetPlayState(), packed as its toUint32(): spectatorsJoined in the high 16
' bits, totalSpectatorSlots in the low 16
Public Function SpectatorInfo_currentNetPlayState() As Long
    Dim i As Long, joined As Long, total As Long
    ensureNetPlay
    For i = 0 To NetPlay.playersSize - 1
        If NetPlay.players(i).isSpectator Then
            total = total + 1
            If NetPlay.players(i).allocated Then
                joined = joined + 1
            End If
        End If
    Next
    SpectatorInfo_currentNetPlayState = SHL(joined And &HFFFF&, 16) Or (total And &HFFFF&)
End Function

' SpectatorInfo's fields from its toUint32()
Public Function SpectatorInfo_spectatorsJoined(ByVal info As Long) As Long
    SpectatorInfo_spectatorsJoined = SHRU(info, 16)
End Function

Public Function SpectatorInfo_totalSpectatorSlots(ByVal info As Long) As Long
    SpectatorInfo_totalSpectatorSlots = info And &HFFFF&
End Function

' SpectatorInfo::availableSpectatorSlots()
Public Function SpectatorInfo_availableSpectatorSlots(ByVal info As Long) As Long
    If SpectatorInfo_spectatorsJoined(info) > SpectatorInfo_totalSpectatorSlots(info) Then
        SpectatorInfo_availableSpectatorSlots = 0
        Exit Function
    End If
    SpectatorInfo_availableSpectatorSlots = SpectatorInfo_totalSpectatorSlots(info) - SpectatorInfo_spectatorsJoined(info)
End Function

Public Function NETGameGetSpectatorInfo() As Long
    NETGameGetSpectatorInfo = SpectatorInfo_currentNetPlayState()
