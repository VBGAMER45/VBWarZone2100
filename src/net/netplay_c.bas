' (VB) a char[n] field: sstrcpy's truncation to n - 1 characters
Public Function sstrcpyN(ByVal s As String, ByVal n As Long) As String
    Dim z As Long
    z = InStr(s, vbNullChar)
    If z > 0 Then s = Left$(s, z - 1)
    If Len(s) > n - 1 Then s = Left$(s, n - 1)
    sstrcpyN = s
End Function

