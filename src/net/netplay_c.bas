' NetPlay.scriptSetPlayerDataStrings[idx] = obj.get<std::unordered_map<std::string, std::string>>(): the json object's
' members, as key -> value (the Collection's items are Array(key, value), unkeyed: a Collection's keys ignore case)
Public Sub NetPlay_scriptSetPlayerDataStrings_assign(ByVal idx As Long, ByVal obj As nlohmann_json)
    Dim c As New Collection, i As Long
    ensureNetPlay
    For i = 0 To obj.size() - 1
        c.Add Array(obj.key_at(i), obj.value_at(i).get_string())
    Next
    Set NetPlay.scriptSetPlayerDataStrings(idx) = c
End Sub

