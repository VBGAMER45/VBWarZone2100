Private Function get_exts() As Boolean
    Dim index As Long
    If max_loaded_major < 3 Then
        exts = gl_cstr(glGetString(GL_EXTENSIONS))
    Else
        num_exts_i = 0
        glGetIntegerv GL_NUM_EXTENSIONS, VarPtr(num_exts_i)
        If num_exts_i > 0 Then
            ReDim exts_i(0 To num_exts_i - 1)
        Else
            Exit Function
        End If
        For index = 0 To num_exts_i - 1
            exts_i(index) = gl_cstr(glGetStringi(GL_EXTENSIONS, index))
        Next
    End If
    get_exts = True
End Function

Private Sub free_exts()
    Erase exts_i
    num_exts_i = 0
End Sub

Private Function has_ext(ByVal ext As String) As Boolean
    Dim index As Long
    If max_loaded_major < 3 Then
        has_ext = InStr(1, " " & exts & " ", " " & ext & " ", vbBinaryCompare) > 0
    Else
        For index = 0 To num_exts_i - 1
            If exts_i(index) = ext Then
                has_ext = True
                Exit Function
            End If
        Next
    End If
End Function

