Private Function load_proc(ByVal name_ As String) As Long
    load_proc = glBackend.getGLGetProcAddress(name_)
End Function

Private Sub load_block(ByVal block As String)
    Select Case block
    Case "GL_VERSION_1_0"
        If Not GLAD_GL_VERSION_1_0 Then Exit Sub
        glad_glCullFace = load_proc("glCullFace")
        glad_glTexParameterf = load_proc("glTexParameterf")
        glad_glTexParameterfv = load_proc("glTexParameterfv")
        glad_glTexParameteri = load_proc("glTexParameteri")
        glad_glTexImage2D = load_proc("glTexImage2D")
        glad_glClear = load_proc("glClear")
        glad_glStencilMask = load_proc("glStencilMask")
        glad_glColorMask = load_proc("glColorMask")
        glad_glDepthMask = load_proc("glDepthMask")
        glad_glDisable = load_proc("glDisable")
        glad_glEnable = load_proc("glEnable")
        glad_glBlendFunc = load_proc("glBlendFunc")
        glad_glStencilFunc = load_proc("glStencilFunc")
        glad_glStencilOp = load_proc("glStencilOp")
        glad_glDepthFunc = load_proc("glDepthFunc")
        glad_glPixelStorei = load_proc("glPixelStorei")
        glad_glReadBuffer = load_proc("glReadBuffer")
        glad_glReadPixels = load_proc("glReadPixels")
        glad_glGetBooleanv = load_proc("glGetBooleanv")
        glad_glGetError = load_proc("glGetError")
        glad_glGetFloatv = load_proc("glGetFloatv")
        glad_glGetIntegerv = load_proc("glGetIntegerv")
        glad_glGetString = load_proc("glGetString")
        glad_glDepthRange = load_proc("glDepthRange")
