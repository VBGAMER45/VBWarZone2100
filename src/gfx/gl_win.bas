Private Sub find_coreGL()
    Dim i As Long, major As Long, minor As Long, version As String, prefixes As Variant, p As Long
    prefixes = Array("OpenGL ES-CM ", "OpenGL ES-CL ", "OpenGL ES ")
    version = gl_cstr(glGetString(GL_VERSION))
    If Len(version) = 0 Then Exit Sub
    For i = 0 To 2
        If Left$(version, Len(prefixes(i))) = prefixes(i) Then
            version = Mid$(version, Len(prefixes(i)) + 1)
            Exit For
        End If
    Next
    ' sscanf(version, "%d.%d", &major, &minor)
    p = 1
    Do While p <= Len(version) And Mid$(version, p, 1) Like "#"
        major = major * 10 + Asc(Mid$(version, p, 1)) - 48
        p = p + 1
    Loop
    If Mid$(version, p, 1) = "." Then
        p = p + 1
        Do While p <= Len(version) And Mid$(version, p, 1) Like "#"
            minor = minor * 10 + Asc(Mid$(version, p, 1)) - 48
            p = p + 1
        Loop
    End If
    GLVersion_major = major: GLVersion_minor = minor
    max_loaded_major = major: max_loaded_minor = minor
    GLAD_GL_VERSION_1_0 = (major = 1 And minor >= 0) Or major > 1
    GLAD_GL_VERSION_1_1 = (major = 1 And minor >= 1) Or major > 1
    GLAD_GL_VERSION_1_2 = (major = 1 And minor >= 2) Or major > 1
    GLAD_GL_VERSION_1_3 = (major = 1 And minor >= 3) Or major > 1
    GLAD_GL_VERSION_1_4 = (major = 1 And minor >= 4) Or major > 1
    GLAD_GL_VERSION_1_5 = (major = 1 And minor >= 5) Or major > 1
    GLAD_GL_VERSION_2_0 = (major = 2 And minor >= 0) Or major > 2
    GLAD_GL_VERSION_2_1 = (major = 2 And minor >= 1) Or major > 2
    GLAD_GL_VERSION_3_0 = (major = 3 And minor >= 0) Or major > 3
    GLAD_GL_VERSION_3_1 = (major = 3 And minor >= 1) Or major > 3
    GLAD_GL_VERSION_3_2 = (major = 3 And minor >= 2) Or major > 3
    GLAD_GL_VERSION_3_3 = (major = 3 And minor >= 3) Or major > 3
    If GLVersion_major > 3 Or (GLVersion_major >= 3 And GLVersion_minor >= 3) Then
        max_loaded_major = 3
        max_loaded_minor = 3
    End If
End Sub

Private Sub find_coreGLES2()
    Dim i As Long, major As Long, minor As Long, version As String, prefixes As Variant, p As Long
    prefixes = Array("OpenGL ES-CM ", "OpenGL ES-CL ", "OpenGL ES ")
    version = gl_cstr(glGetString(GL_VERSION))
    If Len(version) = 0 Then Exit Sub
    For i = 0 To 2
        If Left$(version, Len(prefixes(i))) = prefixes(i) Then
            version = Mid$(version, Len(prefixes(i)) + 1)
            Exit For
        End If
    Next
    ' sscanf(version, "%d.%d", &major, &minor)
    p = 1
    Do While p <= Len(version) And Mid$(version, p, 1) Like "#"
        major = major * 10 + Asc(Mid$(version, p, 1)) - 48
        p = p + 1
    Loop
    If Mid$(version, p, 1) = "." Then
        p = p + 1
        Do While p <= Len(version) And Mid$(version, p, 1) Like "#"
            minor = minor * 10 + Asc(Mid$(version, p, 1)) - 48
            p = p + 1
        Loop
    End If
    GLVersion_major = major: GLVersion_minor = minor
    max_loaded_major = major: max_loaded_minor = minor
    GLAD_GL_ES_VERSION_2_0 = (major = 2 And minor >= 0) Or major > 2
    GLAD_GL_ES_VERSION_3_0 = (major = 3 And minor >= 0) Or major > 3
    GLAD_GL_ES_VERSION_3_1 = (major = 3 And minor >= 1) Or major > 3
    GLAD_GL_ES_VERSION_3_2 = (major = 3 And minor >= 2) Or major > 3
    If GLVersion_major > 3 Or (GLVersion_major >= 3 And GLVersion_minor >= 2) Then
        max_loaded_major = 3
        max_loaded_minor = 2
    End If
End Sub

' int gladLoadGLLoader(GLADloadproc load): the backend's getGLGetProcAddress is the loader
Public Function gladLoadGLLoader(ByVal backend As IGLBackend) As Boolean
    Set glBackend = backend
    prepare
    GLVersion_major = 0: GLVersion_minor = 0
    glad_glGetString = load_proc("glGetString")
    If glad_glGetString = 0 Then Exit Function
    If glGetString(GL_VERSION) = 0 Then Exit Function
    find_coreGL
    load_block "GL_VERSION_1_0"
    load_block "GL_VERSION_1_1"
    load_block "GL_VERSION_1_2"
    load_block "GL_VERSION_1_3"
    load_block "GL_VERSION_1_4"
    load_block "GL_VERSION_1_5"
    load_block "GL_VERSION_2_0"
    load_block "GL_VERSION_2_1"
    load_block "GL_VERSION_3_0"
    load_block "GL_VERSION_3_1"
    load_block "GL_VERSION_3_2"
    load_block "GL_VERSION_3_3"
    If Not find_extensionsGL() Then Exit Function
    load_block "GL_ARB_draw_instanced"
    load_block "GL_ARB_instanced_arrays"
    load_block "GL_ARB_internalformat_query"
    load_block "GL_ARB_internalformat_query2"
    load_block "GL_ARB_invalidate_subdata"
    load_block "GL_ARB_texture_compression"
    load_block "GL_ARB_timer_query"
    load_block "GL_ARB_vertex_buffer_object"
    load_block "GL_ATI_separate_stencil"
    load_block "GL_EXT_framebuffer_object"
    load_block "GL_EXT_stencil_two_side"
    load_block "GL_EXT_texture_array"
    load_block "GL_GREMEDY_string_marker"
    load_block "GL_KHR_debug"
    gladLoadGLLoader = GLVersion_major <> 0 Or GLVersion_minor <> 0
End Function

