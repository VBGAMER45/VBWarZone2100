Public Function gl_context_getShadowConstants() As lighting_constants
    gl_context_getShadowConstants = shadowConstants
End Function

Public Function gl_context_setShadowConstants(newValues As lighting_constants) As Boolean
    Dim patchFragmentShaderMipLodBias As Boolean, i As Long
    If lighting_constants_equal(shadowConstants, newValues) Then
        gl_context_setShadowConstants = True
        Exit Function
    End If

    shadowConstants = newValues

    ' Must recompile any shaders that used this value
    patchFragmentShaderMipLodBias = True ' provide the constant to the shader directly
    For i = 0 To createdPipelines_size - 1
        If Not createdPipelines_pso(i) Is Nothing Then
            If createdPipelines_pso(i).hasSpecializationConstant_ShadowConstants Or createdPipelines_pso(i).hasSpecializationConstants_PointLights Then
                If current_program Is createdPipelines_pso(i) Then Set current_program = Nothing
                Set createdPipelines_pso(i) = Nothing
                Set createdPipelines_pso(i) = gl_pipeline_state_object_new(patchFragmentShaderMipLodBias, createdPipelines_createInfo(i))
            End If
        End If
    Next

    gl_context_setShadowConstants = True
End Function

Public Function gl_context_debugRecompileAllPipelines() As Boolean
    Dim patchFragmentShaderMipLodBias As Boolean, i As Long
    patchFragmentShaderMipLodBias = True ' provide the constant to the shader directly
    For i = 0 To createdPipelines_size - 1
        If Not createdPipelines_pso(i) Is Nothing Then
            If current_program Is createdPipelines_pso(i) Then Set current_program = Nothing
            Set createdPipelines_pso(i) = Nothing
            Set createdPipelines_pso(i) = gl_pipeline_state_object_new(patchFragmentShaderMipLodBias, createdPipelines_createInfo(i))
        End If
    Next
    gl_context_debugRecompileAllPipelines = True
End Function

Private Function cbframebuffererror(ByVal err_ As Long) As String
    Select Case err_
    Case GL_FRAMEBUFFER_COMPLETE: cbframebuffererror = "GL_FRAMEBUFFER_COMPLETE"
    Case GL_FRAMEBUFFER_UNDEFINED: cbframebuffererror = "GL_FRAMEBUFFER_UNDEFINED"
    Case GL_FRAMEBUFFER_INCOMPLETE_ATTACHMENT: cbframebuffererror = "GL_FRAMEBUFFER_INCOMPLETE_ATTACHMENT"
    Case GL_FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT: cbframebuffererror = "GL_FRAMEBUFFER_INCOMPLETE_MISSING_ATTACHMENT"
    Case GL_FRAMEBUFFER_INCOMPLETE_DRAW_BUFFER: cbframebuffererror = "GL_FRAMEBUFFER_INCOMPLETE_DRAW_BUFFER"
    Case GL_FRAMEBUFFER_INCOMPLETE_READ_BUFFER: cbframebuffererror = "GL_FRAMEBUFFER_INCOMPLETE_READ_BUFFER"
    Case GL_FRAMEBUFFER_UNSUPPORTED: cbframebuffererror = "GL_FRAMEBUFFER_UNSUPPORTED"
    Case GL_FRAMEBUFFER_INCOMPLETE_MULTISAMPLE: cbframebuffererror = "GL_FRAMEBUFFER_INCOMPLETE_MULTISAMPLE"
    Case GL_FRAMEBUFFER_INCOMPLETE_LAYER_TARGETS: cbframebuffererror = "GL_FRAMEBUFFER_INCOMPLETE_LAYER_TARGETS"
    Case Else: cbframebuffererror = "Other"
    End Select
End Function

Private Function initDepthPasses(ByVal resolution As Long) As Long
    Dim pNewDepthTexture As gl_gpurendered_texture, target As Long, i As Long, newFBO As Long, buf As Long, status As Long
    If depthPassCount > WZ_MAX_SHADOW_CASCADES Then depthPassCount = WZ_MAX_SHADOW_CASCADES

    If depthPassCount > 1 Then
        If (Not gles And Not GLAD_GL_VERSION_3_0) Or (gles And Not GLAD_GL_ES_VERSION_3_0) Then
            ' glFramebufferTextureLayer requires OpenGL 3.0+ / ES 3.0+
            debug_ 5083, LOG_ERROR, "initDepthPasses", "Cannot create depth texture array - requires OpenGL 3.0+ / OpenGL ES 3.0+ - this will fail"
        End If
    End If

    ' delete prior depth texture & FBOs (if present)
    If glad_glDeleteFramebuffers <> 0 Then
        If depthFBO_size > 0 Then
            glDeleteFramebuffers depthFBO_size, VarPtr(depthFBO(0))
            Erase depthFBO
            depthFBO_size = 0
        End If
    End If
    If Not depthTexture Is Nothing Then
        Set depthTexture = Nothing
    End If

    If depthPassCount = 0 Then
        initDepthPasses = 0
        Exit Function
    End If

    Set pNewDepthTexture = create_depthmap_texture(depthPassCount, resolution, resolution, "<depth map>")
    If pNewDepthTexture Is Nothing Then
        debug_ 5113, LOG_ERROR, "initDepthPasses", "Failed to create depth texture"
        initDepthPasses = 0
        Exit Function
    End If
    Set depthTexture = pNewDepthTexture

    target = depthTexture.target()
    depthTexture.bind
    glTexParameteri target, GL_TEXTURE_COMPARE_FUNC, GL_LEQUAL
    glTexParameteri target, GL_TEXTURE_COMPARE_MODE, GL_COMPARE_REF_TO_TEXTURE
    depthTexture.unbind

    For i = 0 To depthPassCount - 1
        newFBO = 0
        glGenFramebuffers 1, VarPtr(newFBO)
        ReDim Preserve depthFBO(0 To depthFBO_size)
        depthFBO(depthFBO_size) = newFBO
        depthFBO_size = depthFBO_size + 1

        glBindFramebuffer GL_FRAMEBUFFER, newFBO
        If depthTexture.isArray() Then
            If Not (glad_glFramebufferTextureLayer <> 0) Then ASSERT_FAILURE "glad_glFramebufferTextureLayer != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:5134", "initDepthPasses", "glFramebufferTextureLayer is not available?"
            glFramebufferTextureLayer GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, depthTexture.id(), 0, i ' OpenGL 3.0+ / ES 3.0+ only
        Else
            glFramebufferTexture2D GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_TEXTURE_2D, depthTexture.id(), 0
        End If
        buf = GL_NONE
        glDrawBuffers 1, VarPtr(buf)
        glReadBuffer GL_NONE

        status = glCheckFramebufferStatus(GL_FRAMEBUFFER)
        If status <> GL_FRAMEBUFFER_COMPLETE Then
            debug_ 5149, LOG_ERROR, "initDepthPasses", "Failed to create framebuffer with error: %s", cbframebuffererror(status)
        End If

        glBindFramebuffer GL_FRAMEBUFFER, 0
    Next

    initDepthPasses = depthPassCount
End Function

Private Sub deleteSceneRenderpass()
    ' delete prior scene texture & FBOs (if present)
    If glad_glDeleteFramebuffers <> 0 Then
        If sceneFBO_size > 0 Then
            glDeleteFramebuffers sceneFBO_size, VarPtr(sceneFBO(0))
            Erase sceneFBO
            sceneFBO_size = 0
        End If
        If sceneResolveFBO_size > 0 Then
            glDeleteFramebuffers sceneResolveFBO_size, VarPtr(sceneResolveFBO(0))
            Erase sceneResolveFBO
            sceneResolveFBO_size = 0
        End If
    End If
    If sceneMsaaRBO <> 0 Then
        glDeleteRenderbuffers 1, VarPtr(sceneMsaaRBO)
        sceneMsaaRBO = 0
    End If
    If Not sceneTexture Is Nothing Then
        Set sceneTexture = Nothing
    End If
    If sceneDepthStencilRBO <> 0 Then
        glDeleteRenderbuffers 1, VarPtr(sceneDepthStencilRBO)
        sceneDepthStencilRBO = 0
    End If
End Sub

Private Function createSceneRenderpass() As Boolean
    Dim encounteredError As Boolean, samples As Long, colorInternalFormat As Long, colorBaseFormat As Long
    Dim pNewSceneTexture As gl_gpurendered_texture, i As Long, newFBO As Long, status As Long, newResolveRBO As Long
    Const numSceneFBOs As Long = 2
    deleteSceneRenderpass

    If Not ((Not gles And GLAD_GL_VERSION_3_0) Or (gles And GLAD_GL_ES_VERSION_3_0)) Then
        ' The following requires OpenGL 3.0+ or OpenGL ES 3.0+
        debug_ 5201, LOG_ERROR, "createSceneRenderpass", "Unsupported version of OpenGL / OpenGL ES."
        createSceneRenderpass = False
        Exit Function
    End If

    wzGLClearErrors_ ' clear OpenGL error states

    encounteredError = False
    If multisamples < maxMultiSampleBufferFormatSamples Then samples = multisamples Else samples = maxMultiSampleBufferFormatSamples

    If samples > 0 Then
        ' If MSAA is enabled, use glRenderbufferStorageMultisample to create an intermediate buffer with MSAA enabled
        glGenRenderbuffers 1, VarPtr(sceneMsaaRBO)
        If Not wzGLCheckErrors_(5215, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        glBindRenderbuffer GL_RENDERBUFFER, sceneMsaaRBO
        If Not wzGLCheckErrors_(5217, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        glRenderbufferStorageMultisample GL_RENDERBUFFER, samples, multiSampledBufferInternalFormat, sceneFramebufferWidth, sceneFramebufferHeight ' OpenGL 3.0+, OpenGL ES 3.0+
        If Not wzGLCheckErrors_(5219, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        glBindRenderbuffer GL_RENDERBUFFER, 0
        If Not wzGLCheckErrors_(5221, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    End If

    ' Always create a standard color texture (for the resolved color values)
    ' NOTE:
    ' - OpenGL ES: color texture format must *MATCH* the format used for the multisampled color render buffer
    If samples > 0 And gles Then colorInternalFormat = multiSampledBufferInternalFormat Else colorInternalFormat = GL_RGB8
    If samples > 0 And gles Then colorBaseFormat = multiSampledBufferBaseFormat Else colorBaseFormat = GL_RGB
    Set pNewSceneTexture = create_framebuffer_color_texture(colorInternalFormat, colorBaseFormat, GL_UNSIGNED_BYTE, sceneFramebufferWidth, sceneFramebufferHeight, "<scene texture>")
    If Not wzGLCheckErrors_(5230, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    If pNewSceneTexture Is Nothing Then
        debug_ 5233, LOG_ERROR, "createSceneRenderpass", "Failed to create scene color texture (%u x %u)", sceneFramebufferWidth, sceneFramebufferHeight
        createSceneRenderpass = False
        Exit Function
    End If
    Set sceneTexture = pNewSceneTexture
    sceneTexture.bind
    If Not wzGLCheckErrors_(5238, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    glTexParameteri GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR
    If Not wzGLCheckErrors_(5240, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    glTexParameteri GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR
    If Not wzGLCheckErrors_(5242, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    sceneTexture.unbind
    If Not wzGLCheckErrors_(5244, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function

    ' Create a matching depth/stencil texture
    sceneDepthStencilRBO = 0
    glGenRenderbuffers 1, VarPtr(sceneDepthStencilRBO)
    If Not wzGLCheckErrors_(5249, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    glBindRenderbuffer GL_RENDERBUFFER, sceneDepthStencilRBO
    If Not wzGLCheckErrors_(5251, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    glRenderbufferStorageMultisample GL_RENDERBUFFER, samples, GL_DEPTH24_STENCIL8, sceneFramebufferWidth, sceneFramebufferHeight ' OpenGL 3.0+, OpenGL ES 3.0+
    If Not wzGLCheckErrors_(5253, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
    glBindRenderbuffer GL_RENDERBUFFER, 0
    If Not wzGLCheckErrors_(5255, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function

    For i = 0 To numSceneFBOs - 1
        newFBO = 0
        glGenFramebuffers 1, VarPtr(newFBO)
        If Not wzGLCheckErrors_(5262, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        ReDim Preserve sceneFBO(0 To sceneFBO_size)
        sceneFBO(sceneFBO_size) = newFBO
        sceneFBO_size = sceneFBO_size + 1

        glBindFramebuffer GL_FRAMEBUFFER, newFBO
        If Not wzGLCheckErrors_(5266, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        If samples > 0 Then
            ' use the MSAA renderbuffer as the color attachment
            glFramebufferRenderbuffer GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, sceneMsaaRBO
            If Not wzGLCheckErrors_(5271, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        Else
            ' just directly use the sceneTexture as the color attachment (since no MSAA resolving needs to occur)
            glFramebufferTexture2D GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sceneTexture.id(), 0
            If Not wzGLCheckErrors_(5277, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        End If
        glFramebufferRenderbuffer GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER, sceneDepthStencilRBO
        If Not wzGLCheckErrors_(5280, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function

        status = glCheckFramebufferStatus(GL_FRAMEBUFFER)
        If status <> GL_FRAMEBUFFER_COMPLETE Then
            debug_ 5285, LOG_ERROR, "createSceneRenderpass", "Failed to create scene framebuffer[%d] (%u x %u, samples: %d) with error: %s", i, sceneFramebufferWidth, sceneFramebufferHeight, samples, cbframebuffererror(status)
            encounteredError = True
        End If
        If Not wzGLCheckErrors_(5288, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function

        glBindFramebuffer GL_FRAMEBUFFER, 0
        If Not wzGLCheckErrors_(5291, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function

        If samples > 0 Then
            ' Must also create a sceneResolveFBO for resolving MSAA
            newResolveRBO = 0
            glGenFramebuffers 1, VarPtr(newResolveRBO)
            If Not wzGLCheckErrors_(5298, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
            ReDim Preserve sceneResolveFBO(0 To sceneResolveFBO_size)
            sceneResolveFBO(sceneResolveFBO_size) = newResolveRBO
            sceneResolveFBO_size = sceneResolveFBO_size + 1

            glBindFramebuffer GL_FRAMEBUFFER, newResolveRBO
            If Not wzGLCheckErrors_(5302, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
            glFramebufferTexture2D GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, sceneTexture.id(), 0
            If Not wzGLCheckErrors_(5304, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
            ' shouldn't need a depth/stencil buffer

            status = glCheckFramebufferStatus(GL_FRAMEBUFFER)
            If status <> GL_FRAMEBUFFER_COMPLETE Then
                debug_ 5310, LOG_ERROR, "createSceneRenderpass", "Failed to create scene resolve framebuffer[%d] (%u x %u, samples: %d) with error: %s", i, sceneFramebufferWidth, sceneFramebufferHeight, samples, cbframebuffererror(status)
                encounteredError = True
            End If
            If Not wzGLCheckErrors_(5313, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function

            glBindFramebuffer GL_FRAMEBUFFER, 0
            If Not wzGLCheckErrors_(5316, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function
        End If
    Next

    If Not wzGLCheckErrors_(5320, "createSceneRenderpass") Then createSceneRenderpass = False: Exit Function

    createSceneRenderpass = Not encounteredError
End Function

Public Sub gl_context_beginSceneRenderPass()
    Dim clearFlags As Long
    glBindFramebuffer GL_FRAMEBUFFER, sceneFBO(sceneFBOIdx)
    glViewport 0, 0, sceneFramebufferWidth, sceneFramebufferHeight
    clearFlags = 0
    glColorMask GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE
    glDepthMask GL_TRUE
    clearFlags = GL_COLOR_BUFFER_BIT Or GL_DEPTH_BUFFER_BIT Or GL_STENCIL_BUFFER_BIT
    glClear clearFlags
End Sub

Public Sub gl_context_endSceneRenderPass()
    Dim invalid_ap(0 To 1) As Long, usingMSAAIntermediate As Boolean, invalid_msaarbo_ap(0 To 0) As Long
    ' Performance optimization:
    '
    ' Before switching the draw framebuffer, call glInvalidateFramebuffer on any parts of the scene framebuffer(s) that we can
    ' NOTE: The only one we need to keep around by the end is sceneTexture, which is bound as GL_COLOR_ATTACHMENT0 on one of the FBOs
    ' However: If using the sceneMsaaRBO, we have to keep that around initially, and only invalidate it after resolving with glBlitFramebuffer
    '
    ' Support:
    ' - OpenGL:
    '       - ARB_invalidate_subdata extension provides glInvalidateFramebuffer
    '           - NOTE: ARB_invalidate_subdata's API does *not* accept GL_DEPTH_STENCIL_ATTACHMENT
    '       - core in OpenGL 4.3+
    ' - OpenGL ES:
    '       - EXT_discard_framebuffer provides glDiscardFramebufferEXT
    '           - NOTE: glDiscardFramebufferEXT does *not* accept GL_DEPTH_STENCIL_ATTACHMENT
    '           - NOTE: glDiscardFramebufferEXT *only* supports GL_FRAMEBUFFER as a target
    '       - core in OpenGL ES 3.0+

    ' invalidate depth_stencil on sceneFBO[sceneFBOIdx]
    If (gles And GLAD_GL_ES_VERSION_3_0) Then
        invalid_ap(0) = GL_DEPTH_STENCIL_ATTACHMENT
        glInvalidateFramebuffer GL_FRAMEBUFFER, 1, VarPtr(invalid_ap(0))
    Else
        invalid_ap(0) = GL_DEPTH_ATTACHMENT
        invalid_ap(1) = GL_STENCIL_ATTACHMENT
        If Not gles And GLAD_GL_ARB_invalidate_subdata Then
            If glad_glInvalidateFramebuffer <> 0 Then
                glInvalidateFramebuffer GL_FRAMEBUFFER, 2, VarPtr(invalid_ap(0))
            End If
        ElseIf gles And GLAD_GL_EXT_discard_framebuffer Then
            If glad_glDiscardFramebufferEXT <> 0 Then
                glDiscardFramebufferEXT GL_FRAMEBUFFER, 2, VarPtr(invalid_ap(0))
            End If
        End If
    End If

    ' If MSAA is enabled, use glBiltFramebuffer from the intermediate MSAA-enabled renderbuffer storage to a standard texture (resolving MSAA)
    usingMSAAIntermediate = (sceneMsaaRBO <> 0)
    If usingMSAAIntermediate Then
        glBindFramebuffer GL_READ_FRAMEBUFFER, sceneFBO(sceneFBOIdx)
        glBindFramebuffer GL_DRAW_FRAMEBUFFER, sceneResolveFBO(sceneFBOIdx)
        glBlitFramebuffer 0, 0, sceneFramebufferWidth, sceneFramebufferHeight, _
                          0, 0, sceneFramebufferWidth, sceneFramebufferHeight, _
                          GL_COLOR_BUFFER_BIT, _
                          GL_LINEAR
    End If

    ' after this, sceneTexture should be the (msaa-resolved) color texture of the scene

    If usingMSAAIntermediate Then
        ' invalidate color0 (sceneMsaaRBO) in sceneFBO[sceneFBOIdx] (which is GL_READ_FRAMEBUFFER at this point)
        invalid_msaarbo_ap(0) = GL_COLOR_ATTACHMENT0
        If (gles And GLAD_GL_ES_VERSION_3_0) Then
            glInvalidateFramebuffer GL_READ_FRAMEBUFFER, 1, VarPtr(invalid_msaarbo_ap(0))
        Else
            If Not gles And GLAD_GL_ARB_invalidate_subdata And glad_glInvalidateFramebuffer <> 0 Then
                glInvalidateFramebuffer GL_READ_FRAMEBUFFER, 1, VarPtr(invalid_msaarbo_ap(0))
            End If
'           else if (gles && GLAD_GL_EXT_discard_framebuffer && glDiscardFramebufferEXT)
'           {
'               // NOTE: glDiscardFramebufferEXT only supports GL_FRAMEBUFFER... but that doesn't work here
'               glDiscardFramebufferEXT(GL_FRAMEBUFFER, 1, invalid_msaarbo_ap);
'           }
        End If
    End If

    sceneFBOIdx = sceneFBOIdx + 1
    If sceneFBOIdx >= sceneFBO_size Then
        sceneFBOIdx = 0
    End If

    ' switch back to default framebuffer
    glBindFramebuffer GL_FRAMEBUFFER, 0
    ' Because the scene uses the same viewport, a call to glViewport should not be needed (NOTE: viewport is *not* part of the framebuffer state)
    If sceneFramebufferWidth <> viewportWidth Or sceneFramebufferHeight <> viewportHeight Then
        glViewport 0, 0, viewportWidth, viewportHeight
    End If
End Sub

Public Function gl_context_getSceneTexture() As gfx_api_abstract_texture
    Set gl_context_getSceneTexture = sceneTexture
End Function
