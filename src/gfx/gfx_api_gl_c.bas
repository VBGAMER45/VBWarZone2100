' new gl_pipeline_state_object(*this, ...)
Private Function gl_pipeline_state_object_new(ByVal patchFragmentShaderMipLodBias As Boolean, createInfo As pipeline_create_info) As gl_pipeline_state_object
    Dim pso As gl_pipeline_state_object
    Set pso = New gl_pipeline_state_object
    pso.construct gles, fragmentHighpFloatAvailable, fragmentHighpIntAvailable, patchFragmentShaderMipLodBias, createInfo, ctx_has_mipLodBias, ctx_mipLodBias, shadowConstants
    Set gl_pipeline_state_object_new = pso
End Function

Public Function gl_context_build_pipeline(ByVal existing_pso As gfx_api_pipeline_state_object, createInfo As pipeline_create_info) As gfx_api_pipeline_state_object
    Dim has_psoID As Boolean, psoID As Long, patchFragmentShaderMipLodBias As Boolean, pipeline As gl_pipeline_state_object
    Dim newID As gfx_api_pipeline_state_object
    If Not existing_pso Is Nothing Then
        has_psoID = True
        psoID = existing_pso.psoID
    End If

    patchFragmentShaderMipLodBias = True ' provide the constant to the shader directly
    Set pipeline = gl_pipeline_state_object_new(patchFragmentShaderMipLodBias, createInfo)
    If Not has_psoID Then
        ' createdPipelines.emplace_back(createInfo)
        ReDim Preserve createdPipelines_createInfo(0 To createdPipelines_size)
        ReDim Preserve createdPipelines_pso(0 To createdPipelines_size)
        createdPipelines_createInfo(createdPipelines_size) = createInfo
        createdPipelines_size = createdPipelines_size + 1
        psoID = createdPipelines_size - 1
        has_psoID = True
        Set createdPipelines_pso(psoID) = pipeline
    Else
        If Not createdPipelines_pso(psoID) Is Nothing Then
            Set createdPipelines_pso(psoID) = Nothing
        End If
        Set createdPipelines_pso(psoID) = pipeline
    End If

    ' return new gl_pipeline_id(psoID.value(), pipeline->broken); // always return a new indirect reference
    Set newID = New gfx_api_pipeline_state_object
    newID.psoID = psoID
    newID.broken = pipeline.broken
    Set gl_context_build_pipeline = newID
End Function

Public Sub gl_context_bind_pipeline(ByVal pso As gfx_api_pipeline_state_object, ByVal notextures As Boolean)
    Dim new_program As gl_pipeline_state_object
    ' lookup pipeline
    Set new_program = createdPipelines_pso(pso.psoID)
    If Not current_program Is new_program Then
        Set current_program = new_program
        current_program.bind
        If notextures Then
            glBindTexture GL_TEXTURE_2D, 0
            glBindTexture GL_TEXTURE_2D_ARRAY, 0
        End If
    End If
End Sub

Private Sub enableVertexAttribArray(ByVal index As Long)
    glEnableVertexAttribArray index
    If Not (enabledVertexAttribIndexes_size >= index) Then ASSERT_FAILURE "enabledVertexAttribIndexes.capacity() >= static_cast<size_t>(index)", "lib/ivis_opengl/gfx_api_gl.cpp:2593", "enableVertexAttribArray", "Insufficient room in enabledVertexAttribIndexes for: %u", index
    enabledVertexAttribIndexes(index) = True
End Sub

Private Sub disableVertexAttribArray(ByVal index As Long)
    glDisableVertexAttribArray index
    If Not (enabledVertexAttribIndexes_size >= index) Then ASSERT_FAILURE "enabledVertexAttribIndexes.size() >= static_cast<size_t>(index)", "lib/ivis_opengl/gfx_api_gl.cpp:2600", "disableVertexAttribArray", "Insufficient room in enabledVertexAttribIndexes for: %u", index
    enabledVertexAttribIndexes(index) = False
End Sub

' vertex_buffers_offset: buffers(i) (Nothing = nullptr) at offsets(i), i < count
Public Sub gl_context_bind_vertex_buffers(ByVal first As Long, buffers() As gfx_api_buffer, offsets() As Long, ByVal count As Long)
    Dim i As Long, e As Long, j As Long, buffer_desc As vertex_buffer, buffer As gl_buffer, attribute_ As vertex_buffer_input
    If Not (Not current_program Is Nothing) Then ASSERT_FAILURE "current_program != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:2606", "bind_vertex_buffers", "current_program == NULL": Exit Sub
    e = count
    i = 0
    Do While i < e And (first + i) < current_program.vertex_buffer_desc_count()
        buffer_desc = current_program.vertex_buffer_desc_at(first + i)
        If buffers(i) Is Nothing Then
            GoTo continue_
        End If
        Set buffer = buffers(i)
        If Not (buffer.usage = buffer_usage_vertex_buffer) Then ASSERT_FAILURE "buffer->usage == gfx_api::buffer::usage::vertex_buffer", "lib/ivis_opengl/gfx_api_gl.cpp:2615", "bind_vertex_buffers", "bind_vertex_buffers called with non-vertex-buffer"
        buffer.bind
        For j = 0 To buffer_desc.attributes_size - 1
            attribute_ = buffer_desc.attributes(j)
            enableVertexAttribArray attribute_.id

            If get_type(attribute_.type_) = GL_INT Or attribute_.type_ = vertex_attribute_type_u8x4_uint Then
                ' glVertexAttribIPointer only supported in: OpenGL 3.0+, OpenGL ES 3.0+
                If Not (glad_glVertexAttribIPointer <> 0) Then ASSERT_FAILURE "glad_glVertexAttribIPointer != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:2625", "bind_vertex_buffers", "Missing glVertexAttribIPointer?"
                glVertexAttribIPointer attribute_.id, get_size(attribute_.type_), get_type(attribute_.type_), buffer_desc.stride, attribute_.offset + offsets(i)
            Else
                glVertexAttribPointer attribute_.id, get_size(attribute_.type_), get_type(attribute_.type_), get_normalisation(attribute_.type_), buffer_desc.stride, attribute_.offset + offsets(i)
            End If

            If buffer_desc.rate = vertex_attribute_input_rate_instance Then
                If hasInstancedRenderingSupport Then
                    glad_call2 wz_dyn_glVertexAttribDivisor, attribute_.id, 1
                Else
                    debug_ 2642, LOG_ERROR, "bind_vertex_buffers", "Instanced rendering is unsupported, but instanced rendering attribute used"
                End If
            End If
        Next
continue_:
        i = i + 1
    Loop
End Sub

Public Sub gl_context_unbind_vertex_buffers(ByVal first As Long, buffers() As gfx_api_buffer, offsets() As Long, ByVal count As Long)
    Dim i As Long, e As Long, j As Long, buffer_desc As vertex_buffer
    If Not (Not current_program Is Nothing) Then ASSERT_FAILURE "current_program != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:2651", "unbind_vertex_buffers", "current_program == NULL": Exit Sub
    e = count
    i = 0
    Do While i < e And (first + i) < current_program.vertex_buffer_desc_count()
        buffer_desc = current_program.vertex_buffer_desc_at(first + i)
        For j = 0 To buffer_desc.attributes_size - 1
            If buffer_desc.rate = vertex_attribute_input_rate_instance Then
                If hasInstancedRenderingSupport Then
                    glad_call2 wz_dyn_glVertexAttribDivisor, buffer_desc.attributes(j).id, 0 ' reset
                End If
            End If
            disableVertexAttribArray buffer_desc.attributes(j).id
        Next
        i = i + 1
    Loop
    glBindBuffer to_gl_usage(buffer_usage_vertex_buffer), 0
End Sub

Public Sub gl_context_disable_all_vertex_buffers()
    Dim index As Long
    For index = 0 To enabledVertexAttribIndexes_size - 1
        If enabledVertexAttribIndexes(index) Then
            If hasInstancedRenderingSupport Then
                glad_call2 wz_dyn_glVertexAttribDivisor, index, 0 ' reset
            End If
            disableVertexAttribArray index
        End If
    Next
    glBindBuffer to_gl_usage(buffer_usage_vertex_buffer), 0
End Sub

Public Sub gl_context_bind_streamed_vertex_buffers(ByVal data As Long, ByVal size As Long)
    Dim buffer_desc As vertex_buffer, j As Long, attribute_ As vertex_buffer_input
    If Not (Not current_program Is Nothing) Then ASSERT_FAILURE "current_program != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:2688", "bind_streamed_vertex_buffers", "current_program == NULL": Exit Sub
    If Not (size > 0) Then ASSERT_FAILURE "size > 0", "lib/ivis_opengl/gfx_api_gl.cpp:2689", "bind_streamed_vertex_buffers", "bind_streamed_vertex_buffers called with size 0"
    glBindBuffer GL_ARRAY_BUFFER, scratchbuffer
    If scratchbuffer_size > 0 Then
        glBufferData GL_ARRAY_BUFFER, scratchbuffer_size, 0, GL_STREAM_DRAW ' orphan previous buffer
    End If
    glBufferData GL_ARRAY_BUFFER, size, data, GL_STREAM_DRAW
    scratchbuffer_size = size
    buffer_desc = current_program.vertex_buffer_desc_at(0)
    For j = 0 To buffer_desc.attributes_size - 1
        attribute_ = buffer_desc.attributes(j)
        enableVertexAttribArray attribute_.id
        glVertexAttribPointer attribute_.id, get_size(attribute_.type_), get_type(attribute_.type_), get_normalisation(attribute_.type_), buffer_desc.stride, 0
    Next
End Sub

