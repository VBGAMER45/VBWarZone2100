Private Function splitStringIntoVector(ByVal pStr As String, ByVal delimeter As String) As StringVector
    Dim result As StringVector, i As Long, j As Long, n As Long
    n = Len(pStr)
    i = 1
    Do While i <= n
        j = InStr(i, pStr, delimeter, vbBinaryCompare)
        If j = 0 Then j = n + 1
        StringVector_push_back result, Mid$(pStr, i, j - i)
        i = j + 1
    Loop
    splitStringIntoVector = result
End Function

Private Function wzGLGetStringi_GL_EXTENSIONS_Impl() As StringVector
    Dim extensions As StringVector, ext_count As Long, i As Long, pGLStr As Long

    If glad_glGetIntegerv = 0 Or glad_glGetStringi = 0 Then
        wzGLGetStringi_GL_EXTENSIONS_Impl = extensions
        Exit Function
    End If

    ext_count = 0
    glGetIntegerv GL_NUM_EXTENSIONS, VarPtr(ext_count)
    If ext_count < 0 Then
        ext_count = 0
    End If
    For i = 0 To ext_count - 1
        pGLStr = glGetStringi(GL_EXTENSIONS, i)
        If pGLStr <> 0 Then
            StringVector_push_back extensions, gl_cstr(pGLStr)
        End If
    Next

    wzGLGetStringi_GL_EXTENSIONS_Impl = extensions
End Function

' Returns a space-separated list of OpenGL extensions
Private Function getGLExtensions() As StringVector
    Dim extensions As StringVector, pExtensionsStr As Long
    If GLAD_GL_VERSION_3_0 Then
        ' OpenGL 3.0+
        getGLExtensions = wzGLGetStringi_GL_EXTENSIONS_Impl()
        Exit Function
    Else
        ' OpenGL < 3.0
        If Not (glad_glGetString <> 0) Then ASSERT_FAILURE "glGetString != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:3182", "getGLExtensions", "glGetString is null": getGLExtensions = extensions: Exit Function
        pExtensionsStr = glGetString(GL_EXTENSIONS)
        If pExtensionsStr <> 0 Then
            extensions = splitStringIntoVector(gl_cstr(pExtensionsStr), " ")
        End If
    End If
    getGLExtensions = extensions
End Function

' std::map<std::string, std::string>: a Scripting.Dictionary
Public Function gl_context_getBackendGameInfo() As Object
    Dim backendGameInfo As Object, extensions As StringVector
