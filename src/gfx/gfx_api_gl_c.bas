Public Function gl_context_get_context_value(ByVal property_ As context_value) As Long
    Dim value As Long
    value = 0
    Select Case property_
    Case context_value_MAX_SAMPLES
        gl_context_get_context_value = maxMultiSampleBufferFormatSamples
        Exit Function
    Case context_value_MAX_VERTEX_OUTPUT_COMPONENTS
        ' special-handling for MAX_VERTEX_OUTPUT_COMPONENTS
        If Not gles Then
            If GLAD_GL_VERSION_3_2 Then
                glGetIntegerv GL_MAX_VERTEX_OUTPUT_COMPONENTS, VarPtr(value)
            Else
                ' for earlier OpenGL, just default to MAX_VARYING_FLOATS
                glGetIntegerv GL_MAX_VARYING_FLOATS, VarPtr(value)
            End If
        Else
            If GLAD_GL_ES_VERSION_3_0 Then
                glGetIntegerv GL_MAX_VERTEX_OUTPUT_COMPONENTS, VarPtr(value)
            Else
                ' for OpenGL ES 2.0, use GL_MAX_VARYING_VECTORS * 4 ...
                glGetIntegerv GL_MAX_VARYING_VECTORS, VarPtr(value)
                value = value * 4
            End If
        End If
    Case Else
        glGetIntegerv to_gl_property(property_), VarPtr(value)
    End Select

    gl_context_get_context_value = value
End Function

' uint64_t (a Double)
Public Function gl_context_get_estimated_vram_mb(ByVal dedicatedOnly As Boolean) As Double
    Dim total_graphics_mem_kb As Long, stats_kb(0 To 3) As Long, currentFreeTextureMemory_mb As Double
    If GLAD_GL_NVX_gpu_memory_info Then
        ' If GL_NVX_gpu_memory_info is available, get the total dedicated graphics memory
        total_graphics_mem_kb = 0
        glGetIntegerv GL_GPU_MEMORY_INFO_DEDICATED_VIDMEM_NVX, VarPtr(total_graphics_mem_kb)
        debug_ 2964, LOG_3D, "get_estimated_vram_mb", "GL_GPU_MEMORY_INFO_DEDICATED_VIDMEM_NVX: %d", total_graphics_mem_kb

        If total_graphics_mem_kb > 0 Then
            gl_context_get_estimated_vram_mb = total_graphics_mem_kb \ 1024
            Exit Function
        End If
    ElseIf GLAD_GL_ATI_meminfo And Not dedicatedOnly Then
        ' For GL_ATI_meminfo, get the current free texture memory (stats_kb[0])
        glGetIntegerv GL_TEXTURE_FREE_MEMORY_ATI, VarPtr(stats_kb(0))
        If stats_kb(0) > 0 Then
            debug_ 2978, LOG_3D, "get_estimated_vram_mb", "GL_TEXTURE_FREE_MEMORY_ATI [0: total pool avail]: %d", stats_kb(0)
            debug_ 2979, LOG_3D, "get_estimated_vram_mb", "GL_TEXTURE_FREE_MEMORY_ATI [1: largest pool avail]: %d", stats_kb(1)

            currentFreeTextureMemory_mb = stats_kb(0) \ 1024
            gl_context_get_estimated_vram_mb = currentFreeTextureMemory_mb
            Exit Function
        End If
    End If

    gl_context_get_estimated_vram_mb = 0
End Function

