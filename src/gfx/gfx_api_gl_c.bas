Private Sub wzGLObjectLabel(ByVal identifier As Long, ByVal name_ As Long, ByVal length As Long, ByVal label As String)
    If Not (GLAD_GL_ES_VERSION_3_2 Or GLAD_GL_KHR_debug) Then
        Exit Sub
    End If

    If Not useKHRSuffixedDebugFuncs() Then
        If glad_glObjectLabel <> 0 Then
            glObjectLabel identifier, name_, length, label
        End If
    Else
        If glad_glObjectLabelKHR <> 0 Then
            glObjectLabelKHR identifier, name_, length, label
        End If
    End If
End Sub

Private Sub wzGLPushDebugGroup(ByVal source As Long, ByVal id As Long, ByVal length As Long, ByVal message As String)
    If Not (GLAD_GL_ES_VERSION_3_2 Or GLAD_GL_KHR_debug) Then
        Exit Sub
    End If

    If Not useKHRSuffixedDebugFuncs() Then
        If glad_glPushDebugGroup <> 0 Then
            glPushDebugGroup source, id, length, message
        End If
    Else
        If glad_glPushDebugGroupKHR <> 0 Then
            glPushDebugGroupKHR source, id, length, message
        End If
    End If
End Sub

Private Sub wzGLPopDebugGroup()
    If Not (GLAD_GL_ES_VERSION_3_2 Or GLAD_GL_KHR_debug) Then
        Exit Sub
    End If

    If Not useKHRSuffixedDebugFuncs() Then
        If glad_glPopDebugGroup <> 0 Then
            glPopDebugGroup
        End If
    Else
        If glad_glPopDebugGroupKHR <> 0 Then
            glPopDebugGroupKHR
        End If
    End If
End Sub

Private Function useKHRSuffixedDebugFuncs() As Boolean
    If Not gles Then
        ' Desktop OpenGL does *not* use KHR-suffixed entrypoints
        useKHRSuffixedDebugFuncs = False
        Exit Function
    End If

    ' OpenGL ES:
    '
    ' OpenGL ES 3.2 makes this "core" (without the suffix)
    If GLAD_GL_ES_VERSION_3_2 Then
        useKHRSuffixedDebugFuncs = False
        Exit Function
    End If
    ' When KHR_debug is implemented in an OpenGL ES context, all entry points defined must have a "KHR" suffix.
    ' Reference: https://registry.khronos.org/OpenGL/extensions/KHR/KHR_debug.txt
    If GLAD_GL_KHR_debug Then
        useKHRSuffixedDebugFuncs = True
        Exit Function
    End If
    useKHRSuffixedDebugFuncs = False
End Function

Private Function initGLContext() As Boolean
    Dim glExtensions As StringVector, line_ As String, word As String, n As Long
    Dim bShaderCompilerSupported As Long, highpFloatRange(0 To 1) As Long, highpFloatPrecision As Long
    Dim highpIntRange(0 To 1) As Long, highpIntPrecision As Long, glslVersion_first As Long, glslVersion_second As Long
    Dim glMaxTIUs As Long, glMaxTIUAs As Long, glmaxSamples As Long, glmaxSamplesbuf As Long, glmaxVertexAttribs As Long, glMaxArrayTextureLayers As Long
    Dim estimatedVRAMinMiB As Long
    frameNum = 1
    gles = backend_impl.isOpenGLES()

    ' GLADloadproc func_GLGetProcAddress = backend_impl->getGLGetProcAddress(): the loader is the backend's
    ' getGLGetProcAddress method, so it cannot be NULL
    If Not gles Then
        If Not gladLoadGLLoader(backend_impl) Then
            debug_ 3851, LOG_FATAL, "initGLContext", "gladLoadGLLoader failed"
            initGLContext = False
            Exit Function
        End If
    Else
        If Not gladLoadGLES2Loader(backend_impl) Then
            debug_ 3859, LOG_FATAL, "initGLContext", "gladLoadGLLoader failed"
            initGLContext = False
            Exit Function
        End If
    End If

    ' Dump general information about OpenGL implementation to the console and the dump file
    opengl.vendor = Left$(va("OpenGL Vendor: %s", wzSafeGlGetString(GL_VENDOR)), 255)
    addDumpInfo opengl.vendor
    debug_ 3868, LOG_INFO, "initGLContext", "%s", opengl.vendor
    opengl.renderer = Left$(va("OpenGL Renderer: %s", wzSafeGlGetString(GL_RENDERER)), 255)
    addDumpInfo opengl.renderer
    debug_ 3871, LOG_INFO, "initGLContext", "%s", opengl.renderer
    opengl.version = Left$(va("OpenGL Version: %s", wzSafeGlGetString(GL_VERSION)), 255)
    addDumpInfo opengl.version
    debug_ 3874, LOG_INFO, "initGLContext", "%s", opengl.version

    formattedRendererInfoString = calculateFormattedRendererInfoString()

    If isBlocklistedGraphicsDriver() Then
        debug_ 3880, LOG_INFO, "initGLContext", "Warzone's OpenGL backend is not supported on this system. (%s, %s)", opengl.renderer, opengl.version
        debug_ 3881, LOG_INFO, "initGLContext", "Please update your graphics drivers or try a different backend."
        initGLContext = False
        Exit Function
    End If

    khr_debug = (GLAD_GL_ES_VERSION_3_2 Or GLAD_GL_KHR_debug)

    ' Dump extended information about OpenGL implementation to the console

    glExtensions = getGLExtensions()
    For n = 0 To glExtensions.size - 1
        word = " "
        word = word & glExtensions.items(n)
        If n + 1 <> glExtensions.size Then
            word = word & ","
        End If
        If Len(line_) + Len(word) > 160 Then
            debug_ 3907, LOG_3D, "initGLContext", "OpenGL Extensions:%s", line_
            line_ = ""
        End If
        line_ = line_ & word
    Next
    debug_ 3912, LOG_3D, "initGLContext", "OpenGL Extensions:%s", line_
    If Not gles Then
        debug_ 3915, LOG_3D, "initGLContext", "Notable OpenGL features:"
        debug_ 3916, LOG_3D, "initGLContext", "  * OpenGL 2.0 %s supported!", IIf(GLAD_GL_VERSION_2_0, "is", "is NOT")
        debug_ 3917, LOG_3D, "initGLContext", "  * OpenGL 2.1 %s supported!", IIf(GLAD_GL_VERSION_2_1, "is", "is NOT")
        debug_ 3918, LOG_3D, "initGLContext", "  * OpenGL 3.0 %s supported!", IIf(GLAD_GL_VERSION_3_0, "is", "is NOT")
        debug_ 3919, LOG_3D, "initGLContext", "  * OpenGL 3.1 %s supported!", IIf(GLAD_GL_VERSION_3_1, "is", "is NOT")
        debug_ 3920, LOG_3D, "initGLContext", "  * OpenGL 3.2 %s supported!", IIf(GLAD_GL_VERSION_3_2, "is", "is NOT")
        debug_ 3921, LOG_3D, "initGLContext", "  * OpenGL 3.3 %s supported!", IIf(GLAD_GL_VERSION_3_3, "is", "is NOT")
        ' (GLAD_GL_VERSION_4_0 / 4_1: not in this glad)

        debug_ 3929, LOG_3D, "initGLContext", "  * Stencil wrap %s supported.", IIf(GLAD_GL_EXT_stencil_wrap, "is", "is NOT")
        debug_ 3930, LOG_3D, "initGLContext", "  * Rectangular texture %s supported.", IIf(GLAD_GL_ARB_texture_rectangle, "is", "is NOT")
        debug_ 3931, LOG_3D, "initGLContext", "  * FrameBuffer Object (FBO) %s supported.", IIf(GLAD_GL_EXT_framebuffer_object, "is", "is NOT")
        debug_ 3932, LOG_3D, "initGLContext", "  * ARB Vertex Buffer Object (VBO) %s supported.", IIf(GLAD_GL_ARB_vertex_buffer_object, "is", "is NOT")
        debug_ 3933, LOG_3D, "initGLContext", "  * NPOT %s supported.", IIf(GLAD_GL_ARB_texture_non_power_of_two, "is", "is NOT")
        debug_ 3934, LOG_3D, "initGLContext", "  * texture cube_map %s supported.", IIf(GLAD_GL_ARB_texture_cube_map, "is", "is NOT")
        debug_ 3936, LOG_3D, "initGLContext", "  * GL_ARB_timer_query %s supported!", IIf(GLAD_GL_ARB_timer_query, "is", "is NOT")
    Else
        debug_ 3941, LOG_3D, "initGLContext", "  * OpenGL ES 2.0 %s supported!", IIf(GLAD_GL_ES_VERSION_2_0, "is", "is NOT")
        debug_ 3942, LOG_3D, "initGLContext", "  * OpenGL ES 3.0 %s supported!", IIf(GLAD_GL_ES_VERSION_3_0, "is", "is NOT")
    End If
    debug_ 3944, LOG_3D, "initGLContext", "  * Anisotropic filtering %s supported.", IIf(GLAD_GL_EXT_texture_filter_anisotropic, "is", "is NOT")
    debug_ 3946, LOG_3D, "initGLContext", "  * KHR_DEBUG support %s detected", IIf(khr_debug, "was", "was NOT")
    debug_ 3948, LOG_3D, "initGLContext", "  * glGenerateMipmap support %s detected", IIf(glad_glGenerateMipmap <> 0, "was", "was NOT")

    If Not GLAD_GL_VERSION_3_0 And Not GLAD_GL_ES_VERSION_3_0 Then
        debug_ 3952, LOG_POPUP, "initGLContext", "OpenGL 3.0+ / OpenGL ES 3.0+ not supported! Please upgrade your drivers."
        initGLContext = False
        Exit Function
    End If

    If Not gles Then
        If Not GLAD_GL_VERSION_3_1 Then
            ' non-fatal pop-up, to warn about OpenGL < 3.1 (we may require 3.1+ in the future)
            debug_ 3961, LOG_POPUP, "initGLContext", "OpenGL 3.1+ is not supported - Please upgrade your drivers or try a different graphics backend."
        End If
    End If

    fragmentHighpFloatAvailable = True
    fragmentHighpIntAvailable = True
    If gles Then
        bShaderCompilerSupported = GL_FALSE
        glGetBooleanv GL_SHADER_COMPILER, VarPtr(bShaderCompilerSupported)
        If (bShaderCompilerSupported And &HFF&) <> GL_TRUE Then
            debug_ 4010, LOG_FATAL, "initGLContext", "Shader compiler is not supported! (GL_SHADER_COMPILER == GL_FALSE)"
            initGLContext = False
            Exit Function
        End If

        highpFloatPrecision = 0
        glGetShaderPrecisionFormat GL_FRAGMENT_SHADER, GL_HIGH_FLOAT, VarPtr(highpFloatRange(0)), VarPtr(highpFloatPrecision)
        fragmentHighpFloatAvailable = highpFloatPrecision <> 0

        highpIntPrecision = 0
        glGetShaderPrecisionFormat GL_FRAGMENT_SHADER, GL_HIGH_INT, VarPtr(highpIntRange(0)), VarPtr(highpIntPrecision)
        fragmentHighpIntAvailable = highpFloatRange(1) <> 0

        If Not fragmentHighpFloatAvailable Or Not fragmentHighpIntAvailable Then
            ' This can lead to a uniform precision mismatch between the vertex and fragment shaders
            ' (if there are duplicate uniform names).
            '
            ' This is now handled with a workaround when processing shaders, so just log it.
            debug_ 4028, LOG_FATAL, "initGLContext", "OpenGL ES: Fragment shaders do not support high precision: (highpFloat: %d; highpInt: %d)", IIf(fragmentHighpFloatAvailable, 1, 0), IIf(fragmentHighpIntAvailable, 1, 0)
            ' FUTURE TODO: return false;
        End If
    End If

    ' std::pair<int, int> glslVersion(0, 0);
    sscanf wzSafeGlGetString(GL_SHADING_LANGUAGE_VERSION), "%d.%d", glslVersion_first, glslVersion_second

    ' Dump information about OpenGL 2.0+ implementation to the console and the dump file

    debug_ 4039, LOG_3D, "initGLContext", "  * OpenGL GLSL Version : %s", wzSafeGlGetString(GL_SHADING_LANGUAGE_VERSION)
    opengl.GLSLversion = Left$(va("OpenGL GLSL Version : %s", wzSafeGlGetString(GL_SHADING_LANGUAGE_VERSION)), 255)
    addDumpInfo opengl.GLSLversion

    glGetIntegerv GL_MAX_TEXTURE_IMAGE_UNITS, VarPtr(glMaxTIUs)
    debug_ 4044, LOG_3D, "initGLContext", "  * Total number of Texture Image Units (TIUs) supported is %d.", glMaxTIUs
    glGetIntegerv GL_MAX_COMBINED_TEXTURE_IMAGE_UNITS, VarPtr(glMaxTIUAs)
    debug_ 4046, LOG_3D, "initGLContext", "  * Total number of Texture Image Units ARB(TIUAs) supported is %d.", glMaxTIUAs
    glGetIntegerv GL_SAMPLE_BUFFERS, VarPtr(glmaxSamplesbuf)
    debug_ 4048, LOG_3D, "initGLContext", "  * (current) Max Sample buffer is %d.", glmaxSamplesbuf
    glGetIntegerv GL_SAMPLES, VarPtr(glmaxSamples)
    debug_ 4050, LOG_3D, "initGLContext", "  * (current) Max Sample level is %d.", glmaxSamples
    glGetIntegerv GL_MAX_VERTEX_ATTRIBS, VarPtr(glmaxVertexAttribs)
    debug_ 4052, LOG_3D, "initGLContext", "  * (current) Max vertex attribute locations is %d.", glmaxVertexAttribs
    glGetIntegerv GL_MAX_ARRAY_TEXTURE_LAYERS, VarPtr(glMaxArrayTextureLayers)
    debug_ 4054, LOG_3D, "initGLContext", "  * (current) Max array texture layers is %d.", glMaxArrayTextureLayers
    maxArrayTextureLayers = glMaxArrayTextureLayers

    estimatedVRAMinMiB = CLng(gl_context_get_estimated_vram_mb(False))
    If estimatedVRAMinMiB > 0 Then
        debug_ 4060, LOG_3D, "initGLContext", "  * Estimated VRAM is %u MiB", estimatedVRAMinMiB
    End If

    ' IMPORTANT: Reserve enough slots in enabledVertexAttribIndexes based on glmaxVertexAttribs
    If glmaxVertexAttribs = 0 Then
        debug_ 4066, LOG_3D, "initGLContext", "GL_MAX_VERTEX_ATTRIBS did not return a value - defaulting to 8"
        glmaxVertexAttribs = 8
    End If
    ' enabledVertexAttribIndexes.resize(static_cast<size_t>(glmaxVertexAttribs), false)
    ReDim Preserve enabledVertexAttribIndexes(0 To glmaxVertexAttribs - 1)
    enabledVertexAttribIndexes_size = glmaxVertexAttribs

    wzGLClearErrors_

    If khr_debug Then
        enableDebugMessageCallbacks
    End If

    If GLAD_GL_VERSION_3_0 Then ' if context is OpenGL 3.0+
        ' Very simple VAO code - just bind a single global VAO (this gets things working, but is not optimal)
        vaoId = 0
        If glad_glGenVertexArrays = 0 Then
            debug_ 4087, LOG_FATAL, "initGLContext", "glGenVertexArrays is not available, but context is OpenGL 3.0+"
            initGLContext = False
            Exit Function
        End If
        glGenVertexArrays 1, VarPtr(vaoId)
        wzGLCheckErrors_ 4091, "initGLContext"
        glBindVertexArray vaoId
        wzGLCheckErrors_ 4093, "initGLContext"
    End If

    If GLAD_GL_ARB_timer_query Then
        glGenQueries PERF_COUNT, VarPtr(perfpos(0))
        wzGLCheckErrors_ 4101, "initGLContext"
    End If

    If GLAD_GL_EXT_texture_filter_anisotropic Then
        maxTextureAnisotropy = 0!
        glGetFloatv GL_MAX_TEXTURE_MAX_ANISOTROPY_EXT, VarPtr(maxTextureAnisotropy)
        debug_ 4109, LOG_3D, "initGLContext", "  * (current) maxTextureAnisotropy: %f", maxTextureAnisotropy
        wzGLCheckErrors_ 4110, "initGLContext"
    End If

    glGenBuffers 1, VarPtr(scratchbuffer)
    wzGLCheckErrors_ 4114, "initGLContext"

    glPixelStorei GL_UNPACK_ALIGNMENT, 1
    wzGLCheckErrors_ 4117, "initGLContext"

    debug_ 4119, LOG_INFO, "initGLContext", "Success"

    initGLContext = True
End Function

Public Function gl_context_numDepthPasses() As Long
    gl_context_numDepthPasses = depthFBO_size
End Function

Public Function gl_context_setDepthPassProperties(ByVal numDepthPasses_ As Long, ByVal depthBufferResolution_ As Long) As Boolean
    If depthPassCount = numDepthPasses_ _
       And depthBufferResolution = depthBufferResolution_ Then
        ' nothing to do
        gl_context_setDepthPassProperties = True
        Exit Function
    End If

    depthPassCount = numDepthPasses_
    depthBufferResolution = depthBufferResolution_

    ' reinitialize depth passes
    initDepthPasses depthBufferResolution

    gl_context_setDepthPassProperties = True
End Function

Public Sub gl_context_beginDepthPass(ByVal idx As Long)
    If Not (idx < depthFBO_size) Then ASSERT_FAILURE "idx < depthFBO.size()", "lib/ivis_opengl/gfx_api_gl.cpp:4149", "beginDepthPass", "Invalid depth pass #: %zu", idx: Exit Sub
    glBindFramebuffer GL_FRAMEBUFFER, depthFBO(idx)
    glViewport 0, 0, depthBufferResolution, depthBufferResolution
    glDepthMask GL_TRUE
    glClear GL_DEPTH_BUFFER_BIT
End Sub

Public Function gl_context_getDepthPassDimensions(ByVal idx As Long) As Long
    gl_context_getDepthPassDimensions = depthBufferResolution
End Function

Public Sub gl_context_endCurrentDepthPass()
    glBindFramebuffer GL_FRAMEBUFFER, 0
'   glViewport(0, 0, viewportWidth, viewportHeight);
'   glDepthMask(GL_TRUE);
End Sub

Public Function gl_context_getDepthTexture() As gfx_api_abstract_texture
    Set gl_context_getDepthTexture = depthTexture
End Function

Private Sub beginRenderPassImpl_()
    Dim clearFlags As Long
    glBindFramebuffer GL_FRAMEBUFFER, 0
    glViewport 0, 0, viewportWidth, viewportHeight
    clearFlags = 0
    glColorMask GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE
    glDepthMask GL_TRUE
    clearFlags = GL_COLOR_BUFFER_BIT Or GL_DEPTH_BUFFER_BIT Or GL_STENCIL_BUFFER_BIT
    glClear clearFlags
End Sub

Public Sub gl_context_beginRenderPass()
    ' no-op everywhere else (than Emscripten)
End Sub

' [[noreturn]]
Private Sub glContextHandleOOMError()
    wzDisplayFatalGfxBackendFailure "GL_OUT_OF_MEMORY"
    wzResetGfxSettingsOnFailure
    exit_ 3                             ' abort()
End Sub

Public Sub gl_context_endRenderPass()
    frameNum = frameNum + 1
    If frameNum < 1 Then frameNum = 1   ' std::max<size_t>(frameNum + 1, 1)
    backend_impl.swapWindow
    glUseProgram 0
    Set current_program = Nothing
    beginRenderPassImpl_

    If khrCallbackOomDetected Then
        glContextHandleOOMError
    End If
End Sub

