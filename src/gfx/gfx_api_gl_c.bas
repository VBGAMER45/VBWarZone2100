' program_data{ friendly_name, vertex_file, fragment_file, uniform_names, additional_samplers } (samplers: name, unit pairs)
Private Sub program_data_set(pd As program_data, ByVal friendly_name As String, ByVal vertex_file As String, ByVal fragment_file As String, ByVal uniform_names As Variant, Optional ByVal additional_samplers As Variant)
    Dim i As Long
    pd.friendly_name = friendly_name
    pd.vertex_file = vertex_file
    pd.fragment_file = fragment_file
    For i = 0 To UBound(uniform_names)
        StringVector_push_back pd.uniform_names, CStr(uniform_names(i))
    Next
    pd.additional_samplers_size = 0
    If Not IsMissing(additional_samplers) Then
        pd.additional_samplers_size = (UBound(additional_samplers) + 1) \ 2
        ReDim pd.additional_sampler_names(0 To pd.additional_samplers_size - 1)
        ReDim pd.additional_sampler_units(0 To pd.additional_samplers_size - 1)
        For i = 0 To pd.additional_samplers_size - 1
            pd.additional_sampler_names(i) = CStr(additional_samplers(2 * i))
            pd.additional_sampler_units(i) = CLng(additional_samplers(2 * i + 1))
        Next
    End If
End Sub

Public Function shaderVersionString(ByVal version As SHADER_VERSION) As String
    Select Case version
    Case VERSION_120
        shaderVersionString = "#version 120" & vbLf: Exit Function
    Case VERSION_130
        shaderVersionString = "#version 130" & vbLf: Exit Function
    Case VERSION_140
        shaderVersionString = "#version 140" & vbLf: Exit Function
    Case VERSION_150_CORE
        shaderVersionString = "#version 150 core" & vbLf: Exit Function
    Case VERSION_330_CORE
        shaderVersionString = "#version 330 core" & vbLf: Exit Function
    Case VERSION_400_CORE
        shaderVersionString = "#version 400 core" & vbLf: Exit Function
    Case VERSION_410_CORE
        shaderVersionString = "#version 410 core" & vbLf: Exit Function
    Case VERSION_AUTODETECT_FROM_LEVEL_LOAD
        shaderVersionString = "": Exit Function
    Case VERSION_FIXED_IN_FILE
        shaderVersionString = "": Exit Function
        ' Deliberately omit "default:" case to trigger a compiler warning if the SHADER_VERSION enum is expanded but the new cases aren't handled here
    End Select
    shaderVersionString = "" ' Should not not reach here - silence a GCC warning
End Function

' const char * shaderVersionString(SHADER_VERSION_ES version)
