' static float* to_gl(gfx_api::border_color border): the address of the colour's floats
Private Function to_gl_border(ByVal border As border_color) As Long
    Select Case border
    Case border_color_none, border_color_transparent_black
        to_gl_border = VarPtr(transparentBlackFloats(0)): Exit Function
    Case border_color_opaque_black
        to_gl_border = VarPtr(opaqueBlackFloats(0)): Exit Function
    Case border_color_opaque_white
        to_gl_border = VarPtr(opaqueWhiteFloats(0)): Exit Function
    End Select
    debug_ 2733, LOG_FATAL, "to_gl", "Unsupported border_color"
    to_gl_border = VarPtr(transparentBlackFloats(0))
End Function

' textures(i) (Nothing = nullptr), i < textureCount
Public Sub gl_context_bind_textures(texture_descriptions() As texture_input, ByVal descriptionCount As Long, textures() As gfx_api_abstract_texture, ByVal textureCount As Long)
    Dim i As Long, desc As texture_input, pTextureToBind As gfx_api_abstract_texture, type_ As Long, unusedtype As Long
    Dim isArrayTarget As Boolean
    If Not (Not current_program Is Nothing) Then ASSERT_FAILURE "current_program != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:2739", "bind_textures", "current_program == NULL": Exit Sub
    If Not (textureCount <= descriptionCount) Then ASSERT_FAILURE "textures.size() <= texture_descriptions.size()", "lib/ivis_opengl/gfx_api_gl.cpp:2740", "bind_textures", "Received more textures than expected"
    i = 0
    Do While i < descriptionCount And i < textureCount
        desc = texture_descriptions(i)
        Set pTextureToBind = textures(i)
        glActiveTexture GL_TEXTURE0 + desc.id
        If pTextureToBind Is Nothing Then
            Select Case desc.target
            Case pixel_format_target_texture_2d
                Set pTextureToBind = pDefaultTexture
            Case pixel_format_target_texture_2d_array
                Set pTextureToBind = pDefaultArrayTexture
            Case pixel_format_target_depth_map
                Set pTextureToBind = pDefaultDepthTexture
            End Select
        End If
        isArrayTarget = (desc.target = pixel_format_target_texture_2d_array Or desc.target = pixel_format_target_depth_map)
        If pTextureToBind Is Nothing Then
            ASSERT_FAILURE "pTextureToBind && (pTextureToBind->isArray() == (desc.target == gfx_api::pixel_format_target::texture_2d_array || desc.target == gfx_api::pixel_format_target::depth_map))", "lib/ivis_opengl/gfx_api_gl.cpp:2761", "bind_textures", "Found a mismatch!"
        ElseIf Not (pTextureToBind.isArray() = isArrayTarget) Then
            ASSERT_FAILURE "pTextureToBind && (pTextureToBind->isArray() == (desc.target == gfx_api::pixel_format_target::texture_2d_array || desc.target == gfx_api::pixel_format_target::depth_map))", "lib/ivis_opengl/gfx_api_gl.cpp:2761", "bind_textures", "Found a mismatch!"
        End If
        If pTextureToBind.isArray() Then type_ = GL_TEXTURE_2D_ARRAY Else type_ = GL_TEXTURE_2D
        If pTextureToBind.isArray() Then unusedtype = GL_TEXTURE_2D Else unusedtype = GL_TEXTURE_2D_ARRAY
        glBindTexture unusedtype, 0
        pTextureToBind.bind
        If textures(i) Is Nothing Then
            ' we're using a default texture, so skip changing filters
            GoTo continue_
        End If
        Select Case desc.sampler
        Case sampler_type_nearest_clamped
            glTexParameteri type_, GL_TEXTURE_MIN_FILTER, GL_NEAREST
            glTexParameteri type_, GL_TEXTURE_MAG_FILTER, GL_NEAREST
            glTexParameteri type_, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE
            glTexParameteri type_, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE
        Case sampler_type_nearest_border
            glTexParameteri type_, GL_TEXTURE_MIN_FILTER, GL_NEAREST
            glTexParameteri type_, GL_TEXTURE_MAG_FILTER, GL_NEAREST
            If hasBorderClampSupport Then
                glTexParameteri type_, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_BORDER
                glTexParameteri type_, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_BORDER
                glTexParameterfv type_, GL_TEXTURE_BORDER_COLOR, to_gl_border(desc.border)
            End If
        Case sampler_type_bilinear
            glTexParameteri type_, GL_TEXTURE_MIN_FILTER, GL_LINEAR
            glTexParameteri type_, GL_TEXTURE_MAG_FILTER, GL_LINEAR
            glTexParameteri type_, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE
            glTexParameteri type_, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE
        Case sampler_type_bilinear_repeat
            glTexParameteri type_, GL_TEXTURE_MIN_FILTER, GL_LINEAR
            glTexParameteri type_, GL_TEXTURE_MAG_FILTER, GL_LINEAR
            glTexParameteri type_, GL_TEXTURE_WRAP_S, GL_REPEAT
            glTexParameteri type_, GL_TEXTURE_WRAP_T, GL_REPEAT
        Case sampler_type_bilinear_border
            glTexParameteri type_, GL_TEXTURE_MIN_FILTER, GL_LINEAR
            glTexParameteri type_, GL_TEXTURE_MAG_FILTER, GL_LINEAR
            If hasBorderClampSupport Then
                glTexParameteri type_, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_BORDER
                glTexParameteri type_, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_BORDER
                glTexParameterfv type_, GL_TEXTURE_BORDER_COLOR, to_gl_border(desc.border)
            End If
        Case sampler_type_anisotropic_repeat
            glTexParameteri type_, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR
            glTexParameteri type_, GL_TEXTURE_MAG_FILTER, GL_LINEAR
            glTexParameteri type_, GL_TEXTURE_WRAP_S, GL_REPEAT
            glTexParameteri type_, GL_TEXTURE_WRAP_T, GL_REPEAT
            If GLAD_GL_EXT_texture_filter_anisotropic Then
                glTexParameterf type_, GL_TEXTURE_MAX_ANISOTROPY_EXT, IIf(4! < maxTextureAnisotropy, 4!, maxTextureAnisotropy)
            End If
        Case sampler_type_anisotropic
            glTexParameteri type_, GL_TEXTURE_MIN_FILTER, GL_LINEAR_MIPMAP_LINEAR
            glTexParameteri type_, GL_TEXTURE_MAG_FILTER, GL_LINEAR
            glTexParameteri type_, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE
            glTexParameteri type_, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE
            If GLAD_GL_EXT_texture_filter_anisotropic Then
                glTexParameterf type_, GL_TEXTURE_MAX_ANISOTROPY_EXT, IIf(4! < maxTextureAnisotropy, 4!, maxTextureAnisotropy)
            End If
        End Select
continue_:
        i = i + 1
    Loop
    glActiveTexture GL_TEXTURE0
End Sub

