            Array("transformationMatrix", "tuv_offset", "tuv_scale", "color")
    Case SHADER_DEBUG_TEXTURE2D_QUAD
        program_data_set pd, "Debug texture quad program", "shaders/quad_texture2d.vert", "shaders/quad_texture2d.frag", _
            Array("transformationMatrix", "uvTransformMatrix", "swizzle", "color", "texture")
    Case SHADER_DEBUG_TEXTURE2DARRAY_QUAD
        program_data_set pd, "Debug texture array quad program", "shaders/quad_texture2darray.vert", "shaders/quad_texture2darray.frag", _
            Array("transformationMatrix", "uvTransformMatrix", "swizzle", "color", "layer", "texture")
    Case SHADER_WORLD_TO_SCREEN
        program_data_set pd, "World to screen quad program", "shaders/world_to_screen.vert", "shaders/world_to_screen.frag", _
            Array("gamma")
    Case Else
        Err.Raise vbObjectError + 514, "shader_to_file_table", "map::at"
    End Select
End Sub

