Public Function gl_context_supportsMipLodBias() As Boolean
    If Not gles Then
        If GLAD_GL_VERSION_2_1 Then
            ' glTexParameterf(GL_TEXTURE_2D, GL_TEXTURE_LOD_BIAS, ...) should be available in OpenGL 3.0+ (OpenGL 3.3+?)
            ' But also can be supported by providing bias to texture() / texture2d() sampling call in shader (so just do that)
            gl_context_supportsMipLodBias = True
            Exit Function
        End If
        gl_context_supportsMipLodBias = False
    Else
        If GLAD_GL_ES_VERSION_2_0 Then
            ' Can support on OpenGL ES 2.0+
            ' By providing bias to texture() (OpenGL ES 3.0+) or texture2d() (OpenGL ES 2.0) sampling call in shader
            gl_context_supportsMipLodBias = True
            Exit Function
        End If
        gl_context_supportsMipLodBias = False
    End If
End Function

Public Function gl_context_supports2DTextureArrays() As Boolean
    gl_context_supports2DTextureArrays = has2DTextureArraySupport
End Function

Public Function gl_context_supportsIntVertexAttributes() As Boolean
    Dim hasRequiredVersion As Boolean, hasRequiredFunction As Boolean
    ' glVertexAttribIPointer requires: OpenGL 3.0+ or OpenGL ES 3.0+
    hasRequiredVersion = (Not gles And GLAD_GL_VERSION_3_0) Or (gles And GLAD_GL_ES_VERSION_3_0)
    hasRequiredFunction = glad_glVertexAttribIPointer <> 0
    gl_context_supportsIntVertexAttributes = hasRequiredVersion And hasRequiredFunction
End Function

