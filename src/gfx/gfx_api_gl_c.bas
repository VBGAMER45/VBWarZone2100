Public Function gl_context_textureFormatIsSupported(ByVal target As pixel_format_target, ByVal format As pixel_format, ByVal usage As pixel_format_usage) As Boolean
    Dim formatIdx As Long
    formatIdx = format
    If Not (formatIdx < textureFormatsSupport_size(target)) Then ASSERT_FAILURE "formatIdx < textureFormatsSupport[static_cast<size_t>(target)].size()", "lib/ivis_opengl/gfx_api_gl.cpp:4226", "textureFormatIsSupported", "Invalid format index: %zu", formatIdx: gl_context_textureFormatIsSupported = False: Exit Function
    gl_context_textureFormatIsSupported = (textureFormatsSupport(target, formatIdx) And usage) = usage
End Function

' Regular OpenGL / OpenGL ES implementation
Private Function getPixelFormatUsageSupport_gl(ByVal target As Long, ByVal format As pixel_format, ByVal gles_ As Boolean) As Long
    Dim retVal As Long, internal_format As Long, supported As Long, shader_image_load As Long, shader_image_store As Long
    Dim depth_renderable As Long, stencil_renderable As Long
    retVal = pixel_format_usage_none

    internal_format = to_gl_internalformat(format, gles_)
    If internal_format = GL_INVALID_ENUM Or internal_format = GL_FALSE Then
        getPixelFormatUsageSupport_gl = retVal
        Exit Function
    End If

    If gles_ Or Not GLAD_GL_ARB_internalformat_query2 Or glad_glGetInternalformativ = 0 Then
        ' Special cases:
        Select Case format
        ' ASTC:
        Case pixel_format_FORMAT_ASTC_4x4_UNORM
            '   - While WZ currently only supports ASTC on GLES, some desktop platforms support GLES *and* advertise ASTC support, but may encounter performance issues (in practice)
            '   - In OpenGL mode, glGetInternalformativ could be used to query "full support", but that functionality isn't currently available (and isn't even possible in OpenGL ES?)
            '   - So restrict this to specific platforms for now:
            '     - Android, Apple platforms (which should only advertise this if actually supported)
            getPixelFormatUsageSupport_gl = pixel_format_usage_none ' immediately return - not available
            Exit Function
        ' All other formats:
        Case Else
            ' the query function is not available, so just assume that the format is available
        End Select

        ' for now, mark it as available for sampled_image - TODO: investigate whether we can safely assume it's available for other usages
        retVal = retVal Or pixel_format_usage_sampled_image
        getPixelFormatUsageSupport_gl = retVal
        Exit Function
    End If

    supported = GL_FALSE
    glGetInternalformativ target, internal_format, GL_INTERNALFORMAT_SUPPORTED, 1, VarPtr(supported)
    If supported = 0 Then
        getPixelFormatUsageSupport_gl = retVal
        Exit Function
    End If

    supported = GL_NONE
    glGetInternalformativ target, internal_format, GL_FRAGMENT_TEXTURE, 1, VarPtr(supported)
    If supported = GL_FULL_SUPPORT Then ' ignore caveat support for now
        retVal = retVal Or pixel_format_usage_sampled_image
    End If

    shader_image_load = GL_NONE
    shader_image_store = GL_NONE
    glGetInternalformativ target, internal_format, GL_SHADER_IMAGE_LOAD, 1, VarPtr(shader_image_load)
    glGetInternalformativ target, internal_format, GL_SHADER_IMAGE_STORE, 1, VarPtr(shader_image_store)
    If shader_image_load = GL_FULL_SUPPORT And shader_image_store = GL_FULL_SUPPORT Then ' ignore caveat support for now
        retVal = retVal Or pixel_format_usage_storage_image
    End If

    depth_renderable = GL_FALSE
    stencil_renderable = GL_FALSE
    glGetInternalformativ target, internal_format, GL_DEPTH_RENDERABLE, 1, VarPtr(depth_renderable)
    glGetInternalformativ target, internal_format, GL_STENCIL_RENDERABLE, 1, VarPtr(stencil_renderable)
    If depth_renderable <> 0 And stencil_renderable <> 0 Then
        retVal = retVal Or pixel_format_usage_depth_stencil_attachment
    End If

    getPixelFormatUsageSupport_gl = retVal
End Function

' #define PIXEL_2D_FORMAT_SUPPORT_SET(x)
Private Sub PIXEL_2D_FORMAT_SUPPORT_SET(ByVal x As pixel_format)
    textureFormatsSupport(pixel_format_target_texture_2d, x) = getPixelFormatUsageSupport_gl(GL_TEXTURE_2D, x, gles)
End Sub

' #define PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET(x)
Private Sub PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET(ByVal x As pixel_format)
    If has2DTextureArraySupport Then textureFormatsSupport(pixel_format_target_texture_2d_array, x) = getPixelFormatUsageSupport_gl(GL_TEXTURE_2D_ARRAY, x, gles)
End Sub

Private Sub initPixelFormatsSupport()
    Dim target As Long, i As Long, canSupport2DTextureArrays As Boolean
    ' set any existing entries to false
    For target = 0 To PIXEL_FORMAT_TARGET_COUNT - 1
        For i = 0 To textureFormatsSupport_size(target) - 1
            textureFormatsSupport(target, i) = pixel_format_usage_none
        Next
        ' resize(static_cast<size_t>(gfx_api::MAX_PIXEL_FORMAT) + 1, gfx_api::pixel_format_usage::none)
        textureFormatsSupport_size(target) = MAX_PIXEL_FORMAT + 1
    Next

    ' check if 2D texture array support is available
    has2DTextureArraySupport = _
        (Not gles And (GLAD_GL_VERSION_3_0 Or GLAD_GL_EXT_texture_array)) _
        Or (gles And GLAD_GL_ES_VERSION_3_0) ' Texture arrays are supported in OpenGL ES 3.0+

    ' The following are always guaranteed to be supported
    PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA8_UNORM_PACK8
    PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_BGRA8_UNORM_PACK8
    PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB8_UNORM_PACK8
    PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_R8_UNORM

    PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA8_UNORM_PACK8
    PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_BGRA8_UNORM_PACK8
    PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB8_UNORM_PACK8
    PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_R8_UNORM

    ' RG8
    ' Desktop OpenGL: OpenGL 3.0+, or GL_ARB_texture_rg
    ' OpenGL ES: GL_EXT_texture_rg
    If (Not gles And (GLAD_GL_VERSION_3_0 Or GLAD_GL_ARB_texture_rg)) Or (gles And GLAD_GL_EXT_texture_rg) Then
        ' NOTES:
        ' GL_ARB_texture_rg (and OpenGL 3.0+) supports this format for glTex*Image3D
        ' GL_EXT_texture_rg does *NOT* specify support for glTex*Image3D?
        canSupport2DTextureArrays = (Not gles And (GLAD_GL_VERSION_3_0 Or GLAD_GL_ARB_texture_rg))

        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RG8_UNORM
        If canSupport2DTextureArrays Then
            PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RG8_UNORM
        End If
    End If

    ' S3TC
    ' Desktop OpenGL: GL_EXT_texture_compression_s3tc
    ' OpenGL ES: (May be supported by the same GL_EXT_texture_compression_s3tc, other extensions)
    If GLAD_GL_EXT_texture_compression_s3tc Then
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB_BC1_UNORM ' DXT1
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA_BC2_UNORM ' DXT3
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA_BC3_UNORM ' DXT5
        ' NOTES:
        ' On Desktop OpenGL, the EXT_texture_array extension interacts with the s3tc extension to provide 2d texture array support for these formats
        ' The EXT_texture_compression_s3tc docs appear to say that OpenGL ES 3.0.2(?)+ supports passing these formats to glCompressedTex*Image3D for TEXTURE_2D_ARRAY support
        If (Not gles And (GLAD_GL_VERSION_3_0 Or GLAD_GL_EXT_texture_array)) _
           Or (gles And GLAD_GL_ES_VERSION_3_0) Then
            PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB_BC1_UNORM ' DXT1
            PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA_BC2_UNORM ' DXT3
            PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA_BC3_UNORM ' DXT5
        End If
    ElseIf gles Then
        If GLAD_GL_ANGLE_texture_compression_dxt3 Then
            textureFormatsSupport(pixel_format_target_texture_2d, pixel_format_FORMAT_RGBA_BC2_UNORM) = pixel_format_usage_sampled_image
        End If
        If GLAD_GL_ANGLE_texture_compression_dxt5 Then
            textureFormatsSupport(pixel_format_target_texture_2d, pixel_format_FORMAT_RGBA_BC3_UNORM) = pixel_format_usage_sampled_image
        End If
        If (GLAD_GL_ANGLE_texture_compression_dxt3 Or GLAD_GL_ANGLE_texture_compression_dxt5) And GLAD_GL_EXT_texture_compression_dxt1 Then
            PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB_BC1_UNORM ' DXT1
        End If
    End If

    ' RGTC
    ' Desktop OpenGL: GL_ARB_texture_compression_rgtc (or OpenGL 3.0+ Core?)
    ' OpenGL ES: TODO: Could check for GL_EXT_texture_compression_rgtc, but support seems rare
    If Not gles And GLAD_GL_ARB_texture_compression_rgtc Then
        ' Note: GL_ARB_texture_compression_rgtc does *NOT* support glCompressedTex*Image3D (even for 2d texture arrays)?
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_R_BC4_UNORM
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RG_BC5_UNORM
    End If

    ' BPTC
    ' Desktop OpenGL: GL_ARB_texture_compression_bptc
    ' OpenGL ES: GL_EXT_texture_compression_bptc
    If (Not gles And GLAD_GL_ARB_texture_compression_bptc) Or (gles And GLAD_GL_EXT_texture_compression_bptc) Then
        ' NOTES:
        ' GL_ARB_texture_compression_bptc claims it is supported in glCompressedTex*Image2DARB, glCompressedTex*Image3DARB, but these were folded into core without the ARB suffix in OpenGL 1.3?)
        ' GL_EXT_texture_compression_bptc claims it is supported in glCompressedTex*Image2D, glCompressedTex*Image3D
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA_BPTC_UNORM
        PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA_BPTC_UNORM
    End If

    ' ETC1
    If gles And GLAD_GL_OES_compressed_ETC1_RGB8_texture Then
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB8_ETC1
    End If

    ' ETC2
    ' Desktop OpenGL: Mandatory in OpenGL 4.3+, or with GL_ARB_ES3_compatibility
    '   - NOTES:
    '       - Desktop OpenGL (especially 4.3+ where it's required) may claim support for ETC2/EAC,
    '         but may actually not have hardware support (so it'll just decompress in memory)
    '       - While theoretically the checks in getPixelFormatUsageSupport_gl should detect this,
    '         it seems GL_FULL_SUPPORT is sometimes returned instead of GL_CAVEAT_SUPPORT (even when
    '         there is no hardware support and the textures are decompressed by the driver in software)
    '       - To handle this, really restrict when it's permitted on desktop - only permit if S3TC is *not* supported
    ' OpenGL ES: Mandatory in OpenGL ES 3.0+
    ' IMPORTANT: **MUST** come after S3TC/DXT & RGTC is checked !!
    If (gles And GLAD_GL_ES_VERSION_3_0) Or (Not gles And GLAD_GL_ARB_ES3_compatibility) Then
        ' NOTES:
        ' OpenGL ES 3.0+ claims it is supported for 2d texture arrays
        ' GL_ARB_ES3_compatibility makes no claims about support in glCompressedTex*Image3D?
        canSupport2DTextureArrays = (gles And GLAD_GL_ES_VERSION_3_0)

        If gles Or Not gl_context_textureFormatIsSupported(pixel_format_target_texture_2d, pixel_format_FORMAT_RGB_BC1_UNORM, pixel_format_usage_sampled_image) Then
            PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB8_ETC2
            If canSupport2DTextureArrays Then
                PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGB8_ETC2
            End If
        End If
        If gles Or Not gl_context_textureFormatIsSupported(pixel_format_target_texture_2d, pixel_format_FORMAT_RGBA_BC3_UNORM, pixel_format_usage_sampled_image) Then
            PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA8_ETC2_EAC
            If canSupport2DTextureArrays Then
                PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RGBA8_ETC2_EAC
            End If
        End If
        If gles Or Not gl_context_textureFormatIsSupported(pixel_format_target_texture_2d, pixel_format_FORMAT_R_BC4_UNORM, pixel_format_usage_sampled_image) Then
            PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_R11_EAC
            If canSupport2DTextureArrays Then
                PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_R11_EAC
            End If
        End If
        If gles Or Not gl_context_textureFormatIsSupported(pixel_format_target_texture_2d, pixel_format_FORMAT_RG_BC5_UNORM, pixel_format_usage_sampled_image) Then
            PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_RG11_EAC
            If canSupport2DTextureArrays Then
                PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_RG11_EAC
            End If
        End If
    End If

    ' ASTC (LDR)
    ' Either OpenGL: GL_KHR_texture_compression_astc_ldr
    ' However, for now - until more testing is complete - only enable on OpenGL ES
    If gles And GLAD_GL_KHR_texture_compression_astc_ldr Then
        ' NOTE: GL_KHR_texture_compression_astc_ldr claims it is supported in glCompressedTex*Image3D
        PIXEL_2D_FORMAT_SUPPORT_SET pixel_format_FORMAT_ASTC_4x4_UNORM
        PIXEL_2D_TEXTURE_ARRAY_FORMAT_SUPPORT_SET pixel_format_FORMAT_ASTC_4x4_UNORM
    End If

    ' Determine multiSampledBufferInternalFormat
    If Not gles Then
        ' OpenGL
        ' - Required formats for render buffer include: GL_RGB10_A2, GL_RGBA8
        ' - Notably: GL_RGB8 is *not* a required format, so support may vary
        multiSampledBufferInternalFormat = GL_RGBA8
        multiSampledBufferBaseFormat = GL_RGBA
        maxMultiSampleBufferFormatSamples = 0
        glGetIntegerv GL_MAX_SAMPLES, VarPtr(maxMultiSampleBufferFormatSamples)
        If GLAD_GL_ARB_internalformat_query2 And glad_glGetInternalformativ <> 0 Then
            glGetInternalformativ GL_RENDERBUFFER, multiSampledBufferInternalFormat, GL_SAMPLES, 1, VarPtr(maxMultiSampleBufferFormatSamples)
        End If
    Else
        ' OpenGL ES (3.0+)
        ' - Required formats for render buffer include: GL_RGB10_A2, GL_RGBA8
        ' - Notably: GL_RGB8 is *not* a required format, so support may vary
        multiSampledBufferInternalFormat = GL_RGBA8
        multiSampledBufferBaseFormat = GL_RGBA
        maxMultiSampleBufferFormatSamples = 0
        glGetInternalformativ GL_RENDERBUFFER, multiSampledBufferInternalFormat, GL_SAMPLES, 1, VarPtr(maxMultiSampleBufferFormatSamples)
    End If

    ' Cap maxMultiSampleBufferFormatSamples at 16 (some drivers report supporting 32 but then crash)
    If maxMultiSampleBufferFormatSamples > 16 Then maxMultiSampleBufferFormatSamples = 16
    If maxMultiSampleBufferFormatSamples < 0 Then maxMultiSampleBufferFormatSamples = 0
End Sub

Private Function initInstancedFunctions() As Boolean
    wz_dyn_glDrawArraysInstanced = 0
    wz_dyn_glDrawElementsInstanced = 0
    wz_dyn_glVertexAttribDivisor = 0

    If Not gles Then
        If GLAD_GL_VERSION_3_1 Then
            wz_dyn_glDrawArraysInstanced = glad_glDrawArraysInstanced
            wz_dyn_glDrawElementsInstanced = glad_glDrawElementsInstanced
        ElseIf GLAD_GL_ARB_draw_instanced Then
            wz_dyn_glDrawArraysInstanced = glad_glDrawArraysInstancedARB
            wz_dyn_glDrawElementsInstanced = glad_glDrawElementsInstancedARB
        End If

        If GLAD_GL_VERSION_3_3 Then
            wz_dyn_glVertexAttribDivisor = glad_glVertexAttribDivisor
        ElseIf GLAD_GL_ARB_instanced_arrays Then
            wz_dyn_glVertexAttribDivisor = glad_glVertexAttribDivisorARB
        End If
    Else
        If GLAD_GL_ES_VERSION_3_0 Then
            wz_dyn_glDrawArraysInstanced = glad_glDrawArraysInstanced
            wz_dyn_glDrawElementsInstanced = glad_glDrawElementsInstanced
            wz_dyn_glVertexAttribDivisor = glad_glVertexAttribDivisor
        ElseIf GLAD_GL_EXT_instanced_arrays Then
            wz_dyn_glDrawArraysInstanced = glad_glDrawArraysInstancedEXT
            wz_dyn_glDrawElementsInstanced = glad_glDrawElementsInstancedEXT
            wz_dyn_glVertexAttribDivisor = glad_glVertexAttribDivisorEXT
        ElseIf GLAD_GL_ANGLE_instanced_arrays Then
            wz_dyn_glDrawArraysInstanced = glad_glDrawArraysInstancedANGLE
            wz_dyn_glDrawElementsInstanced = glad_glDrawElementsInstancedANGLE
            wz_dyn_glVertexAttribDivisor = glad_glVertexAttribDivisorANGLE
        End If
    End If

    If wz_dyn_glDrawArraysInstanced = 0 Or wz_dyn_glDrawElementsInstanced = 0 Or wz_dyn_glVertexAttribDivisor = 0 Then
        wz_dyn_glDrawArraysInstanced = 0
        wz_dyn_glDrawElementsInstanced = 0
        wz_dyn_glVertexAttribDivisor = 0
        initInstancedFunctions = False
        Exit Function
    End If
    initInstancedFunctions = True
End Function

Private Function initCheckBorderClampSupport() As Boolean
    ' GL_CLAMP_TO_BORDER is supported on:
    ' - OpenGL (any version we support)
    If Not gles Then
        initCheckBorderClampSupport = True
    ' - OpenGL ES (3.2+, or with extensions)
    Else
        initCheckBorderClampSupport = GLAD_GL_ES_VERSION_3_2 Or GLAD_GL_EXT_texture_border_clamp Or GLAD_GL_OES_texture_border_clamp Or GLAD_GL_NV_texture_border_clamp
    End If
End Function

Public Sub gl_context_handleWindowSizeChange(ByVal oldWidth As Long, ByVal oldHeight As Long, ByVal newWidth As Long, ByVal newHeight As Long)
    Dim drawableWidth As Long, drawableHeight As Long, width As Long, height As Long
    Dim newSceneFramebufferWidth As Long, newSceneFramebufferHeight As Long
    ' Update the viewport to use the new *drawable* size (which may be greater than the new window size
    ' if SDL's built-in high-DPI support is enabled and functioning).
    drawableWidth = 0: drawableHeight = 0
    backend_impl.getDrawableSize drawableWidth, drawableHeight
    debug_ 4786, LOG_WZ, "handleWindowSizeChange", "Logical Size: %d x %d; Drawable Size: %d x %d", screenWidth, screenHeight, drawableWidth, drawableHeight

    If drawableWidth > 0 Then width = drawableWidth Else width = 0
    If drawableHeight > 0 Then height = drawableHeight Else height = 0

    glViewport 0, 0, width, height
    viewportWidth = width
    viewportHeight = height
    glCullFace GL_FRONT
    '   glEnable(GL_CULL_FACE);

    ' Re-create scene FBOs using new size (if drawable size is of reasonable dimensions)
    If viewportWidth > 0 And viewportHeight > 0 Then
        If viewportWidth > 2 Then newSceneFramebufferWidth = viewportWidth Else newSceneFramebufferWidth = 2
        If viewportHeight > 2 Then newSceneFramebufferHeight = viewportHeight Else newSceneFramebufferHeight = 2

        If sceneFramebufferWidth <> newSceneFramebufferWidth Or sceneFramebufferHeight <> newSceneFramebufferHeight Then
            sceneFramebufferWidth = newSceneFramebufferWidth
            sceneFramebufferHeight = newSceneFramebufferHeight
            createSceneRenderpass
        End If
    Else
        ' Some drivers seem to like to occasionally return a drawableSize that has a 0 dimension (ex. when minimized?)
        ' In this case, don't bother recreating the scene framebuffer (until it changes to something sensible)
        debug_ 4814, LOG_INFO, "handleWindowSizeChange", "Delaying scene framebuffer recreation (current Drawable Size: %d x %d)", drawableWidth, drawableHeight
    End If
End Sub

' std::pair<uint32_t, uint32_t>: (w, h)
Public Sub gl_context_getDrawableDimensions(w As Long, h As Long)
    w = viewportWidth
    h = viewportHeight
End Sub

Public Function gl_context_isYAxisInverted() As Boolean
    gl_context_isYAxisInverted = False
End Function

Public Function gl_context_shouldDraw() As Boolean
    gl_context_shouldDraw = viewportWidth > 0 And viewportHeight > 0
End Function

Public Sub gl_context_shutdown()
    Dim i As Long
    If glad_glClear <> 0 Then
        glClear GL_COLOR_BUFFER_BIT Or GL_DEPTH_BUFFER_BIT Or GL_STENCIL_BUFFER_BIT
    End If

    deleteSceneRenderpass

    If glad_glDeleteFramebuffers <> 0 Then
        If depthFBO_size > 0 Then
            glDeleteFramebuffers depthFBO_size, VarPtr(depthFBO(0))
            Erase depthFBO
            depthFBO_size = 0
        End If
    End If

    If Not depthTexture Is Nothing Then
        Set depthTexture = Nothing
    End If

    If Not pDefaultTexture Is Nothing Then
        Set pDefaultTexture = Nothing
    End If

    If Not pDefaultArrayTexture Is Nothing Then
        Set pDefaultArrayTexture = Nothing
    End If

    If Not pDefaultDepthTexture Is Nothing Then
        Set pDefaultDepthTexture = Nothing
    End If

    If glad_glDeleteBuffers <> 0 Then ' glDeleteBuffers might be NULL (if initializing the OpenGL loader library fails)
        glDeleteBuffers 1, VarPtr(scratchbuffer)
        scratchbuffer = 0
    End If

    If GLAD_GL_ARB_timer_query And glad_glDeleteQueries <> 0 Then
        glDeleteQueries PERF_COUNT, VarPtr(perfpos(0))
    End If

    If GLAD_GL_VERSION_3_0 Then ' if context is OpenGL 3.0+
        ' Cleanup from very simple VAO code (just bind a single global VAO)
        If vaoId <> 0 Then
            If glad_glDeleteVertexArrays <> 0 Then
                glDeleteVertexArrays 1, VarPtr(vaoId)
            End If
            vaoId = 0
        End If
    End If

    Set current_program = Nothing
    For i = 0 To createdPipelines_size - 1
        If Not createdPipelines_pso(i) Is Nothing Then
            Set createdPipelines_pso(i) = Nothing
        End If
    Next
    Erase createdPipelines_pso
    Erase createdPipelines_createInfo
    createdPipelines_size = 0

    If Not backend_impl Is Nothing Then
        backend_impl.destroyGLContext
    End If
End Sub

