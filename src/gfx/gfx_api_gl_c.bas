Public Function gl_context_getFormattedRendererInfoString() As String
    gl_context_getFormattedRendererInfoString = formattedRendererInfoString
End Function

Private Function calculateFormattedRendererInfoString() As String
    Dim openGLVersionStr As String, gl_majorversion As Long, gl_minorversion As Long
    Dim major As Long, minor As Long, version As String, prefixes As Variant, i As Long
    Dim formattedStr As String, pRendererStr As Long
    gl_majorversion = wz_GetGLIntegerv(GL_MAJOR_VERSION, 0)
    gl_minorversion = wz_GetGLIntegerv(GL_MINOR_VERSION, 0)
    If gl_majorversion > 0 Then
        openGLVersionStr = CStr(gl_majorversion) & "." & CStr(gl_minorversion)
    Else
        ' Failed to retrieve OpenGL version from GL_MAJOR_VERSION / GL_MINOR_VERSION
        ' Likely < OpenGL 3.0
        ' Extract version from GL_VERSION

        major = 0: minor = 0

        prefixes = Array("OpenGL ES-CM ", "OpenGL ES-CL ", "OpenGL ES ")

        version = gl_cstr(glGetString(GL_VERSION))
        If glGetString(GL_VERSION) <> 0 Then
            For i = 0 To UBound(prefixes)
                If Left$(version, Len(prefixes(i))) = prefixes(i) Then
                    version = Mid$(version, Len(prefixes(i)) + 1)
                    Exit For
                End If
            Next

            sscanf version, "%d.%d", major, minor

            openGLVersionStr = CStr(major) & "." & CStr(minor)
        Else
            openGLVersionStr = "<unknown version>"
        End If
    End If
    formattedStr = "OpenGL "
    If gles Then
        formattedStr = formattedStr & "ES "
    End If
    formattedStr = formattedStr & openGLVersionStr
    pRendererStr = glGetString(GL_RENDERER)
    If pRendererStr <> 0 Then
        formattedStr = formattedStr & " (" & gl_cstr(pRendererStr) & ")"
    End If

    calculateFormattedRendererInfoString = formattedStr
End Function

' (VB) the callback's std::unique_ptr<iV_Image> is returned in image
Public Function gl_context_getScreenshot(image As iV_Image) As Boolean
    Dim m_viewport(0 To 3) As Long, width As Long, height As Long, allocateResult As Boolean
    Set image = Nothing

    ' IMPORTANT: Must get the size of the viewport directly from the viewport, to account for
    '            high-DPI / display scaling factors (or only a sub-rect of the full viewport
    '            will be captured, as the logical screenWidth/Height may differ from the
    '            underlying viewport pixel dimensions).
    glGetIntegerv GL_VIEWPORT, VarPtr(m_viewport(0))

    If m_viewport(2) = 0 Or m_viewport(3) = 0 Then
        ' Failed to get useful / non-0 viewport size
        debug_ 3303, LOG_3D, "getScreenshot", "GL_VIEWPORT either failed or returned an invalid size"
        gl_context_getScreenshot = False
        Exit Function
    End If

    Set image = New iV_Image
    width = m_viewport(2)
    height = m_viewport(3)
    allocateResult = image.allocate(width, height, channelsPerPixel) ' RGB
    If Not (allocateResult) Then ASSERT_FAILURE "allocateResult", "lib/ivis_opengl/gfx_api_gl.cpp:3311", "getScreenshot", "Failed to allocate buffer": Set image = Nothing: gl_context_getScreenshot = False: Exit Function

    glPixelStorei GL_PACK_ALIGNMENT, 1
    glReadPixels 0, 0, image.width(), image.height(), GL_RGB, GL_UNSIGNED_BYTE, image.bmp_w()

    ' callback(std::move(image)): the caller's

    gl_context_getScreenshot = True
End Function

' MARK: khr_callback

Private Function cbsource(ByVal source As Long) As String
    Select Case source
    Case GL_DEBUG_SOURCE_API: cbsource = "API"
    Case GL_DEBUG_SOURCE_WINDOW_SYSTEM: cbsource = "WM"
    Case GL_DEBUG_SOURCE_SHADER_COMPILER: cbsource = "SC"
    Case GL_DEBUG_SOURCE_THIRD_PARTY: cbsource = "3P"
    Case GL_DEBUG_SOURCE_APPLICATION: cbsource = "WZ"
    Case Else: cbsource = "OTHER"           ' default: case GL_DEBUG_SOURCE_OTHER
    End Select
End Function

Private Function cbtype(ByVal type_ As Long) As String
    Select Case type_
    Case GL_DEBUG_TYPE_ERROR: cbtype = "Error"
    Case GL_DEBUG_TYPE_DEPRECATED_BEHAVIOR: cbtype = "Deprecated"
    Case GL_DEBUG_TYPE_UNDEFINED_BEHAVIOR: cbtype = "Undefined"
    Case GL_DEBUG_TYPE_PORTABILITY: cbtype = "Portability"
    Case GL_DEBUG_TYPE_PERFORMANCE: cbtype = "Performance"
    Case GL_DEBUG_TYPE_MARKER: cbtype = "Marker"
    Case Else: cbtype = "Other"             ' default: case GL_DEBUG_TYPE_OTHER
    End Select
End Function

Private Function cbseverity(ByVal severity As Long) As String
    Select Case severity
    Case GL_DEBUG_SEVERITY_HIGH: cbseverity = "High"
    Case GL_DEBUG_SEVERITY_MEDIUM: cbseverity = "Medium"
    Case GL_DEBUG_SEVERITY_LOW: cbseverity = "Low"
    Case GL_DEBUG_SEVERITY_NOTIFICATION: cbseverity = "Notification"
    Case Else: cbseverity = "Other"
    End Select
End Function

' static void GLAPIENTRY khr_callback(GLenum source, GLenum type, GLuint id, GLenum severity, GLsizei length, const GLchar *message, const void *userParam)
' (a stdcall callback: AddressOf; it must not raise a VB error)
Private Sub khr_callback(ByVal source As Long, ByVal type_ As Long, ByVal id As Long, ByVal severity As Long, ByVal length As Long, ByVal message As Long, ByVal userParam As Long)
    Dim log_level As code_part, msg As String
    On Error Resume Next
    ' (void)userParam; // we pass in NULL here
    ' (void)length; // length of message, buggy on some drivers, don't use
    ' (void)id; // message id
    log_level = LOG_INFO
    If message <> 0 Then msg = gl_cstr(message)
    If type_ = GL_DEBUG_TYPE_ERROR Then
        If severity = GL_DEBUG_SEVERITY_HIGH Then
            log_level = LOG_ERROR

            ' detect OUT_OF_MEMORY errors, set flag
            If message <> 0 Then
                ' containsSubstringPreprocessed(message, std::min<size_t>(length, strnlen(message, length)), OOM_GL_ERROR_SEARCH_STRING)
                If InStr(1, Left$(msg, IIf(length < Len(msg), length, Len(msg))), "GL_OUT_OF_MEMORY", vbBinaryCompare) > 0 Then
                    khrCallbackOomDetected = True
                End If
            End If
        End If
    End If
    If debugPartEnabled(log_level) Then debugFromGfxCallback_ 3386, log_level, "khr_callback", "GL::%s(%s:%s) : %s", cbsource(source), cbtype(type_), cbseverity(severity), msg
End Sub

Private Function getSuggestedDefaultDepthBufferResolution() As Long
    Dim total_graphics_mem_kb As Long, openGL_renderer As String
    ' Use a (very simple) heuristic, that may or may not be useful - but basically try to find graphics cards that have lots of memory...
    If GLAD_GL_NVX_gpu_memory_info Then
        ' If GL_NVX_gpu_memory_info is available, get the total dedicated graphics memory
        total_graphics_mem_kb = 0
        glGetIntegerv GL_GPU_MEMORY_INFO_DEDICATED_VIDMEM_NVX, VarPtr(total_graphics_mem_kb)
        debug_ 3400, LOG_3D, "getSuggestedDefaultDepthBufferResolution", "GL_GPU_MEMORY_INFO_DEDICATED_VIDMEM_NVX: %d", total_graphics_mem_kb

        If (total_graphics_mem_kb \ 1024) >= 8192 Then ' If >= 8 GiB graphics memory
            getSuggestedDefaultDepthBufferResolution = 4096
            Exit Function
        Else
            getSuggestedDefaultDepthBufferResolution = 2048
            Exit Function
        End If
    End If

    ' don't currently have a good way of checking video memory on this system
    ' check some specific GL_RENDERER values...
    openGL_renderer = wzSafeGlGetString(GL_RENDERER)
    If Left$(openGL_renderer, Len("Intel(R) HD Graphics")) = "Intel(R) HD Graphics" Then
        ' always default to 2048 on Intel HD Graphics...
        getSuggestedDefaultDepthBufferResolution = 2048
        Exit Function
    End If

    ' In all other cases, default to 2048 for better performance by default
    getSuggestedDefaultDepthBufferResolution = 2048
End Function

' _initialize: impl stands for the backend_Impl_Factory: the IGLBackend itself
Public Function gl_context_initialize_(ByVal impl As Object, ByVal antialiasing As Long, ByVal mode As swap_interval_mode, ByVal has_mipLodBias_ As Boolean, ByVal mipLodBias_ As Single, ByVal depthMapResolution_ As Long) As Boolean
    Dim width As Long, height As Long
    ' new gl_context(uses_gfx_debug)
    gl_context_construct uses_gfx_debug

    khrCallbackOomDetected = False

    ' obtain backend_OpenGL_Impl from impl
    If Not impl Is Nothing Then
        If TypeOf impl Is IGLBackend Then Set backend_impl = impl
    End If
    If backend_impl Is Nothing Then
        debug_ 3460, LOG_ERROR, "_initialize", "Failed to get OpenGL backend implementation"
        gl_context_initialize_ = False
        Exit Function
    End If

    If Not backend_impl.createGLContext() Then
        debug_ 3466, LOG_ERROR, "_initialize", "Failed to create OpenGL context"
        gl_context_initialize_ = False
        Exit Function
    End If

    If Not initGLContext() Then
        backend_impl.destroyGLContext
        gl_context_initialize_ = False
        Exit Function
    End If

    If antialiasing > 0 Then multisamples = antialiasing Else multisamples = 0

    initPixelFormatsSupport
    hasInstancedRenderingSupport = initInstancedFunctions()
    debug_ 3480, LOG_INFO, "_initialize", "  * Instanced rendering support %s detected", IIf(hasInstancedRenderingSupport, "was", "was NOT")
    hasBorderClampSupport = initCheckBorderClampSupport()

    height = 0
    backend_impl.getDrawableSize width, height
    debug_ 3485, LOG_WZ, "_initialize", "Drawable Size: %d x %d", width, height
    If width < 0 Then width = 0
    If height < 0 Then height = 0

    wzGLClearErrors_

    glViewport 0, 0, width, height
    wzGLCheckErrors_ 3492, "_initialize"
    viewportWidth = width
    viewportHeight = height
    glCullFace GL_FRONT
    '   glEnable(GL_CULL_FACE);
    wzGLCheckErrors_ 3497, "_initialize"

    If viewportWidth > 2 Then sceneFramebufferWidth = viewportWidth Else sceneFramebufferWidth = 2
    If viewportHeight > 2 Then sceneFramebufferHeight = viewportHeight Else sceneFramebufferHeight = 2

    ' initialize default (0) textures
    If Not createDefaultTextures() Then
        ' Failed initializing one or more default textures
        gl_context_shutdown
        wzResetGfxSettingsOnFailure ' reset certain settings (like MSAA) that could be contributing to OUT_OF_MEMORY (or other) errors
        gl_context_initialize_ = False
        Exit Function
    End If

    If Not setSwapIntervalInternal(mode) Then
        ' default to vsync on
        debug_ 3514, LOG_3D, "_initialize", "Failed to set swap interval: %d; defaulting to vsync on", CLng(mode)
        setSwapIntervalInternal swap_interval_mode_vsync
    End If

    ctx_has_mipLodBias = has_mipLodBias_
    ctx_mipLodBias = mipLodBias_
    depthBufferResolution = depthMapResolution_
    If depthBufferResolution = 0 Then
        depthBufferResolution = getSuggestedDefaultDepthBufferResolution()
    End If

    If Not createSceneRenderpass() Then
        ' Treat failure to create the scene render pass as a fatal error
        gl_context_shutdown
        wzResetGfxSettingsOnFailure ' reset certain settings (like MSAA) that could be contributing to OUT_OF_MEMORY (or other) errors
        gl_context_initialize_ = False
        Exit Function
    End If
    initDepthPasses depthBufferResolution

    glBindFramebuffer GL_FRAMEBUFFER, 0

    If Not gles And GLAD_GL_VERSION_3_0 Then
        glDisable GL_FRAMEBUFFER_SRGB
        wzGLCheckErrors_ 3540, "_initialize"
    End If

    beginRenderPassImpl_

    gl_context_initialize_ = True
End Function

Private Function createDefaultTextures() As Boolean
    Const defaultTexture_width As Long = 2
    Const defaultTexture_height As Long = 2
    Dim defaultTexture As iV_Image

    wzGLClearErrors_ ' clear OpenGL error states

    ' initialize default (0) textures
    Set pDefaultTexture = gl_context_create_texture(1, defaultTexture_width, defaultTexture_height, pixel_format_FORMAT_RGBA8_UNORM_PACK8, "<default_texture>")
    If Not wzGLCheckErrors_(3559, "createDefaultTextures") Then createDefaultTextures = False: Exit Function
    Set pDefaultArrayTexture = gl_context_create_texture_array(1, 1, defaultTexture_width, defaultTexture_height, pixel_format_FORMAT_RGBA8_UNORM_PACK8, "<default_array_texture>")
    If Not wzGLCheckErrors_(3561, "createDefaultTextures") Then createDefaultTextures = False: Exit Function
    Set pDefaultDepthTexture = create_depthmap_texture(WZ_MAX_SHADOW_CASCADES, 2, 2, "<default_depth_map>")
    If Not wzGLCheckErrors_(3563, "createDefaultTextures") Then createDefaultTextures = False: Exit Function
    If pDefaultDepthTexture Is Nothing Then
        debug_ 3566, LOG_INFO, "createDefaultTextures", "Failed to create default depth texture??"
    End If

    Set defaultTexture = New iV_Image
    defaultTexture.allocate defaultTexture_width, defaultTexture_height, 4, True
    If Not pDefaultTexture.upload(0, defaultTexture) Then
        debug_ 3573, LOG_ERROR, "createDefaultTextures", "Failed to upload default texture??"
    End If
    If Not wzGLCheckErrors_(3575, "createDefaultTextures") Then createDefaultTextures = False: Exit Function
    If Not pDefaultArrayTexture.upload_layer(0, 0, defaultTexture) Then
        debug_ 3578, LOG_ERROR, "createDefaultTextures", "Failed to upload default array texture??"
    End If
    If Not wzGLCheckErrors_(3580, "createDefaultTextures") Then createDefaultTextures = False: Exit Function
    pDefaultArrayTexture.flush
    If Not wzGLCheckErrors_(3582, "createDefaultTextures") Then createDefaultTextures = False: Exit Function

    createDefaultTextures = True
End Function

' static const GLubyte* wzSafeGlGetString(GLenum name): the string ("" for nullptr)
Private Function wzSafeGlGetString(ByVal name_ As Long) As String
    If Not (glad_glGetString <> 0) Then ASSERT_FAILURE "glGetString != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:3591", "wzSafeGlGetString", "glGetString is null": wzSafeGlGetString = "": Exit Function
    wzSafeGlGetString = gl_cstr(glGetString(name_))
End Function

Private Function isBlocklistedGraphicsDriver() As Boolean
    Dim openGL_renderer As String, openGL_version As String, openGL_vendor As String
    openGL_renderer = wzSafeGlGetString(GL_RENDERER)
    openGL_version = wzSafeGlGetString(GL_VERSION)

    debug_ 3606, LOG_3D, "isBlocklistedGraphicsDriver", "Checking: Renderer: ""%s"", Version: ""%s""", openGL_renderer, openGL_version

    ' Renderer: Intel(R) HD Graphics 4000
    If openGL_renderer = "Intel(R) HD Graphics 4000" Then
        ' Version: 3.1.0 - Build 10.18.10.3304
        ' Version: <opengl version> - Build 10.18.10.3304
        ' This is a problematic old driver on Windows that just crashes after init.
        If strEndsWith(openGL_version, "Build 10.18.10.3304") Then
            isBlocklistedGraphicsDriver = True
            Exit Function
        End If

        ' Version: 3.1.0 - Build 9.17.10.2843
        ' Version: <opengl version> - Build 9.17.10.2843
        ' This is a problematic old driver (seen on Windows 8) that likes to crash during gameplay or sometimes at init.
        If strEndsWith(openGL_version, "Build 9.17.10.2843") Then
            isBlocklistedGraphicsDriver = True
            Exit Function
        End If
    End If

    ' Renderer: Intel(R) HD Graphics
    If openGL_renderer = "Intel(R) HD Graphics" Then
        ' Version: 3.1.0 - Build 10.18.10.3277
        ' Version: <opengl version> - Build 10.18.10.3277
        ' This is a problematic old driver on Windows that likes to crash during gameplay (and throw various errors about the shaders).
        If strEndsWith(openGL_version, "Build 10.18.10.3277") Then
            isBlocklistedGraphicsDriver = True
            Exit Function
        End If
    End If

    ' Renderer: Intel(R) Graphics Media Accelerator 3600 Series
    If openGL_renderer = "Intel(R) Graphics Media Accelerator 3600 Series" Then
        ' Does not work with WZ. (No indications that there is a driver version that does not crash.)
        isBlocklistedGraphicsDriver = True
        Exit Function
    End If

    ' Renderer: softpipe
    ' (From the OpenGLOn12 / "OpenGL Compatibility Pack")
    If openGL_renderer = "softpipe" Then
        openGL_vendor = wzSafeGlGetString(GL_VENDOR)
        If openGL_vendor = "Mesa" Then
            ' Does not work performantly, can cause crashes (as of "Mesa 24.2.0-devel (git-57f4f8520a)")
            ' Since libANGLE is very likely to work better, reject this (for now)
            isBlocklistedGraphicsDriver = True
            Exit Function
        End If
    End If

    isBlocklistedGraphicsDriver = False
End Function

Private Function enableDebugMessageCallbacks() As Boolean
    If Not useKHRSuffixedDebugFuncs() Then
        If glad_glDebugMessageCallback <> 0 And glad_glDebugMessageControl <> 0 Then
            glDebugMessageCallback AddressOf khr_callback, 0
            wzGLCheckErrors_ 3674, "enableDebugMessageCallbacks"
            glEnable GL_DEBUG_OUTPUT
            wzGLCheckErrors_ 3676, "enableDebugMessageCallbacks"
            glEnable GL_DEBUG_OUTPUT_SYNCHRONOUS ' (VB) the callback must run on this thread
            ' Do not want to output notifications. Some drivers spam them too much.
            glDebugMessageControl GL_DONT_CARE, GL_DONT_CARE, GL_DEBUG_SEVERITY_NOTIFICATION, 0, 0, GL_FALSE
            wzGLCheckErrors_ 3679, "enableDebugMessageCallbacks"
            debug_ 3680, LOG_3D, "enableDebugMessageCallbacks", "Enabling KHR_debug message callback"
            enableDebugMessageCallbacks = True
            Exit Function
        Else
            debug_ 3685, LOG_3D, "enableDebugMessageCallbacks", "Failed to enable KHR_debug message callback"
        End If
    Else
        If glad_glDebugMessageCallbackKHR <> 0 And glad_glDebugMessageControlKHR <> 0 Then
            glDebugMessageCallbackKHR AddressOf khr_callback, 0
            wzGLCheckErrors_ 3693, "enableDebugMessageCallbacks"
            glEnable GL_DEBUG_OUTPUT_KHR
            wzGLCheckErrors_ 3695, "enableDebugMessageCallbacks"
            glEnable GL_DEBUG_OUTPUT_SYNCHRONOUS ' (VB) the callback must run on this thread
            ' Do not want to output notifications. Some drivers spam them too much.
            glDebugMessageControlKHR GL_DONT_CARE, GL_DONT_CARE, GL_DEBUG_SEVERITY_NOTIFICATION_KHR, 0, 0, GL_FALSE
            wzGLCheckErrors_ 3698, "enableDebugMessageCallbacks"
            debug_ 3699, LOG_3D, "enableDebugMessageCallbacks", "Enabling KHR_debug message callback"
            enableDebugMessageCallbacks = True
            Exit Function
        Else
            debug_ 3704, LOG_3D, "enableDebugMessageCallbacks", "Failed to enable KHR_debug message callback"
        End If
    End If

    enableDebugMessageCallbacks = False
End Function

' (gl_pipeline_state_object calls it: friend struct gl_pipeline_state_object)
Public Sub gl_context_wzGLObjectLabel(ByVal identifier As Long, ByVal name_ As Long, ByVal length As Long, ByVal label As String)
    wzGLObjectLabel identifier, name_, length, label
