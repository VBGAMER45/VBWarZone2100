' (VB) gl_context(bool _debug) : khr_debug(_debug) and the members' initialisers, as
' gfx_api::context::initialize's new gl_context(...) runs them
Private Sub gl_context_construct(ByVal debug__ As Boolean)
    Dim i As Long, j As Long
    Set backend_impl = Nothing
    Set current_program = Nothing
    scratchbuffer = 0
    scratchbuffer_size = 0
    khr_debug = debug__
    ctx_has_mipLodBias = False
    ctx_mipLodBias = 0!
    shadowConstants = lighting_constants_new()
    gles = False
    fragmentHighpFloatAvailable = True
    fragmentHighpIntAvailable = True
    viewportWidth = 0
    viewportHeight = 0
    Erase enabledVertexAttribIndexes
    enabledVertexAttribIndexes_size = 0
    frameNum = 0
    formattedRendererInfoString = ""
    For i = 0 To PIXEL_FORMAT_TARGET_COUNT
        For j = 0 To MAX_PIXEL_FORMAT
            textureFormatsSupport(i, j) = pixel_format_usage_none
        Next
        textureFormatsSupport_size(i) = 0
    Next
    has2DTextureArraySupport = False
    hasInstancedRenderingSupport = False
    hasBorderClampSupport = False
    maxArrayTextureLayers = 0
    maxTextureAnisotropy = 0!
    vaoId = 0
    Erase createdPipelines_createInfo
    Erase createdPipelines_pso
    createdPipelines_size = 0
    Set pDefaultTexture = Nothing
    Set pDefaultArrayTexture = Nothing
    Set pDefaultDepthTexture = Nothing
    Set depthTexture = Nothing
    Erase depthFBO
    depthFBO_size = 0
    depthBufferResolution = 4096
    depthPassCount = WZ_MAX_SHADOW_CASCADES
    sceneFramebufferWidth = 0
    sceneFramebufferHeight = 0
    multiSampledBufferInternalFormat = GL_INVALID_ENUM
    multiSampledBufferBaseFormat = GL_INVALID_ENUM
    maxMultiSampleBufferFormatSamples = 0
    multisamples = 0
    Set sceneTexture = Nothing
    Erase sceneFBO
    sceneFBO_size = 0
    Erase sceneResolveFBO
    sceneResolveFBO_size = 0
    sceneMsaaRBO = 0
    sceneDepthStencilRBO = 0
    sceneFBOIdx = 0
    ' static float transparentBlackFloats[] ... (the file's static initialisers)
    opaqueBlackFloats(3) = 1!
    For i = 0 To 3
        opaqueWhiteFloats(i) = 1!
    Next
End Sub

Public Function to_gl_internalformat(ByVal format As pixel_format, ByVal gles_ As Boolean) As Long
    Select Case format
    ' UNCOMPRESSED FORMATS
    Case pixel_format_FORMAT_RGBA8_UNORM_PACK8
        to_gl_internalformat = GL_RGBA8: Exit Function
    Case pixel_format_FORMAT_BGRA8_UNORM_PACK8
        to_gl_internalformat = GL_RGBA8: Exit Function ' must store as RGBA8
    Case pixel_format_FORMAT_RGB8_UNORM_PACK8
        to_gl_internalformat = GL_RGB8: Exit Function
    Case pixel_format_FORMAT_RG8_UNORM
        If gles_ And GLAD_GL_EXT_texture_rg Then
            ' the internal format is GL_RG_EXT
            to_gl_internalformat = GL_RG_EXT: Exit Function
        Else
            ' for Desktop OpenGL (or WebGL 2.0), use GL_RG8 for the internal format
            to_gl_internalformat = GL_RG8: Exit Function
        End If
    Case pixel_format_FORMAT_R8_UNORM
        If (Not gles_ And GLAD_GL_VERSION_3_0) Or (gles_ And GLAD_GL_ES_VERSION_3_0) Then
            ' OpenGL 3.0+ or OpenGL ES 3.0+
            to_gl_internalformat = GL_R8: Exit Function
        Else
            ' older version fallback
            ' use GL_LUMINANCE because:
            ' (a) it's available and
            ' (b) it ensures the single channel value ends up in "red" so the shaders don't have to care
            to_gl_internalformat = GL_LUMINANCE: Exit Function
        End If
    ' COMPRESSED FORMAT
    Case pixel_format_FORMAT_RGB_BC1_UNORM
        to_gl_internalformat = GL_COMPRESSED_RGB_S3TC_DXT1_EXT: Exit Function
    Case pixel_format_FORMAT_RGBA_BC2_UNORM
        to_gl_internalformat = GL_COMPRESSED_RGBA_S3TC_DXT3_EXT: Exit Function
    Case pixel_format_FORMAT_RGBA_BC3_UNORM
        to_gl_internalformat = GL_COMPRESSED_RGBA_S3TC_DXT5_EXT: Exit Function
    Case pixel_format_FORMAT_R_BC4_UNORM
        to_gl_internalformat = GL_COMPRESSED_RED_RGTC1: Exit Function
    Case pixel_format_FORMAT_RG_BC5_UNORM
        to_gl_internalformat = GL_COMPRESSED_RG_RGTC2: Exit Function
    Case pixel_format_FORMAT_RGBA_BPTC_UNORM
        to_gl_internalformat = GL_COMPRESSED_RGBA_BPTC_UNORM_EXT: Exit Function ' same value as GL_COMPRESSED_RGBA_BPTC_UNORM_ARB
    Case pixel_format_FORMAT_RGB8_ETC1
        to_gl_internalformat = GL_ETC1_RGB8_OES: Exit Function
    Case pixel_format_FORMAT_RGB8_ETC2
        to_gl_internalformat = GL_COMPRESSED_RGB8_ETC2: Exit Function
    Case pixel_format_FORMAT_RGBA8_ETC2_EAC
        to_gl_internalformat = GL_COMPRESSED_RGBA8_ETC2_EAC: Exit Function
    Case pixel_format_FORMAT_R11_EAC
        to_gl_internalformat = GL_COMPRESSED_R11_EAC: Exit Function
    Case pixel_format_FORMAT_RG11_EAC
        to_gl_internalformat = GL_COMPRESSED_RG11_EAC: Exit Function
    Case pixel_format_FORMAT_ASTC_4x4_UNORM
        to_gl_internalformat = GL_COMPRESSED_RGBA_ASTC_4x4_KHR: Exit Function
    Case Else
        debug_ 207, LOG_FATAL, "to_gl_internalformat", "Unrecognised pixel format"
    End Select
    to_gl_internalformat = GL_INVALID_ENUM
End Function

Public Function to_gl_format(ByVal format As pixel_format, ByVal gles_ As Boolean) As Long
    Select Case format
    ' UNCOMPRESSED FORMATS
    Case pixel_format_FORMAT_RGBA8_UNORM_PACK8
        to_gl_format = GL_RGBA: Exit Function
    Case pixel_format_FORMAT_BGRA8_UNORM_PACK8
        to_gl_format = GL_BGRA: Exit Function
    Case pixel_format_FORMAT_RGB8_UNORM_PACK8
        to_gl_format = GL_RGB: Exit Function
    Case pixel_format_FORMAT_RG8_UNORM
        If gles_ And GLAD_GL_EXT_texture_rg Then
            ' the internal format is GL_RG_EXT
            to_gl_format = GL_RG_EXT: Exit Function
        Else
            ' for Desktop OpenGL or WebGL 2.0, use GL_RG for the format
            to_gl_format = GL_RG: Exit Function
        End If
    Case pixel_format_FORMAT_R8_UNORM
        If (Not gles_ And GLAD_GL_VERSION_3_0) Or (gles_ And GLAD_GL_ES_VERSION_3_0) Then
            ' OpenGL 3.0+ or OpenGL ES 3.0+
            to_gl_format = GL_RED: Exit Function
        Else
            ' older version fallback
            ' use GL_LUMINANCE because:
            ' (a) it's available and
            ' (b) it ensures the single channel value ends up in "red" so the shaders don't have to care
            to_gl_format = GL_LUMINANCE: Exit Function
        End If
    ' COMPRESSED FORMAT
    Case Else
        to_gl_format = to_gl_internalformat(format, gles_): Exit Function
    End Select
    to_gl_format = GL_INVALID_ENUM
End Function

Public Function to_gl_hint(ByVal hint As buffer_storage_hint) As Long
    Select Case hint
    Case buffer_storage_hint_static_draw
        to_gl_hint = GL_STATIC_DRAW: Exit Function
    Case buffer_storage_hint_dynamic_draw
        to_gl_hint = GL_DYNAMIC_DRAW: Exit Function
    Case buffer_storage_hint_stream_draw
        to_gl_hint = GL_STREAM_DRAW: Exit Function
    Case Else
        debug_ 277, LOG_FATAL, "to_gl", "Unsupported buffer hint"
    End Select
    to_gl_hint = GL_INVALID_ENUM
End Function

Public Function to_gl_usage(ByVal usage As buffer_usage) As Long
    Select Case usage
    Case buffer_usage_index_buffer
        to_gl_usage = GL_ELEMENT_ARRAY_BUFFER: Exit Function
    Case buffer_usage_vertex_buffer
        to_gl_usage = GL_ARRAY_BUFFER: Exit Function
    Case Else
        debug_ 291, LOG_FATAL, "to_gl", "Unrecognised buffer usage"
    End Select
    to_gl_usage = GL_INVALID_ENUM
End Function

Private Function to_gl_primitive(ByVal primitive As primitive_type) As Long
    Select Case primitive
    Case primitive_type_lines
        to_gl_primitive = GL_LINES: Exit Function
    Case primitive_type_line_strip
        to_gl_primitive = GL_LINE_STRIP: Exit Function
    Case primitive_type_triangles
        to_gl_primitive = GL_TRIANGLES: Exit Function
    Case primitive_type_triangle_strip
        to_gl_primitive = GL_TRIANGLE_STRIP: Exit Function
    Case Else
        debug_ 309, LOG_FATAL, "to_gl", "Unrecognised primitive type"
    End Select
    to_gl_primitive = GL_INVALID_ENUM
End Function

Private Function to_gl_index(ByVal index As index_type) As Long
    Select Case index
    Case index_type_u16
        to_gl_index = GL_UNSIGNED_SHORT: Exit Function
    Case index_type_u32
        to_gl_index = GL_UNSIGNED_INT: Exit Function
    Case Else
        debug_ 323, LOG_FATAL, "to_gl", "Unrecognised index type"
    End Select
    to_gl_index = GL_INVALID_ENUM
End Function

Private Function to_gl_property(ByVal property_ As context_value) As Long
    Select Case property_
    Case context_value_MAX_ELEMENTS_VERTICES
        to_gl_property = GL_MAX_ELEMENTS_VERTICES: Exit Function
    Case context_value_MAX_ELEMENTS_INDICES
        to_gl_property = GL_MAX_ELEMENTS_INDICES: Exit Function
    Case context_value_MAX_TEXTURE_SIZE
        to_gl_property = GL_MAX_TEXTURE_SIZE: Exit Function
    Case context_value_MAX_SAMPLES
        to_gl_property = GL_MAX_SAMPLES: Exit Function
    Case context_value_MAX_ARRAY_TEXTURE_LAYERS
        to_gl_property = GL_MAX_ARRAY_TEXTURE_LAYERS: Exit Function
    Case context_value_MAX_VERTEX_ATTRIBS
        to_gl_property = GL_MAX_VERTEX_ATTRIBS: Exit Function
    Case Else
        debug_ 345, LOG_FATAL, "to_gl", "Unrecognised property type"
    End Select
    to_gl_property = GL_INVALID_ENUM
End Function

' MARK: GL error handling helpers

' NOTE: Not to be used in critical code paths, but more for initialization
' (the macro wzGLCheckErrors() passes __LINE__ and __FUNCTION__)
Private Function wzGLCheckErrors_(ByVal line_ As Long, ByVal function_ As String) As Boolean
    Dim err_ As Long, encounteredCriticalError As Boolean, part As code_part, errAsStr As String
    If glad_glGetError = 0 Then
        ' function not available? can't check...
        wzGLCheckErrors_ = True
        Exit Function
    End If
    err_ = glGetError()
    If err_ = GL_NO_ERROR Then
        wzGLCheckErrors_ = True
        Exit Function
    End If

    ' otherwise
    encounteredCriticalError = False
    Do
        part = LOG_ERROR
        errAsStr = "??"
        Select Case err_
        Case GL_INVALID_ENUM
            errAsStr = "GL_INVALID_ENUM"
            part = LOG_INFO
        Case GL_INVALID_VALUE
            errAsStr = "GL_INVALID_VALUE"
            part = LOG_INFO
        Case GL_INVALID_OPERATION
            errAsStr = "GL_INVALID_OPERATION"
            part = LOG_INFO
        Case GL_INVALID_FRAMEBUFFER_OPERATION
            errAsStr = "GL_INVALID_FRAMEBUFFER_OPERATION"
        Case GL_OUT_OF_MEMORY
            errAsStr = "GL_OUT_OF_MEMORY"
            part = LOG_FATAL
            ' Once GL_OUT_OF_MEMORY is set, the state of the OpenGL context is *undefined*
            encounteredCriticalError = True
        Case GL_STACK_UNDERFLOW
            errAsStr = "GL_STACK_UNDERFLOW"
            encounteredCriticalError = True
        Case GL_STACK_OVERFLOW
            errAsStr = "GL_STACK_OVERFLOW"
            encounteredCriticalError = True
        End Select

        If debugPartEnabled(part) Then
            debug_ line_, part, function_, "Encountered OpenGL Error: %s", errAsStr
        End If
        err_ = glGetError()
    Loop While err_ <> GL_NO_ERROR

    wzGLCheckErrors_ = Not encounteredCriticalError
End Function

Private Sub wzGLClearErrors_()
    ' clear OpenGL error queue
    If glad_glGetError <> 0 Then
        Do While glGetError() <> GL_NO_ERROR ' clear the OpenGL error queue
        Loop
    End If
End Sub

