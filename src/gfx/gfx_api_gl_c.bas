    Select Case version
    Case VERSION_ES_100
        shaderVersionString_es = "#version 100" & vbLf: Exit Function
    Case VERSION_ES_300
        shaderVersionString_es = "#version 300 es" & vbLf: Exit Function
        ' Deliberately omit "default:" case to trigger a compiler warning if the SHADER_VERSION_ES enum is expanded but the new cases aren't handled here
    End Select
    shaderVersionString_es = "" ' Should not reach here - silence a GCC warning
End Function

Public Function wz_GetGLIntegerv(ByVal pname As Long, Optional ByVal defaultValue As Long = 0) As Long
    Dim retVal As Long, err_ As Long
    retVal = defaultValue
    If Not (glad_glGetIntegerv <> 0) Then ASSERT_FAILURE "glGetIntegerv != nullptr", "lib/ivis_opengl/gfx_api_gl.cpp:1003", "wz_GetGLIntegerv", "glGetIntegerv is null": wz_GetGLIntegerv = retVal: Exit Function
    If glad_glGetError <> 0 Then
        Do While glGetError() <> GL_NO_ERROR ' clear the OpenGL error queue
        Loop
    End If
    glGetIntegerv pname, VarPtr(retVal)
    err_ = GL_NO_ERROR
    If glad_glGetError <> 0 Then
        err_ = glGetError()
    End If
    If err_ <> GL_NO_ERROR Then
        retVal = defaultValue
    End If
    wz_GetGLIntegerv = retVal
End Function

Public Function getMinimumShaderVersionForCurrentGLContext() As SHADER_VERSION
    Dim gl_majorversion As Long, gl_minorversion As Long, version As SHADER_VERSION
    ' Determine the shader version directive we should use by examining the current OpenGL context
    gl_majorversion = wz_GetGLIntegerv(GL_MAJOR_VERSION, 0)
    gl_minorversion = wz_GetGLIntegerv(GL_MINOR_VERSION, 0)

    version = VERSION_120 ' for OpenGL < 3.2, we default to VERSION_120 shaders
    If (gl_majorversion > 3) Or ((gl_majorversion = 3) And (gl_minorversion >= 2)) Then
        ' OpenGL 3.2+
        ' Since WZ only supports Core contexts with OpenGL 3.2+, we cannot use the version_120 directive
        ' (which only works in compatibility contexts). Instead, use GLSL version "150 core".
        version = VERSION_150_CORE
    End If
    getMinimumShaderVersionForCurrentGLContext = version
End Function

Public Function getMaximumShaderVersionForCurrentGLContext(Optional ByVal minSupportedShaderVersion As SHADER_VERSION = VERSION_120, Optional ByVal maxSupportedShaderVersion As SHADER_VERSION = VERSION_410_CORE) As SHADER_VERSION
    Dim gl_majorversion As Long, gl_minorversion As Long, version As SHADER_VERSION
    If Not (minSupportedShaderVersion <= maxSupportedShaderVersion) Then ASSERT_FAILURE "minSupportedShaderVersion <= maxSupportedShaderVersion", "lib/ivis_opengl/gfx_api_gl.cpp:1043", "getMaximumShaderVersionForCurrentGLContext", "minSupportedShaderVersion > maxSupportedShaderVersion"

    ' Instead of querying the GL_SHADING_LANGUAGE_VERSION string and trying to parse it,
    ' which is rife with difficulties because drivers can report very different strings (and formats),
    ' use the known (and explicit) mapping table between OpenGL version and supported GLSL version.

    gl_majorversion = wz_GetGLIntegerv(GL_MAJOR_VERSION, 0)
    gl_minorversion = wz_GetGLIntegerv(GL_MINOR_VERSION, 0)

    ' For OpenGL < 3.2, default to VERSION_120 shaders
    version = VERSION_120
    If gl_majorversion = 3 Then
        Select Case gl_minorversion
        Case 0 ' 3.0 => 1.30
            version = VERSION_130
        Case 1 ' 3.1 => 1.40
            version = VERSION_140
        Case 2 ' 3.2 => 1.50
            version = VERSION_150_CORE
        Case 3 ' 3.3 => 3.30
            version = VERSION_330_CORE
        Case Else
            ' Return the 3.3 value
            version = VERSION_330_CORE
        End Select
    ElseIf gl_majorversion = 4 Then
        Select Case gl_minorversion
        Case 0 ' 4.0 => 4.00
            version = VERSION_400_CORE
        Case 1 ' 4.1 => 4.10
            version = VERSION_410_CORE
        Case Else
            ' Return the 4.1 value
            ' NOTE: Nothing above OpenGL 4.1 is supported on macOS
            version = VERSION_410_CORE
        End Select
    ElseIf gl_majorversion > 4 Then
        ' Return the OpenGL 4.1 value (for now)
        version = VERSION_410_CORE
    End If

    If minSupportedShaderVersion > version Then version = minSupportedShaderVersion
    If maxSupportedShaderVersion < version Then version = maxSupportedShaderVersion

    getMaximumShaderVersionForCurrentGLContext = version
End Function

Public Function getMaximumShaderVersionForCurrentGLESContext(Optional ByVal minSupportedShaderVersion As SHADER_VERSION_ES = VERSION_ES_100, Optional ByVal maxSupportedShaderVersion As SHADER_VERSION_ES = VERSION_ES_300) As SHADER_VERSION_ES
    Dim gl_majorversion As Long, version As SHADER_VERSION_ES
    If Not (minSupportedShaderVersion <= maxSupportedShaderVersion) Then ASSERT_FAILURE "minSupportedShaderVersion <= maxSupportedShaderVersion", "lib/ivis_opengl/gfx_api_gl.cpp:1107", "getMaximumShaderVersionForCurrentGLESContext", "minSupportedShaderVersion > maxSupportedShaderVersion"

    ' Instead of querying the GL_SHADING_LANGUAGE_VERSION string and trying to parse it,
    ' which is rife with difficulties because drivers can report very different strings (and formats),
    ' use the known (and explicit) mapping table between OpenGL version and supported GLSL version.

    gl_majorversion = wz_GetGLIntegerv(GL_MAJOR_VERSION, 0)
    'GLint gl_minorversion = wz_GetGLIntegerv(GL_MINOR_VERSION, 0);

    ' For OpenGL ES < 3.0, default to VERSION_ES_100 shaders
    version = VERSION_ES_100
    If gl_majorversion = 3 Then
        getMaximumShaderVersionForCurrentGLESContext = VERSION_ES_300
        Exit Function
    ElseIf gl_majorversion > 3 Then
        ' Return the OpenGL ES 3.0 value (for now)
        version = VERSION_ES_300
    End If

    If minSupportedShaderVersion > version Then version = minSupportedShaderVersion
    If maxSupportedShaderVersion < version Then version = maxSupportedShaderVersion

    getMaximumShaderVersionForCurrentGLESContext = version
End Function

Private Function get_size(ByVal type_ As vertex_attribute_type) As Long
    Select Case type_
    Case vertex_attribute_type_int1
        get_size = 1: Exit Function
    Case vertex_attribute_type_float2
        get_size = 2: Exit Function
    Case vertex_attribute_type_float3
        get_size = 3: Exit Function
    Case vertex_attribute_type_float4, vertex_attribute_type_u8x4_uint, vertex_attribute_type_u8x4_norm
        get_size = 4: Exit Function
    End Select
    debug_ 2358, LOG_FATAL, "get_size", "get_size(%d) failed", CLng(type_)
    get_size = 0 ' silence warning
End Function

Private Function get_type(ByVal type_ As vertex_attribute_type) As Long
    Select Case type_
    Case vertex_attribute_type_float2, vertex_attribute_type_float3, vertex_attribute_type_float4
        get_type = GL_FLOAT: Exit Function
    Case vertex_attribute_type_u8x4_uint, vertex_attribute_type_u8x4_norm
        get_type = GL_UNSIGNED_BYTE: Exit Function
    Case vertex_attribute_type_int1
        get_type = GL_INT: Exit Function
    End Select
    debug_ 2376, LOG_FATAL, "get_type", "get_type(%d) failed", CLng(type_)
    get_type = GL_INVALID_ENUM ' silence warning
End Function

Private Function get_normalisation(ByVal type_ As vertex_attribute_type) As Long
    Select Case type_
    Case vertex_attribute_type_float2, vertex_attribute_type_float3, vertex_attribute_type_float4, vertex_attribute_type_int1, vertex_attribute_type_u8x4_uint
        get_normalisation = GL_FALSE: Exit Function
    Case vertex_attribute_type_u8x4_norm
        get_normalisation = GL_TRUE: Exit Function
    End Select
    debug_ 2393, LOG_FATAL, "get_normalisation", "get_normalisation(%d) failed", CLng(type_)
    get_normalisation = GL_FALSE ' silence warning
End Function

' MARK: gl_context

Public Function gl_context_create_texture(ByVal mipmap_count As Long, ByVal width As Long, ByVal height As Long, ByVal internal_format As pixel_format, ByVal filename As String) As gfx_api_texture
    Dim new_texture As gl_texture, i As Long, e As Long
    If Not (mipmap_count > 0) Then ASSERT_FAILURE "mipmap_count > 0", "lib/ivis_opengl/gfx_api_gl.cpp:2406", "create_texture", "mipmap_count must be > 0"
    Set new_texture = New gl_texture
    new_texture.gles = gles
    new_texture.mip_count = mipmap_count
    new_texture.internal_format = internal_format
    new_texture.tex_width = width
    new_texture.tex_height = height
    new_texture.bind
    glTexParameteri GL_TEXTURE_2D, GL_TEXTURE_BASE_LEVEL, 0
    glTexParameteri GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, mipmap_count - 1
    If Len(filename) > 0 Then
        wzGLObjectLabel GL_TEXTURE_, new_texture.id(), -1, filename
    End If
    e = mipmap_count
    For i = 0 To e - 1
        If gfx_api_is_uncompressed_format(internal_format) Then
            ' Allocate an empty buffer of the full size
            ' (As uncompressed textures support the upload_sub() function that permits sub texture uploads)
            glTexImage2D GL_TEXTURE_2D, i, to_gl_internalformat(internal_format, gles), SHRU(width, i), SHRU(height, i), 0, to_gl_format(internal_format, gles), GL_UNSIGNED_BYTE, 0
        Else
            ' Can't use glCompressedTexImage2D with a null buffer (it's not permitted by the standard, and will crash depending on the driver)
            ' For now, we don't allocate a buffer and instead: only the upload() function that uploads full images is supported
        End If
    Next
    Set gl_context_create_texture = new_texture
End Function

Public Function gl_context_create_texture_array(ByVal mipmap_count As Long, ByVal layer_count As Long, ByVal width As Long, ByVal height As Long, ByVal internal_format As pixel_format, ByVal filename As String) As gfx_api_texture_array
    Dim new_texture As gl_texture_array
    If Not (mipmap_count > 0) Then ASSERT_FAILURE "mipmap_count > 0", "lib/ivis_opengl/gfx_api_gl.cpp:2447", "create_texture_array", "mipmap_count must be > 0"
    Set new_texture = New gl_texture_array
    new_texture.gles = gles
    new_texture.mip_count = mipmap_count
    new_texture.layer_count = layer_count
    new_texture.internal_format = internal_format
    new_texture.bind
    glTexParameteri GL_TEXTURE_2D_ARRAY, GL_TEXTURE_BASE_LEVEL, 0
    glTexParameteri GL_TEXTURE_2D_ARRAY, GL_TEXTURE_MAX_LEVEL, mipmap_count - 1
    If Len(filename) > 0 Then
        wzGLObjectLabel GL_TEXTURE_, new_texture.id(), -1, filename
    End If
    ' Allocate a client-side buffer
    Set new_texture.pInternalBuffer = New texture_array_mip_level_buffer
    new_texture.pInternalBuffer.construct mipmap_count, layer_count, width, height, internal_format
    new_texture.unbind
    Set gl_context_create_texture_array = new_texture
End Function

Private Function create_depthmap_texture(ByVal layer_count As Long, ByVal width As Long, ByVal height As Long, ByVal filename As String) As gl_gpurendered_texture
    Dim depthInternalFormat As Long
    depthInternalFormat = GL_DEPTH_COMPONENT32F
    Set create_depthmap_texture = create_gpurendered_texture_array(depthInternalFormat, GL_DEPTH_COMPONENT, GL_FLOAT, width, height, layer_count, filename)
End Function

Private Function create_gpurendered_texture(ByVal internalFormat As Long, ByVal format As Long, ByVal type_ As Long, ByVal width As Long, ByVal height As Long, ByVal filename As String) As gl_gpurendered_texture
    Dim new_texture As gl_gpurendered_texture
    Set new_texture = New gl_gpurendered_texture
    new_texture.gles = gles
    new_texture.isArray_ = False
    new_texture.bind
    glTexParameteri new_texture.target(), GL_TEXTURE_BASE_LEVEL, 0
    glTexParameteri new_texture.target(), GL_TEXTURE_MAX_LEVEL, 0
    If Len(filename) > 0 Then
        wzGLObjectLabel GL_TEXTURE_, new_texture.id(), -1, filename
    End If

    glTexImage2D GL_TEXTURE_2D, 0, internalFormat, width, height, 0, format, type_, 0

    new_texture.unbind
    Set create_gpurendered_texture = new_texture
End Function

Private Function create_gpurendered_texture_array(ByVal internalFormat As Long, ByVal format As Long, ByVal type_ As Long, ByVal width As Long, ByVal height As Long, ByVal layer_count As Long, ByVal filename As String) As gl_gpurendered_texture
    Dim new_texture As gl_gpurendered_texture
    Set new_texture = New gl_gpurendered_texture
    new_texture.gles = gles
    new_texture.isArray_ = True
    new_texture.bind
    glTexParameteri new_texture.target(), GL_TEXTURE_BASE_LEVEL, 0
    glTexParameteri new_texture.target(), GL_TEXTURE_MAX_LEVEL, 0
    If Len(filename) > 0 Then
        wzGLObjectLabel GL_TEXTURE_, new_texture.id(), -1, filename
    End If

    glTexImage3D GL_TEXTURE_2D_ARRAY, 0, internalFormat, width, height, layer_count, 0, format, type_, 0

    new_texture.unbind
    Set create_gpurendered_texture_array = new_texture
End Function

Private Function create_framebuffer_color_texture(ByVal internalFormat As Long, ByVal format As Long, ByVal type_ As Long, ByVal width As Long, ByVal height As Long, ByVal filename As String) As gl_gpurendered_texture
