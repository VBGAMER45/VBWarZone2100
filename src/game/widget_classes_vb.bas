' a WzFunc's id to its module's _fn
Public Function WzFunc_dispatch(ByVal f As WzFunc, args() As Variant) As Variant
    Select Case f.id
    Case FN_HRTFSupported, FN_audio_voiceVol_get, FN_audio_voiceVol_set, FN_audio_fxVol_get, FN_audio_fxVol_set, FN_audio_musicVol_get, FN_audio_musicVol_set, FN_audio_hrtf_populate, FN_audio_hrtf_select, FN_audio_subtitles_populate
        WzFunc_dispatch_set WzFunc_dispatch, audiooptions_c_fn(f, args)
    Case FN_audio_subtitles_select, FN_audio_musicManager_update, FN_audio_musicManager_click, FN_audio_groupReporting_populate, FN_audio_groupReporting_select, FN_doOpenMusicManager_onClose
        WzFunc_dispatch_set WzFunc_dispatch, audiooptions_c_fn(f, args)
    Case FN_barGraphDisplayTrough
        WzFunc_dispatch_set WzFunc_dispatch, bar_c_fn(f, args)
    Case FN_BuildOptionButton_startBuildPosition, FN_BuildOptionButton_toggleFavorites, FN_BuildStatsForm_obsoleteClicked, FN_BuildStatsForm_favoriteClicked
        WzFunc_dispatch_set WzFunc_dispatch, build_c_fn(f, args)
