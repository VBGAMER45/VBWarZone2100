Private Sub initTables()
    Dim i As Long, v As Long, r As Long
    pow2(0) = 1
    For i = 1 To 30
        pow2(i) = pow2(i - 1) * 2
    Next i
    pow2(31) = &H80000000
    BIT_mask(0) = 0
    For i = 1 To 31
        BIT_mask(i) = pow2(i) - 1
    Next i
    For v = 1 To 255
        r = 0
        i = v
        Do While i > 1
            i = i \ 2
            r = r + 1
        Loop
        hibit8(v) = r
    Next v

