Private Sub setLongs(a() As Long, ByVal s As String)
    Dim v() As String, i As Long
    v = Split(s, ",")
    For i = 0 To UBound(v)
        a(i) = CLng(v(i))
    Next i
End Sub

Private Sub setDefault(nxt() As Long, addBits() As Long, nbBits() As Long, base() As Long, ByVal s As String)
    Dim v() As String, i As Long
    v = Split(s, ",")
    For i = 0 To (UBound(v) + 1) \ 4 - 1
        nxt(i) = CLng(v(4 * i))
        addBits(i) = CLng(v(4 * i + 1))
        nbBits(i) = CLng(v(4 * i + 2))
        base(i) = CLng(v(4 * i + 3))
    Next i
End Sub

'--------------------------------------------------------------------------
' (VB) C's unsigned arithmetic, mem.h, bitstream.h (as zstd_entropy_c's)

Private Function zULT(ByVal a As Long, ByVal b As Long) As Boolean
    zULT = (a Xor &H80000000) < (b Xor &H80000000)
End Function

Private Function zSHRU(ByVal x As Long, ByVal s As Long) As Long
    s = s And 31
    If x >= 0 Then
        zSHRU = x \ pow2(s)
    Else
        zSHRU = ((x And &H7FFFFFFF) \ pow2(s)) Or pow2(31 - s)
    End If
End Function

Private Function zstdIsError(ByVal code As Long) As Boolean
    zstdIsError = (code < 0) And (code > -ERROR_maxCode)
End Function

Private Function MEM_readLE16(b() As Byte, ByVal p As Long) As Long
    MEM_readLE16 = b(p) Or (CLng(b(p + 1)) * &H100&)
End Function

Private Function MEM_readLE24(b() As Byte, ByVal p As Long) As Long
    MEM_readLE24 = b(p) Or (CLng(b(p + 1)) * &H100&) Or (CLng(b(p + 2)) * &H10000)
End Function

Private Function MEM_readLE32(b() As Byte, ByVal p As Long) As Long
    MEM_readLE32 = b(p) Or (CLng(b(p + 1)) * &H100&) Or (CLng(b(p + 2)) * &H10000) Or (CLng(b(p + 3)) * &H1000000)
End Function

Private Function BIT_highbit32(ByVal v As Long) As Long
    Dim r As Long
    If v < 0 Then BIT_highbit32 = 31: Exit Function
    If v >= &H10000 Then v = v \ &H10000: r = 16
    If v >= &H100& Then v = v \ &H100&: r = r + 8
    BIT_highbit32 = r + hibit8(v)
End Function

Private Function BIT_initDStream(bitD As BIT_DStream_t, src() As Byte, ByVal srcBuffer As Long, ByVal srcSize As Long) As Long
    Dim lastByte As Long
    If srcSize < 1 Then
        bitD.bitContainer = 0: bitD.bitsConsumed = 0: bitD.ptr = 0: bitD.start = 0: bitD.limitPtr = 0
        BIT_initDStream = ERR_srcSize_wrong
        Exit Function
    End If
    bitD.start = srcBuffer
    bitD.limitPtr = bitD.start + 4
    If srcSize >= 4 Then
        bitD.ptr = srcBuffer + srcSize - 4
        bitD.bitContainer = MEM_readLE32(src, bitD.ptr)
        lastByte = src(srcBuffer + srcSize - 1)
        If lastByte <> 0 Then bitD.bitsConsumed = 8 - BIT_highbit32(lastByte) Else bitD.bitsConsumed = 0
        If lastByte = 0 Then BIT_initDStream = ERR_GENERIC: Exit Function ' endMark not present
    Else
        bitD.ptr = bitD.start
        bitD.bitContainer = src(bitD.start)
        Select Case srcSize
        Case 3
            bitD.bitContainer = bitD.bitContainer + CLng(src(srcBuffer + 2)) * &H10000
            bitD.bitContainer = bitD.bitContainer + CLng(src(srcBuffer + 1)) * &H100&
        Case 2
            bitD.bitContainer = bitD.bitContainer + CLng(src(srcBuffer + 1)) * &H100&
        End Select
        lastByte = src(srcBuffer + srcSize - 1)
        If lastByte <> 0 Then bitD.bitsConsumed = 8 - BIT_highbit32(lastByte) Else bitD.bitsConsumed = 0
        If lastByte = 0 Then BIT_initDStream = ERR_corruption_detected: Exit Function ' endMark not present
        bitD.bitsConsumed = bitD.bitsConsumed + (4 - srcSize) * 8
    End If
    BIT_initDStream = srcSize
End Function

Private Function BIT_readBits(bitD As BIT_DStream_t, ByVal nbBits As Long) As Long
    BIT_readBits = zSHRU(bitD.bitContainer, (32 - bitD.bitsConsumed - nbBits) And 31) And BIT_mask(nbBits)
    bitD.bitsConsumed = bitD.bitsConsumed + nbBits
End Function

' BIT_readBitsFast: only works if nbBits >= 1
Private Function BIT_readBitsFast(bitD As BIT_DStream_t, ByVal nbBits As Long) As Long
    BIT_readBitsFast = zSHRU(bitD.bitContainer * pow2(bitD.bitsConsumed And 31), (32 - nbBits) And 31)
    bitD.bitsConsumed = bitD.bitsConsumed + nbBits
End Function

Private Function BIT_reloadDStream(bitD As BIT_DStream_t, src() As Byte) As Long
    Dim nbBytes As Long, result As Long
    If bitD.bitsConsumed > 32 Then BIT_reloadDStream = BIT_DStream_overflow: Exit Function
    If bitD.ptr >= bitD.limitPtr Then   ' BIT_reloadDStreamFast
        bitD.ptr = bitD.ptr - bitD.bitsConsumed \ 8
        bitD.bitsConsumed = bitD.bitsConsumed And 7
        bitD.bitContainer = MEM_readLE32(src, bitD.ptr)
        BIT_reloadDStream = BIT_DStream_unfinished
        Exit Function
    End If
    If bitD.ptr = bitD.start Then
        If bitD.bitsConsumed < 32 Then BIT_reloadDStream = BIT_DStream_endOfBuffer: Exit Function
        BIT_reloadDStream = BIT_DStream_completed
        Exit Function
    End If
    nbBytes = bitD.bitsConsumed \ 8
    result = BIT_DStream_unfinished
    If bitD.ptr - nbBytes < bitD.start Then
        nbBytes = bitD.ptr - bitD.start
        result = BIT_DStream_endOfBuffer
    End If
    bitD.ptr = bitD.ptr - nbBytes
    bitD.bitsConsumed = bitD.bitsConsumed - nbBytes * 8
    bitD.bitContainer = MEM_readLE32(src, bitD.ptr)
    BIT_reloadDStream = result
End Function

'--------------------------------------------------------------------------
' (VB) the DCtx's fields set by ZSTD_decompressBegin that live here: litEntropy, fseEntropy, rep (repStartValue),
' previousDstEnd / prefixStart / virtualStart / dictEnd (NULL), the Huffman table's header (hufTable[0])
Public Sub ZSTD_vbDecompressBeginBlock()
    If Not initialised Then initTables
    previousDstEndNull = True: previousDstEnd = 0
    prefixStartNull = True: prefixStart = 0
    virtualStart = 0
    dictEndNull = True: dictEnd = 0
    HUF_vbResetDTable
    litEntropy = 0
    fseEntropy = 0
    rep(0) = 1: rep(1) = 4: rep(2) = 8      ' repStartValue
End Sub

' ZSTD_checkContinuity: dst is the destination's offset (never NULL here)
Public Sub ZSTD_checkContinuity(ByVal dst As Long, ByVal dstSize As Long)
    If (previousDstEndNull Or dst <> previousDstEnd) And dstSize > 0 Then ' not contiguous
        dictEnd = previousDstEnd: dictEndNull = previousDstEndNull
        virtualStart = dst - (previousDstEnd - prefixStart)
        prefixStart = dst: prefixStartNull = False
        previousDstEnd = dst: previousDstEndNull = False
    End If
End Sub

' ZSTD_getcBlockSize: blockProperties_t as its three fields
Public Function ZSTD_getcBlockSize(src() As Byte, ByVal ip As Long, ByVal srcSize As Long, blockType As Long, lastBlock As Long, origSize As Long) As Long
    Dim cBlockHeader As Long, cSize As Long
    If srcSize < 3 Then ZSTD_getcBlockSize = ERR_srcSize_wrong: Exit Function
    cBlockHeader = MEM_readLE24(src, ip)
    cSize = cBlockHeader \ 8
    lastBlock = cBlockHeader And 1
    blockType = (cBlockHeader \ 2) And 3
    origSize = cSize    ' only useful for RLE
    If blockType = bt_rle Then ZSTD_getcBlockSize = 1: Exit Function
    If blockType = bt_reserved Then ZSTD_getcBlockSize = ERR_corruption_detected: Exit Function
    ZSTD_getcBlockSize = cSize
End Function

'--------------------------------------------------------------------------
' Literals

' ZSTD_decodeLiteralsBlock: src(istart .. istart + srcSize - 1); returns nb of bytes read from src (< srcSize)
Private Function ZSTD_decodeLiteralsBlock(src() As Byte, ByVal istart As Long, ByVal srcSize As Long) As Long
    Dim litEncType As Long, lhSize As Long, litSize_ As Long, litCSize As Long, singleStream As Boolean
    Dim lhlCode As Long, lhc As Long, hufSuccess As Long, i As Long, b As Byte

    If srcSize < MIN_CBLOCK_SIZE Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function

    litEncType = src(istart) And 3
    Select Case litEncType
    Case set_repeat, set_compressed
        If litEncType = set_repeat Then
            If litEntropy = 0 Then ZSTD_decodeLiteralsBlock = ERR_dictionary_corrupted: Exit Function
            ' (fall-through)
        End If
        If srcSize < 5 Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function ' srcSize >= MIN_CBLOCK_SIZE == 3; here we need up to 5 for case 3
        singleStream = False
        lhlCode = (src(istart) \ 4) And 3
        lhc = MEM_readLE32(src, istart)
        Select Case lhlCode
        Case 2
            ' 2 - 2 - 14 - 14
            lhSize = 4
            litSize_ = zSHRU(lhc, 4) And &H3FFF&
            litCSize = zSHRU(lhc, 18)
        Case 3
            ' 2 - 2 - 18 - 18
            lhSize = 5
            litSize_ = zSHRU(lhc, 4) And &H3FFFF
            litCSize = zSHRU(lhc, 22) + CLng(src(istart + 4)) * &H400&
        Case Else ' 0, 1
            ' 2 - 2 - 10 - 10
            singleStream = (lhlCode = 0)
            lhSize = 3
            litSize_ = zSHRU(lhc, 4) And &H3FF&
            litCSize = zSHRU(lhc, 14) And &H3FF&
        End Select
        If litSize_ > ZSTD_BLOCKSIZE_MAX Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function
        If litCSize + lhSize > srcSize Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function

        ' (prefetch huffman table if cold: no effect)
        If litEncType = set_repeat Then
            If singleStream Then
                hufSuccess = HUF_decompress1X_usingDTable_bmi2(litBuffer, 0, litSize_, src, istart + lhSize, litCSize)
            Else
                hufSuccess = HUF_decompress4X_usingDTable_bmi2(litBuffer, 0, litSize_, src, istart + lhSize, litCSize)
            End If
        Else
            If singleStream Then
                hufSuccess = HUF_decompress1X1_DCtx_wksp_bmi2(litBuffer, 0, litSize_, src, istart + lhSize, litCSize, HUF_DECOMPRESS_WORKSPACE_SIZE)
            Else
                hufSuccess = HUF_decompress4X_hufOnly_wksp_bmi2(litBuffer, 0, litSize_, src, istart + lhSize, litCSize, HUF_DECOMPRESS_WORKSPACE_SIZE)
            End If
        End If

        If zstdIsError(hufSuccess) Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function

        litInSrc = False
        litPtr = 0
        litSize = litSize_
        litEntropy = 1
        ' (if (litEncType==set_compressed) dctx->HUFptr = dctx->entropy.hufTable: the only table)
        For i = litSize To litSize + WILDCOPY_OVERLENGTH - 1
            litBuffer(i) = 0
        Next i
        ZSTD_decodeLiteralsBlock = litCSize + lhSize

    Case set_basic
        lhlCode = (src(istart) \ 4) And 3
        Select Case lhlCode
        Case 1
            lhSize = 2
            litSize_ = MEM_readLE16(src, istart) \ 16
        Case 3
            lhSize = 3
            litSize_ = MEM_readLE24(src, istart) \ 16
        Case Else ' 0, 2
            lhSize = 1
            litSize_ = src(istart) \ 8
        End Select

        If lhSize + litSize_ + WILDCOPY_OVERLENGTH > srcSize Then ' risk reading beyond src buffer with wildcopy
            If litSize_ + lhSize > srcSize Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function
            If litSize_ > 0 Then CopyMemory litBuffer(0), src(istart + lhSize), litSize_
            litInSrc = False
            litPtr = 0
            litSize = litSize_
            For i = litSize To litSize + WILDCOPY_OVERLENGTH - 1
                litBuffer(i) = 0
            Next i
            ZSTD_decodeLiteralsBlock = lhSize + litSize_
            Exit Function
        End If
        ' direct reference into compressed stream
        litInSrc = True
        litPtr = istart + lhSize
        litSize = litSize_
        ZSTD_decodeLiteralsBlock = lhSize + litSize_

    Case set_rle
        lhlCode = (src(istart) \ 4) And 3
        Select Case lhlCode
        Case 1
            lhSize = 2
            litSize_ = MEM_readLE16(src, istart) \ 16
        Case 3
            lhSize = 3
            litSize_ = MEM_readLE24(src, istart) \ 16
            If srcSize < 4 Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function ' srcSize >= MIN_CBLOCK_SIZE == 3; here we need lhSize+1 = 4
        Case Else ' 0, 2
            lhSize = 1
            litSize_ = src(istart) \ 8
        End Select
        If litSize_ > ZSTD_BLOCKSIZE_MAX Then ZSTD_decodeLiteralsBlock = ERR_corruption_detected: Exit Function
        b = src(istart + lhSize)
        For i = 0 To litSize_ + WILDCOPY_OVERLENGTH - 1
            litBuffer(i) = b
        Next i
        litInSrc = False
        litPtr = 0
        litSize = litSize_
        ZSTD_decodeLiteralsBlock = lhSize + 1
    End Select
End Function

'--------------------------------------------------------------------------
' The sequence tables

' ZSTD_buildSeqTable_rle into the table of kind k (0 LL, 1 OF, 2 ML)
Private Sub ZSTD_buildSeqTable_rle(ByVal k As Long, ByVal baseValue As Long, ByVal nbAddBits As Long)
    Select Case k
    Case 0
        LLT_tableLog = 0: LLT_fastMode = 0
        LLT_nbBits(0) = 0: LLT_next(0) = 0: LLT_addBits(0) = nbAddBits: LLT_base(0) = baseValue
    Case 1
        OFT_tableLog = 0: OFT_fastMode = 0
        OFT_nbBits(0) = 0: OFT_next(0) = 0: OFT_addBits(0) = nbAddBits: OFT_base(0) = baseValue
    Case Else
        MLT_tableLog = 0: MLT_fastMode = 0
        MLT_nbBits(0) = 0: MLT_next(0) = 0: MLT_addBits(0) = nbAddBits: MLT_base(0) = baseValue
    End Select
End Sub

' (VB) set_basic: the default table into the DCtx's table space of kind k
Private Sub useDefaultTable(ByVal k As Long)
    Dim i As Long
    Select Case k
    Case 0
        LLT_tableLog = LLdef_tableLog: LLT_fastMode = 1
        For i = 0 To 63
            LLT_next(i) = LLdef_next(i): LLT_addBits(i) = LLdef_addBits(i): LLT_nbBits(i) = LLdef_nbBits(i): LLT_base(i) = LLdef_base(i)
        Next i
    Case 1
        OFT_tableLog = OFdef_tableLog: OFT_fastMode = 1
        For i = 0 To 31
            OFT_next(i) = OFdef_next(i): OFT_addBits(i) = OFdef_addBits(i): OFT_nbBits(i) = OFdef_nbBits(i): OFT_base(i) = OFdef_base(i)
        Next i
    Case Else
        MLT_tableLog = MLdef_tableLog: MLT_fastMode = 1
        For i = 0 To 63
            MLT_next(i) = MLdef_next(i): MLT_addBits(i) = MLdef_addBits(i): MLT_nbBits(i) = MLdef_nbBits(i): MLT_base(i) = MLdef_base(i)
        Next i
    End Select
End Sub

' ZSTD_buildFSETable_body into the arrays given (the table of one kind)
Private Sub ZSTD_buildFSETable(tNext() As Long, tAddBits() As Long, tNbBits() As Long, tBase() As Long, tableLogOut As Long, fastModeOut As Long, normalizedCounter() As Long, ByVal maxSymbolValue As Long, baseValue() As Long, nbAdditionalBits() As Long, ByVal tableLog As Long)
    Dim maxSV1 As Long, tableSize As Long, highThreshold As Long, largeLimit As Long, s As Long
    Dim tableMask As Long, step_ As Long, position As Long, i As Long, u As Long, pos As Long, n As Long
    Dim symbol As Long, nextState As Long, nb As Long
    Static symbolNext(0 To 52) As Long, spread(0 To 511 + 8) As Long

    maxSV1 = maxSymbolValue + 1
    tableSize = pow2(tableLog)
    highThreshold = tableSize - 1

    ' Init, lay down lowprob symbols
    tableLogOut = tableLog
    fastModeOut = 1
    largeLimit = pow2(tableLog - 1)
    For s = 0 To maxSV1 - 1
        If normalizedCounter(s) = -1 Then
            tBase(highThreshold) = s
            highThreshold = highThreshold - 1
            symbolNext(s) = 1
        Else
            If normalizedCounter(s) >= largeLimit Then fastModeOut = 0
            symbolNext(s) = normalizedCounter(s)
        End If
    Next s

    ' Spread symbols
    If highThreshold = tableSize - 1 Then
        tableMask = tableSize - 1
        step_ = (tableSize \ 2) + (tableSize \ 8) + 3     ' FSE_TABLESTEP
        ' First lay down the symbols in order (C: 8 at a time)
        pos = 0
        For s = 0 To maxSV1 - 1
            n = normalizedCounter(s)
            For i = 0 To n - 1
                spread(pos + i) = s
            Next i
            pos = pos + n
        Next s
        ' Now we spread those positions across the table (unrolled twice in C)
        position = 0
        For s = 0 To tableSize - 1 Step 2
            For u = 0 To 1
                tBase((position + (u * step_)) And tableMask) = spread(s + u)
            Next u
            position = (position + (2 * step_)) And tableMask
        Next s
    Else
        tableMask = tableSize - 1
        step_ = (tableSize \ 2) + (tableSize \ 8) + 3
        position = 0
        For s = 0 To maxSV1 - 1
            n = normalizedCounter(s)
            For i = 0 To n - 1
                tBase(position) = s
                position = (position + step_) And tableMask
                Do While position > highThreshold   ' lowprob area
                    position = (position + step_) And tableMask
                Loop
            Next i
        Next s
        ' (assert(position == 0): no error in a release build)
    End If

    ' Build Decoding table
    For u = 0 To tableSize - 1
        symbol = tBase(u)
        nextState = symbolNext(symbol)
        symbolNext(symbol) = (nextState + 1) And &HFFFF&
        nb = (tableLog - BIT_highbit32(nextState)) And &HFF&
        tNbBits(u) = nb
        tNext(u) = ((nextState * pow2(nb)) - tableSize) And &HFFFF&
        tAddBits(u) = nbAdditionalBits(symbol) And &HFF&
        tBase(u) = baseValue(symbol)
    Next u
End Sub

' ZSTD_buildSeqTable: the table of kind k (0 LL, 1 OF, 2 ML) from src(ip .. ip + srcSize - 1)
Private Function ZSTD_buildSeqTable(ByVal k As Long, ByVal type_ As Long, ByVal max_ As Long, ByVal maxLog As Long, src() As Byte, ByVal ip As Long, ByVal srcSize As Long, baseValue() As Long, nbAdditionalBits() As Long, ByVal flagRepeatTable As Long) As Long
    Dim symbol As Long, tableLog As Long, headerSize As Long
    Dim norm(0 To 255) As Long

    Select Case type_
    Case set_rle
        If srcSize = 0 Then ZSTD_buildSeqTable = ERR_srcSize_wrong: Exit Function
        If src(ip) > max_ Then ZSTD_buildSeqTable = ERR_corruption_detected: Exit Function
        symbol = src(ip)
        ZSTD_buildSeqTable_rle k, baseValue(symbol), nbAdditionalBits(symbol)
        ZSTD_buildSeqTable = 1
    Case set_basic
        useDefaultTable k
        ZSTD_buildSeqTable = 0
    Case set_repeat
        If flagRepeatTable = 0 Then ZSTD_buildSeqTable = ERR_corruption_detected: Exit Function
        ' (prefetch FSE table if used: no effect)
        ZSTD_buildSeqTable = 0
    Case Else ' set_compressed
        headerSize = FSE_readNCount(norm, max_, tableLog, src, ip, srcSize)
        If zstdIsError(headerSize) Then ZSTD_buildSeqTable = ERR_corruption_detected: Exit Function
        If tableLog > maxLog Then ZSTD_buildSeqTable = ERR_corruption_detected: Exit Function
        Select Case k
        Case 0
            ZSTD_buildFSETable LLT_next, LLT_addBits, LLT_nbBits, LLT_base, LLT_tableLog, LLT_fastMode, norm, max_, baseValue, nbAdditionalBits, tableLog
        Case 1
            ZSTD_buildFSETable OFT_next, OFT_addBits, OFT_nbBits, OFT_base, OFT_tableLog, OFT_fastMode, norm, max_, baseValue, nbAdditionalBits, tableLog
        Case Else
            ZSTD_buildFSETable MLT_next, MLT_addBits, MLT_nbBits, MLT_base, MLT_tableLog, MLT_fastMode, norm, max_, baseValue, nbAdditionalBits, tableLog
        End Select
        ZSTD_buildSeqTable = headerSize
    End Select
End Function

' ZSTD_decodeSeqHeaders: src(istart .. istart + srcSize - 1)
Private Function ZSTD_decodeSeqHeaders(nbSeqPtr As Long, src() As Byte, ByVal istart As Long, ByVal srcSize As Long) As Long
    Dim iend As Long, ip As Long, nbSeq As Long, LLtype As Long, OFtype As Long, MLtype As Long, h As Long

    iend = istart + srcSize
    ip = istart

    ' check
    If srcSize < MIN_SEQUENCES_SIZE Then ZSTD_decodeSeqHeaders = ERR_srcSize_wrong: Exit Function

    ' SeqHead
    nbSeq = src(ip)
    ip = ip + 1
    If nbSeq = 0 Then
        nbSeqPtr = 0
        If srcSize <> 1 Then ZSTD_decodeSeqHeaders = ERR_srcSize_wrong: Exit Function
        ZSTD_decodeSeqHeaders = 1
        Exit Function
    End If
    If nbSeq > &H7F Then
        If nbSeq = &HFF Then
            If ip + 2 > iend Then ZSTD_decodeSeqHeaders = ERR_srcSize_wrong: Exit Function
            nbSeq = MEM_readLE16(src, ip) + LONGNBSEQ
            ip = ip + 2
        Else
            If ip >= iend Then ZSTD_decodeSeqHeaders = ERR_srcSize_wrong: Exit Function
            nbSeq = ((nbSeq - &H80) * 256) + src(ip)
            ip = ip + 1
        End If
    End If
    nbSeqPtr = nbSeq

    ' FSE table descriptors
    If ip + 1 > iend Then ZSTD_decodeSeqHeaders = ERR_srcSize_wrong: Exit Function ' minimum possible size: 1 byte for symbol encoding types
    LLtype = src(ip) \ 64
    OFtype = (src(ip) \ 16) And 3
    MLtype = (src(ip) \ 4) And 3
    ip = ip + 1

    ' Build DTables
    h = ZSTD_buildSeqTable(0, LLtype, MaxLL, LLFSELog, src, ip, iend - ip, LL_base, LL_bits, fseEntropy)
    If zstdIsError(h) Then ZSTD_decodeSeqHeaders = ERR_corruption_detected: Exit Function ' ZSTD_buildSeqTable failed
    ip = ip + h

    h = ZSTD_buildSeqTable(1, OFtype, MaxOff, OffFSELog, src, ip, iend - ip, OF_base, OF_bits, fseEntropy)
    If zstdIsError(h) Then ZSTD_decodeSeqHeaders = ERR_corruption_detected: Exit Function
    ip = ip + h

    h = ZSTD_buildSeqTable(2, MLtype, MaxML, MLFSELog, src, ip, iend - ip, ML_base, ML_bits, fseEntropy)
    If zstdIsError(h) Then ZSTD_decodeSeqHeaders = ERR_corruption_detected: Exit Function
    ip = ip + h

    ZSTD_decodeSeqHeaders = ip - istart
End Function

'--------------------------------------------------------------------------
' Sequence execution

' (VB) the literals' copy: n bytes from the literal pointer's array (src or litBuffer) at ip to dst at op
Private Sub copyLiterals(dst() As Byte, ByVal op As Long, src() As Byte, ByVal ip As Long, ByVal n As Long)
    Dim i As Long
    If n <= 0 Then Exit Sub
    If litInSrc Then
        If n < COPY_LOOP_MAX Then
            For i = 0 To n - 1
                dst(op + i) = src(ip + i)
            Next i
        Else
            CopyMemory dst(op), src(ip), n
        End If
    Else
        If n < COPY_LOOP_MAX Then
            For i = 0 To n - 1
                dst(op + i) = litBuffer(ip + i)
            Next i
        Else
            CopyMemory dst(op), litBuffer(ip), n
        End If
    End If
End Sub

' (VB) the match's copy: n bytes from dst at match to dst at op, match < op, byte after byte as LZ77 regenerates
' them (C: ZSTD_overlapCopy8 and the wildcopies; the same bytes). Pieces no longer than the offset do not overlap.
Private Sub copyMatch(dst() As Byte, ByVal op As Long, ByVal match As Long, ByVal n As Long)
    Dim offset As Long, k As Long, i As Long
    offset = op - match
    If n < COPY_LOOP_MAX Or offset < COPY_LOOP_OFFSET Then
        For i = 0 To n - 1
            dst(op + i) = dst(match + i)
        Next i
        Exit Sub
    End If
    Do While n > 0
        If n < offset Then k = n Else k = offset
        CopyMemory dst(op), dst(match), k
        op = op + k
        match = match + k
        n = n - k
    Loop
End Sub

' ZSTD_execSequenceEnd: op .. oend in dst; litPtr in src or litBuffer (litInSrc), litLimit the literals' end
Private Function ZSTD_execSequenceEnd(dst() As Byte, ByVal op As Long, ByVal oend As Long, sequence As seq_t, src() As Byte, litPtr_ As Long, ByVal litLimit As Long, ByVal prefixStart_ As Long, ByVal virtualStart_ As Long, ByVal dictEnd_ As Long) As Long
    Dim oLitEnd As Long, sequenceLength As Long, iLitEnd As Long, match As Long, length1 As Long

    oLitEnd = op + sequence.litLength
    sequenceLength = sequence.litLength + sequence.matchLength
    iLitEnd = litPtr_ + sequence.litLength
    match = oLitEnd - sequence.offset

    ' bounds checks : careful of address space overflow in 32-bit mode
    If zULT(oend - op, sequenceLength) Then ZSTD_execSequenceEnd = ERR_dstSize_tooSmall: Exit Function ' last match must fit within dstBuffer
    If zULT(litLimit - litPtr_, sequence.litLength) Then ZSTD_execSequenceEnd = ERR_corruption_detected: Exit Function ' try to read beyond literal buffer

    ' copy literals (ZSTD_safecopy, ZSTD_no_overlap)
    copyLiterals dst, op, src, litPtr_, sequence.litLength
    op = oLitEnd
    litPtr_ = iLitEnd

    ' copy Match
    If zULT(oLitEnd - prefixStart_, sequence.offset) Then
        ' offset beyond prefix
        If zULT(oLitEnd - virtualStart_, sequence.offset) Then ZSTD_execSequenceEnd = ERR_corruption_detected: Exit Function
        match = dictEnd_ - (prefixStart_ - match)
        If match + sequence.matchLength <= dictEnd_ Then
            CopyMemory dst(oLitEnd), dst(match), sequence.matchLength   ' ZSTD_memmove
            ZSTD_execSequenceEnd = sequenceLength
            Exit Function
        End If
        ' span extDict & currentPrefixSegment
        length1 = dictEnd_ - match
        CopyMemory dst(oLitEnd), dst(match), length1
        op = oLitEnd + length1
        sequence.matchLength = sequence.matchLength - length1
        match = prefixStart_
    End If
    copyMatch dst, op, match, sequence.matchLength    ' ZSTD_safecopy, ZSTD_overlap_src_before_dst
    ZSTD_execSequenceEnd = sequenceLength
End Function

' ZSTD_execSequence
Private Function ZSTD_execSequence(dst() As Byte, ByVal op As Long, ByVal oend As Long, sequence As seq_t, src() As Byte, litPtr_ As Long, ByVal litLimit As Long, ByVal prefixStart_ As Long, ByVal virtualStart_ As Long, ByVal dictEnd_ As Long) As Long
    Dim oLitEnd As Long, sequenceLength As Long, oMatchEnd As Long, oend_w As Long, iLitEnd As Long, match As Long
    Dim length1 As Long

    oLitEnd = op + sequence.litLength
    sequenceLength = sequence.litLength + sequence.matchLength
    oMatchEnd = op + sequenceLength    ' risk : address space overflow (32-bits)
    oend_w = oend - WILDCOPY_OVERLENGTH
    iLitEnd = litPtr_ + sequence.litLength
    match = oLitEnd - sequence.offset

    ' Handle edge cases in a slow path: read beyond end of literals; match end within WILDCOPY_OVERLIMIT of oend;
    ' 32-bit mode and the match length overflows
    If (iLitEnd > litLimit) Or (oMatchEnd > oend_w) Or zULT(oend - op, sequenceLength + WILDCOPY_OVERLENGTH) Then
        ZSTD_execSequence = ZSTD_execSequenceEnd(dst, op, oend, sequence, src, litPtr_, litLimit, prefixStart_, virtualStart_, dictEnd_)
        Exit Function
    End If

    ' Copy Literals (C: ZSTD_copy16, then a wildcopy for litLength > 16)
    copyLiterals dst, op, src, litPtr_, sequence.litLength
    op = oLitEnd
    litPtr_ = iLitEnd   ' update for next sequence

    ' Copy Match
    If zULT(oLitEnd - prefixStart_, sequence.offset) Then
        ' offset beyond prefix -> go into extDict
        If zULT(oLitEnd - virtualStart_, sequence.offset) Then ZSTD_execSequence = ERR_corruption_detected: Exit Function
        match = dictEnd_ + (match - prefixStart_)
        If match + sequence.matchLength <= dictEnd_ Then
            CopyMemory dst(oLitEnd), dst(match), sequence.matchLength
            ZSTD_execSequence = sequenceLength
            Exit Function
        End If
        ' span extDict & currentPrefixSegment
        length1 = dictEnd_ - match
        CopyMemory dst(oLitEnd), dst(match), length1
        op = oLitEnd + length1
        sequence.matchLength = sequence.matchLength - length1
        match = prefixStart_
    End If
    ' Match within prefix of 1 or more bytes (C: a wildcopy when offset >= WILDCOPY_VECLEN, else
    ' ZSTD_overlapCopy8 then a wildcopy with overlap)
    copyMatch dst, op, match, sequence.matchLength
    ZSTD_execSequence = sequenceLength
End Function

'--------------------------------------------------------------------------
' Sequence decoding

' ZSTD_initFseState: the state's table is the DCtx's table of kind k
Private Function ZSTD_initFseState(bitD As BIT_DStream_t, src() As Byte, ByVal tableLog As Long) As Long
    ZSTD_initFseState = BIT_readBits(bitD, tableLog)
    BIT_reloadDStream bitD, src
End Function

' ZSTD_decodeSequence (ZSTD_p_noPrefetch; the prefetching decoder's extra work only computes prefetch addresses)
Private Sub ZSTD_decodeSequence(seq As seq_t, seqState As seqState_t, src() As Byte, ByVal longOffsets As Boolean)
    Dim llBase As Long, mlBase As Long, ofBase As Long, llBits As Long, mlBits As Long, ofBits As Long
    Dim offset As Long, extraBits As Long, ll0 As Long, temp As Long, room As Long
    Dim stLL As Long, stML As Long, stOF As Long

    stLL = seqState.stateLL
    stML = seqState.stateML
    stOF = seqState.stateOffb
    llBase = LLT_base(stLL)
    mlBase = MLT_base(stML)
    ofBase = OFT_base(stOF)
    llBits = LLT_addBits(stLL)
    mlBits = MLT_addBits(stML)
    ofBits = OFT_addBits(stOF)

    ' sequence
    If ofBits > 1 Then
        If longOffsets And (ofBits >= STREAM_ACCUMULATOR_MIN_32) Then
            ' extraBits = ofBits - MIN(ofBits, 32 - bitsConsumed) (unsigned)
            room = 32 - seqState.DStream.bitsConsumed
            If zULT(room, ofBits) Then extraBits = ofBits - room Else extraBits = 0
            offset = ofBase + (BIT_readBitsFast(seqState.DStream, ofBits - extraBits) * pow2(extraBits))
            BIT_reloadDStream seqState.DStream, src
            If extraBits <> 0 Then offset = offset + BIT_readBitsFast(seqState.DStream, extraBits)
        Else
            offset = ofBase + BIT_readBitsFast(seqState.DStream, ofBits)   ' <=  (ZSTD_WINDOWLOG_MAX-1) bits
            BIT_reloadDStream seqState.DStream, src  ' (MEM_32bits())
        End If
        seqState.prevOffset(2) = seqState.prevOffset(1)
        seqState.prevOffset(1) = seqState.prevOffset(0)
        seqState.prevOffset(0) = offset
    Else
        If llBase = 0 Then ll0 = 1 Else ll0 = 0
        If ofBits = 0 Then
            If ll0 = 0 Then
                offset = seqState.prevOffset(0)
            Else
                offset = seqState.prevOffset(1)
                seqState.prevOffset(1) = seqState.prevOffset(0)
                seqState.prevOffset(0) = offset
            End If
        Else
            offset = ofBase + ll0 + BIT_readBitsFast(seqState.DStream, 1)
            If offset = 3 Then temp = seqState.prevOffset(0) - 1 Else temp = seqState.prevOffset(offset)
            If temp = 0 Then temp = 1  ' 0 is not valid; input is corrupted; force offset to 1
            If offset <> 1 Then seqState.prevOffset(2) = seqState.prevOffset(1)
            seqState.prevOffset(1) = seqState.prevOffset(0)
            offset = temp
            seqState.prevOffset(0) = offset
        End If
    End If
    seq.offset = offset

    seq.matchLength = mlBase
    If mlBits > 0 Then seq.matchLength = seq.matchLength + BIT_readBitsFast(seqState.DStream, mlBits)

    If mlBits + llBits >= STREAM_ACCUMULATOR_MIN_32 - LONG_OFFSETS_MAX_EXTRA_BITS_32 Then BIT_reloadDStream seqState.DStream, src

    seq.litLength = llBase
    If llBits > 0 Then seq.litLength = seq.litLength + BIT_readBitsFast(seqState.DStream, llBits)
    BIT_reloadDStream seqState.DStream, src  ' (MEM_32bits())

    ' ANS state update (gcc: ZSTD_updateFseState, the cells read again: the same as with the cells above)
    seqState.stateLL = LLT_next(stLL) + BIT_readBits(seqState.DStream, LLT_nbBits(stLL))  ' <=  9 bits
    seqState.stateML = MLT_next(stML) + BIT_readBits(seqState.DStream, MLT_nbBits(stML))  ' <=  9 bits
    BIT_reloadDStream seqState.DStream, src  ' <= 18 bits (MEM_32bits())
    seqState.stateOffb = OFT_next(stOF) + BIT_readBits(seqState.DStream, OFT_nbBits(stOF))    ' <=  8 bits
End Sub

' ZSTD_decompressSequences_body: dst(ostart .. ostart + maxDstSize - 1); the sequences are src(ip .. ip + seqSize - 1)
Private Function ZSTD_decompressSequences(dst() As Byte, ByVal ostart As Long, ByVal maxDstSize As Long, src() As Byte, ByVal ip As Long, ByVal seqSize As Long, ByVal nbSeq As Long, ByVal isLongOffset As Boolean) As Long
    Dim iend As Long, oend As Long, op As Long, lp As Long, litEnd As Long
    Dim seqState As seqState_t, sequence As seq_t, i As Long, oneSeqSize As Long, err_ As Long, lastLLSize As Long

    iend = ip + seqSize
    oend = ostart + maxDstSize
    op = ostart
    lp = litPtr
    litEnd = lp + litSize

    If nbSeq <> 0 Then
        err_ = 0
        fseEntropy = 1
        For i = 0 To 2
            seqState.prevOffset(i) = rep(i)
        Next i
        If zstdIsError(BIT_initDStream(seqState.DStream, src, ip, iend - ip)) Then ZSTD_decompressSequences = ERR_corruption_detected: Exit Function
        seqState.stateLL = ZSTD_initFseState(seqState.DStream, src, LLT_tableLog)
        seqState.stateOffb = ZSTD_initFseState(seqState.DStream, src, OFT_tableLog)
        seqState.stateML = ZSTD_initFseState(seqState.DStream, src, MLT_tableLog)

        Do
            ZSTD_decodeSequence sequence, seqState, src, isLongOffset
            oneSeqSize = ZSTD_execSequence(dst, op, oend, sequence, src, lp, litEnd, prefixStart, virtualStart, dictEnd)
            BIT_reloadDStream seqState.DStream, src
            op = op + oneSeqSize
            If zstdIsError(oneSeqSize) Then
                err_ = oneSeqSize
                Exit Do
            End If
            nbSeq = nbSeq - 1
            If nbSeq = 0 Then Exit Do
        Loop

        ' check if reached exact end
        If zstdIsError(err_) Then ZSTD_decompressSequences = err_: Exit Function
        If nbSeq <> 0 Then ZSTD_decompressSequences = ERR_corruption_detected: Exit Function
        If BIT_reloadDStream(seqState.DStream, src) < BIT_DStream_completed Then ZSTD_decompressSequences = ERR_corruption_detected: Exit Function
        ' save reps for next block
        For i = 0 To 2
            rep(i) = seqState.prevOffset(i)
        Next i
    End If

    ' last literal segment
    lastLLSize = litEnd - lp
    If zULT(oend - op, lastLLSize) Then ZSTD_decompressSequences = ERR_dstSize_tooSmall: Exit Function
    copyLiterals dst, op, src, lp, lastLLSize
    op = op + lastLLSize

    ZSTD_decompressSequences = op - ostart
End Function

' ZSTD_decompressSequencesLong_body (the prefetching decoder: 4 sequences decoded ahead of their execution)
Private Function ZSTD_decompressSequencesLong(dst() As Byte, ByVal ostart As Long, ByVal maxDstSize As Long, src() As Byte, ByVal ip As Long, ByVal seqSize As Long, ByVal nbSeq As Long, ByVal isLongOffset As Boolean) As Long
    Dim iend As Long, oend As Long, op As Long, lp As Long, litEnd As Long
    Dim sequences(0 To STORED_SEQS - 1) As seq_t, seqAdvance As Long, seqState As seqState_t, seqNb As Long
    Dim sequence As seq_t, i As Long, oneSeqSize As Long, lastLLSize As Long

    iend = ip + seqSize
    oend = ostart + maxDstSize
    op = ostart
    lp = litPtr
    litEnd = lp + litSize

    ' Regen sequences
    If nbSeq <> 0 Then
        If nbSeq < ADVANCED_SEQS Then seqAdvance = nbSeq Else seqAdvance = ADVANCED_SEQS
        fseEntropy = 1
        For i = 0 To 2
            seqState.prevOffset(i) = rep(i)
        Next i
        ' (seqState.prefixStart, pos, dictEnd: for the prefetch addresses only)
        If zstdIsError(BIT_initDStream(seqState.DStream, src, ip, iend - ip)) Then ZSTD_decompressSequencesLong = ERR_corruption_detected: Exit Function
        seqState.stateLL = ZSTD_initFseState(seqState.DStream, src, LLT_tableLog)
        seqState.stateOffb = ZSTD_initFseState(seqState.DStream, src, OFT_tableLog)
        seqState.stateML = ZSTD_initFseState(seqState.DStream, src, MLT_tableLog)

        ' prepare in advance
        seqNb = 0
        Do
            If BIT_reloadDStream(seqState.DStream, src) > BIT_DStream_completed Then Exit Do
            If seqNb >= seqAdvance Then Exit Do
            ZSTD_decodeSequence sequences(seqNb), seqState, src, isLongOffset
            seqNb = seqNb + 1
        Loop
        If seqNb < seqAdvance Then ZSTD_decompressSequencesLong = ERR_corruption_detected: Exit Function

        ' decode and decompress
        Do
            If BIT_reloadDStream(seqState.DStream, src) > BIT_DStream_completed Then Exit Do
            If seqNb >= nbSeq Then Exit Do
            ZSTD_decodeSequence sequence, seqState, src, isLongOffset
            oneSeqSize = ZSTD_execSequence(dst, op, oend, sequences((seqNb - ADVANCED_SEQS) And STORED_SEQS_MASK), src, lp, litEnd, prefixStart, virtualStart, dictEnd)
            If zstdIsError(oneSeqSize) Then ZSTD_decompressSequencesLong = oneSeqSize: Exit Function
            sequences(seqNb And STORED_SEQS_MASK) = sequence
            op = op + oneSeqSize
            seqNb = seqNb + 1
        Loop
        If seqNb < nbSeq Then ZSTD_decompressSequencesLong = ERR_corruption_detected: Exit Function

        ' finish queue
        seqNb = seqNb - seqAdvance
        Do While seqNb < nbSeq
            oneSeqSize = ZSTD_execSequence(dst, op, oend, sequences(seqNb And STORED_SEQS_MASK), src, lp, litEnd, prefixStart, virtualStart, dictEnd)
            If zstdIsError(oneSeqSize) Then ZSTD_decompressSequencesLong = oneSeqSize: Exit Function
            op = op + oneSeqSize
            seqNb = seqNb + 1
        Loop

        ' save reps for next block
        For i = 0 To 2
            rep(i) = seqState.prevOffset(i)
        Next i
    End If

    ' last literal segment
    lastLLSize = litEnd - lp
    If zULT(oend - op, lastLLSize) Then ZSTD_decompressSequencesLong = ERR_dstSize_tooSmall: Exit Function
    copyLiterals dst, op, src, lp, lastLLSize
    op = op + lastLLSize

    ZSTD_decompressSequencesLong = op - ostart
End Function

' ZSTD_getLongOffsetsShare: the share of the OF table's cells with more than 22 additional bits, scaled to 256
Private Function ZSTD_getLongOffsetsShare() As Long
    Dim tableLog As Long, max_ As Long, u As Long, total As Long
    tableLog = OFT_tableLog
    max_ = pow2(tableLog)
    total = 0
    For u = 0 To max_ - 1
        If OFT_addBits(u) > 22 Then total = total + 1
    Next u
    total = total * pow2(OffFSELog - tableLog) ' scale to OffFSELog
    ZSTD_getLongOffsetsShare = total
End Function

' ZSTD_decompressBlock_internal: dst(op .. op + dstCapacity - 1), src(ip .. ip + srcSize - 1); windowSize is the
' frame's dctx->fParams.windowSize (a Double: a U64)
Public Function ZSTD_decompressBlock_internal(dst() As Byte, ByVal op As Long, ByVal dstCapacity As Long, src() As Byte, ByVal ip As Long, ByVal srcSize As Long, ByVal frame As Boolean, ByVal windowSize As Double) As Long
    Dim isLongOffset As Boolean, litCSize As Long, usePrefetchDecoder As Boolean, nbSeq As Long, seqHSize As Long
    Dim shareLongOffsets As Long, minShare As Long

    If Not initialised Then initTables
    ' blockType == blockCompressed
    isLongOffset = (Not frame) Or (windowSize > 33554432#)    ' MEM_32bits() && (!frame || windowSize > 1 << 25)

    If srcSize >= ZSTD_BLOCKSIZE_MAX Then ZSTD_decompressBlock_internal = ERR_srcSize_wrong: Exit Function

    ' Decode literals section
    litCSize = ZSTD_decodeLiteralsBlock(src, ip, srcSize)
    If zstdIsError(litCSize) Then ZSTD_decompressBlock_internal = litCSize: Exit Function
    ip = ip + litCSize
    srcSize = srcSize - litCSize

    ' Build Decoding Tables
    ' These macros control at build-time which decompressor implementation we use. If neither is defined, we do
    ' some inspection and dispatch at runtime.
    usePrefetchDecoder = (ddictIsCold <> 0)
    seqHSize = ZSTD_decodeSeqHeaders(nbSeq, src, ip, srcSize)
    If zstdIsError(seqHSize) Then ZSTD_decompressBlock_internal = seqHSize: Exit Function
    ip = ip + seqHSize
    srcSize = srcSize - seqHSize

    ' (RETURN_ERROR_IF(dst == NULL && nbSeq > 0, dstSize_tooSmall): dst is never NULL here)

    If (Not usePrefetchDecoder) And ((Not frame) Or (windowSize > 16777216#)) And (nbSeq > ADVANCED_SEQS) Then ' could probably use a larger nbSeq limit
        shareLongOffsets = ZSTD_getLongOffsetsShare()
        minShare = 20   ' MEM_64bits() ? 7 : 20: heuristic values, correspond to 2.73% and 7.81%
        usePrefetchDecoder = (shareLongOffsets >= minShare)
    End If

    ddictIsCold = 0

    If usePrefetchDecoder Then
        ZSTD_decompressBlock_internal = ZSTD_decompressSequencesLong(dst, op, dstCapacity, src, ip, srcSize, nbSeq, isLongOffset)
        Exit Function
    End If

    ' else
    ZSTD_decompressBlock_internal = ZSTD_decompressSequences(dst, op, dstCapacity, src, ip, srcSize, nbSeq, isLongOffset)
End Function
