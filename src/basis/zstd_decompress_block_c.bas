Attribute VB_Name = "zstd_decompress_block_c"
' zstd 1.4.9's decompress/zstd_decompress_block.c as ref/basis_universal/zstd/zstddeclib.c has it: a compressed
' block's literals (raw, RLE, Huffman through zstd_entropy_c) and sequences (the FSE tables, the decoding with the
' 32-bit build's bit-container reloads, the execution), and ZSTD_getcBlockSize / ZSTD_checkContinuity. The
' block-level fields of the DCtx (ZSTD_decompress's one context) are this module's: the literal buffer and its
' pointer, the repeat offsets, the three sequence tables, the entropy flags, the segment pointers.
'
' C pointers are offsets: into the block's source array or the literal buffer (the literal pointer says which,
' C: dctx->litPtr either points into the source or at dctx->litBuffer), into the destination array for the
' others. Copies are exact: C's wildcopy writes up to WILDCOPY_OVERLENGTH bytes past what a sequence regenerates
' (later output overwrites them; bytes past the returned size are left as garbage in C); here only the
' regenerated bytes are written, which gives the same output. A sequence table is held in the DCtx's table
' space even when C points at a default table (set_basic copies the default table there: the active table is
' the same, and set_repeat reuses it as C does). The 32-bit build: MEM_32bits(), the long-offset path when the
' window is over 32 MB, the prefetching decoder when it is over 16 MB with 20/256 long offsets or more.
Option Explicit

Private Declare Sub CopyMemory Lib "kernel32" Alias "RtlMoveMemory" (dest As Any, src As Any, ByVal n As Long)

Private Const ERR_GENERIC As Long = -1
Private Const ERR_corruption_detected As Long = -20
Private Const ERR_dictionary_corrupted As Long = -30
Private Const ERR_dstSize_tooSmall As Long = -70
Private Const ERR_srcSize_wrong As Long = -72
Private Const ERROR_maxCode As Long = 120

Private Const ZSTD_BLOCKSIZE_MAX As Long = 131072       ' 1 << ZSTD_BLOCKSIZELOG_MAX
Private Const WILDCOPY_OVERLENGTH As Long = 32
Private Const WILDCOPY_VECLEN As Long = 16
Private Const MIN_CBLOCK_SIZE As Long = 3                ' 1 + 1 + MIN_SEQUENCES_SIZE
Private Const MIN_SEQUENCES_SIZE As Long = 1
Private Const LONGNBSEQ As Long = &H7F00&
Private Const MaxLL As Long = 35
Private Const MaxML As Long = 52
Private Const MaxOff As Long = 31
Private Const LLFSELog As Long = 9
Private Const MLFSELog As Long = 9
Private Const OffFSELog As Long = 8
Private Const STREAM_ACCUMULATOR_MIN_32 As Long = 25
Private Const LONG_OFFSETS_MAX_EXTRA_BITS_32 As Long = 5 ' ZSTD_WINDOWLOG_MAX_32 - STREAM_ACCUMULATOR_MIN_32
Private Const ADVANCED_SEQS As Long = 4
Private Const STORED_SEQS As Long = 4
Private Const STORED_SEQS_MASK As Long = 3
Private Const HUF_DECOMPRESS_WORKSPACE_SIZE As Long = 2048   ' sizeof(dctx->workspace)
' (VB) copies shorter than this are byte loops (RtlMoveMemory's call costs more); so are overlapping matches
' with offsets under COPY_LOOP_OFFSET (their pieces would be that short)
Private Const COPY_LOOP_MAX As Long = 64
Private Const COPY_LOOP_OFFSET As Long = 32

' symbolEncodingType_e
Private Const set_basic As Long = 0
Private Const set_rle As Long = 1
Private Const set_compressed As Long = 2
Private Const set_repeat As Long = 3
' blockType_e
Private Const bt_raw As Long = 0
Private Const bt_rle As Long = 1
Private Const bt_compressed As Long = 2
Private Const bt_reserved As Long = 3

Private Const BIT_DStream_unfinished As Long = 0
Private Const BIT_DStream_endOfBuffer As Long = 1
Private Const BIT_DStream_completed As Long = 2
Private Const BIT_DStream_overflow As Long = 3

Private Type BIT_DStream_t
    bitContainer As Long
