    If (decomp_flags And TINFL_FLAG_PARSE_ZLIB_HEADER) <> 0 Then
        ' TINFL_SKIP_BITS(32, num_bits And 7)
        If num_bits < (num_bits And 7) Then
            Do                                      ' TINFL_NEED_BITS(32, num_bits And 7)
                ' TINFL_GET_BYTE(32, c)
                If pIn_buf_cur >= pIn_buf_end Then
                    Do
                        If (decomp_flags And TINFL_FLAG_HAS_MORE_INPUT) <> 0 Then
                            status = TINFL_STATUS_NEEDS_MORE_INPUT: r.m_state = 32: GoTo common_exit       ' TINFL_CR_RETURN(32, TINFL_STATUS_NEEDS_MORE_INPUT)
cr_32:
                            If pIn_buf_cur < pIn_buf_end Then
                                c = pIn(pIn_buf_cur)
                                pIn_buf_cur = pIn_buf_cur + 1
                                Exit Do
                            End If
                        Else
                            c = 0
                            Exit Do
                        End If
                    Loop
                Else
                    c = pIn(pIn_buf_cur)
                    pIn_buf_cur = pIn_buf_cur + 1
                End If
                bit_buf = bit_buf Or (c * pow2(num_bits))
                num_bits = num_bits + 8
            Loop While num_bits < (num_bits And 7)
        End If
        bit_buf = bit_buf \ pow2(num_bits And 7)
        num_bits = num_bits - (num_bits And 7)
        counter = 0
        Do While counter < 4
            If num_bits <> 0 Then
                ' TINFL_GET_BITS(41, s, 8)
                If num_bits < (8) Then
                    Do                                      ' TINFL_NEED_BITS(41, 8)
                        ' TINFL_GET_BYTE(41, c)
                        If pIn_buf_cur >= pIn_buf_end Then
                            Do
                                If (decomp_flags And TINFL_FLAG_HAS_MORE_INPUT) <> 0 Then
                                    status = TINFL_STATUS_NEEDS_MORE_INPUT: r.m_state = 41: GoTo common_exit       ' TINFL_CR_RETURN(41, TINFL_STATUS_NEEDS_MORE_INPUT)
cr_41:
                                    If pIn_buf_cur < pIn_buf_end Then
                                        c = pIn(pIn_buf_cur)
                                        pIn_buf_cur = pIn_buf_cur + 1
                                        Exit Do
                                    End If
                                Else
                                    c = 0
                                    Exit Do
                                End If
                            Loop
                        Else
                            c = pIn(pIn_buf_cur)
                            pIn_buf_cur = pIn_buf_cur + 1
                        End If
                        bit_buf = bit_buf Or (c * pow2(num_bits))
                        num_bits = num_bits + 8
                    Loop While num_bits < (8)
                End If
                s = bit_buf And (pow2(8) - 1)
                bit_buf = bit_buf \ pow2(8)
                num_bits = num_bits - (8)
            Else
                ' TINFL_GET_BYTE(42, s)
                If pIn_buf_cur >= pIn_buf_end Then
                    Do
                        If (decomp_flags And TINFL_FLAG_HAS_MORE_INPUT) <> 0 Then
                            status = TINFL_STATUS_NEEDS_MORE_INPUT: r.m_state = 42: GoTo common_exit       ' TINFL_CR_RETURN(42, TINFL_STATUS_NEEDS_MORE_INPUT)
cr_42:
                            If pIn_buf_cur < pIn_buf_end Then
                                s = pIn(pIn_buf_cur)
                                pIn_buf_cur = pIn_buf_cur + 1
                                Exit Do
                            End If
                        Else
                            s = 0
                            Exit Do
                        End If
                    Loop
                Else
                    s = pIn(pIn_buf_cur)
                    pIn_buf_cur = pIn_buf_cur + 1
                End If
            End If
            r.m_z_adler32 = SHL(r.m_z_adler32, 8) Or s
            counter = counter + 1
        Loop
    End If
cr_34:
    status = TINFL_STATUS_DONE: r.m_state = 34: GoTo common_exit       ' TINFL_CR_RETURN_FOREVER(34, TINFL_STATUS_DONE)
    ' TINFL_CR_FINISH

common_exit:
    r.m_num_bits = num_bits: r.m_bit_buf = bit_buf: r.m_dist = dist: r.m_counter = counter: r.m_num_extra = num_extra: r.m_dist_from_out_buf_start = dist_from_out_buf_start
    pIn_buf_size = pIn_buf_cur - pIn_buf_next: pOut_buf_size = pOut_buf_cur - pOut_buf_next
    If ((decomp_flags And (TINFL_FLAG_PARSE_ZLIB_HEADER Or TINFL_FLAG_COMPUTE_ADLER32)) <> 0) And (status >= 0) Then
        ptr = pOut_buf_next: buf_len = pOut_buf_size
        s1 = r.m_check_adler32 And &HFFFF&: s2 = SHRU(r.m_check_adler32, 16): block_len = buf_len Mod ADLER_BLOCK
        Do While buf_len <> 0
            i = 0
            Do While i + 7 < block_len
                s1 = s1 + pOut(ptr): s2 = s2 + s1: s1 = s1 + pOut(ptr + 1): s2 = s2 + s1: s1 = s1 + pOut(ptr + 2): s2 = s2 + s1: s1 = s1 + pOut(ptr + 3): s2 = s2 + s1
                s1 = s1 + pOut(ptr + 4): s2 = s2 + s1: s1 = s1 + pOut(ptr + 5): s2 = s2 + s1: s1 = s1 + pOut(ptr + 6): s2 = s2 + s1: s1 = s1 + pOut(ptr + 7): s2 = s2 + s1
                i = i + 8: ptr = ptr + 8
            Loop
            Do While i < block_len
                s1 = s1 + pOut(ptr): s2 = s2 + s1
                ptr = ptr + 1: i = i + 1
            Loop
            s1 = s1 Mod 65521: s2 = s2 Mod 65521: buf_len = buf_len - block_len: block_len = ADLER_BLOCK
        Loop
        r.m_check_adler32 = SHL(s2, 16) Or s1
        If (status = TINFL_STATUS_DONE) And ((decomp_flags And TINFL_FLAG_PARSE_ZLIB_HEADER) <> 0) And (r.m_check_adler32 <> r.m_z_adler32) Then status = TINFL_STATUS_ADLER32_MISMATCH
    End If
    tinfl_decompress = status
End Function

' (VB) zalloc(opaque, 1, sizeof(inflate_state)): a free entry of the pool, or a new one (its dictionary allocated)
Private Function inflateState_alloc() As Long
    Dim i As Long
    For i = 1 To inflateStatesCount
        If Not inflateStates(i).inUse Then Exit For
    Next
    If i > inflateStatesCount Then
        inflateStatesCount = inflateStatesCount + 1
        ReDim Preserve inflateStates(1 To inflateStatesCount)
        ReDim inflateStates(i).m_dict(0 To TINFL_LZ_DICT_SIZE - 1)
    End If
    inflateStates(i).inUse = True
    inflateState_alloc = i
End Function

Public Function mz_inflateInit2(pStream As z_stream, ByVal window_bits As Long) As Long
    Dim pDecomp As Long
    ' (if (!pStream) return MZ_STREAM_ERROR;: a VB stream is never NULL)
    If (window_bits <> MZ_DEFAULT_WINDOW_BITS) And (-window_bits <> MZ_DEFAULT_WINDOW_BITS) Then
        mz_inflateInit2 = MZ_PARAM_ERROR
        Exit Function
    End If

    pStream.data_type = 0
    pStream.adler = 0
    pStream.msg = vbNullString
    pStream.total_in = 0
    pStream.total_out = 0
    pStream.reserved = 0
    ' if (!pStream->zalloc) pStream->zalloc = def_alloc_func;
    ' if (!pStream->zfree) pStream->zfree = def_free_func;

    pDecomp = inflateState_alloc()          ' pStream->zalloc(pStream->opaque, 1, sizeof(inflate_state))
    If pDecomp = 0 Then
        mz_inflateInit2 = MZ_MEM_ERROR
        Exit Function
    End If

    pStream.state = pDecomp

    inflateStates(pDecomp).m_decomp.m_state = 0             ' tinfl_init(&pDecomp->m_decomp)
    inflateStates(pDecomp).m_dict_ofs = 0
    inflateStates(pDecomp).m_dict_avail = 0
    inflateStates(pDecomp).m_last_status = TINFL_STATUS_NEEDS_MORE_INPUT
    inflateStates(pDecomp).m_first_call = 1
    inflateStates(pDecomp).m_has_flushed = 0
    inflateStates(pDecomp).m_window_bits = window_bits

    mz_inflateInit2 = MZ_OK
End Function

Public Function mz_inflateInit(pStream As z_stream) As Long
    mz_inflateInit = mz_inflateInit2(pStream, MZ_DEFAULT_WINDOW_BITS)
End Function

' (VB) next_in / next_out: offsets into inBuf / outBuf
Public Function mz_inflate(pStream As z_stream, ByVal flush As Long, inBuf() As Byte, outBuf() As Byte) As Long
    Dim pState As Long, n As Long, first_call As Long, decomp_flags As Long
    Dim in_bytes As Long, out_bytes As Long, orig_avail_in As Long, status As Long
    decomp_flags = TINFL_FLAG_COMPUTE_ADLER32

    If pStream.state = 0 Then
        mz_inflate = MZ_STREAM_ERROR
        Exit Function
    End If
    If flush = MZ_PARTIAL_FLUSH Then flush = MZ_SYNC_FLUSH
    If (flush <> 0) And (flush <> MZ_SYNC_FLUSH) And (flush <> MZ_FINISH) Then
        mz_inflate = MZ_STREAM_ERROR
        Exit Function
    End If

    pState = pStream.state
    If inflateStates(pState).m_window_bits > 0 Then decomp_flags = decomp_flags Or TINFL_FLAG_PARSE_ZLIB_HEADER
    orig_avail_in = pStream.avail_in

    first_call = inflateStates(pState).m_first_call: inflateStates(pState).m_first_call = 0
    If inflateStates(pState).m_last_status < 0 Then
        mz_inflate = MZ_DATA_ERROR
        Exit Function
    End If

    If (inflateStates(pState).m_has_flushed <> 0) And (flush <> MZ_FINISH) Then
        mz_inflate = MZ_STREAM_ERROR
        Exit Function
    End If
    If flush = MZ_FINISH Then inflateStates(pState).m_has_flushed = inflateStates(pState).m_has_flushed Or 1

    If (flush = MZ_FINISH) And (first_call <> 0) Then
        ' MZ_FINISH on the first call implies that the input and output buffers are large enough to hold the entire compressed/decompressed file.
        decomp_flags = decomp_flags Or TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF
        in_bytes = pStream.avail_in: out_bytes = pStream.avail_out
        status = tinfl_decompress(inflateStates(pState).m_decomp, inBuf, pStream.next_in, in_bytes, outBuf, pStream.next_out, pStream.next_out, out_bytes, decomp_flags)
        inflateStates(pState).m_last_status = status
        pStream.next_in = pStream.next_in + in_bytes: pStream.avail_in = pStream.avail_in - in_bytes: pStream.total_in = pStream.total_in + in_bytes
        pStream.adler = inflateStates(pState).m_decomp.m_check_adler32     ' tinfl_get_adler32(&pState->m_decomp)
        pStream.next_out = pStream.next_out + out_bytes: pStream.avail_out = pStream.avail_out - out_bytes: pStream.total_out = pStream.total_out + out_bytes

        If status < 0 Then
            mz_inflate = MZ_DATA_ERROR
            Exit Function
        ElseIf status <> TINFL_STATUS_DONE Then
            inflateStates(pState).m_last_status = TINFL_STATUS_FAILED
            mz_inflate = MZ_BUF_ERROR
            Exit Function
        End If
        mz_inflate = MZ_STREAM_END
        Exit Function
    End If
    ' flush != MZ_FINISH then we must assume there's more input.
    If flush <> MZ_FINISH Then decomp_flags = decomp_flags Or TINFL_FLAG_HAS_MORE_INPUT

    If inflateStates(pState).m_dict_avail <> 0 Then
        n = inflateStates(pState).m_dict_avail                ' MZ_MIN(pState->m_dict_avail, pStream->avail_out)
        If pStream.avail_out < n Then n = pStream.avail_out
        If n > 0 Then CopyMemory VarPtr(outBuf(pStream.next_out)), VarPtr(inflateStates(pState).m_dict(inflateStates(pState).m_dict_ofs)), n
        pStream.next_out = pStream.next_out + n: pStream.avail_out = pStream.avail_out - n: pStream.total_out = pStream.total_out + n
        inflateStates(pState).m_dict_avail = inflateStates(pState).m_dict_avail - n
        inflateStates(pState).m_dict_ofs = (inflateStates(pState).m_dict_ofs + n) And (TINFL_LZ_DICT_SIZE - 1)
        If (inflateStates(pState).m_last_status = TINFL_STATUS_DONE) And (inflateStates(pState).m_dict_avail = 0) Then
            mz_inflate = MZ_STREAM_END
        Else
            mz_inflate = MZ_OK
        End If
        Exit Function
    End If

    Do
        in_bytes = pStream.avail_in
        out_bytes = TINFL_LZ_DICT_SIZE - inflateStates(pState).m_dict_ofs

        status = tinfl_decompress(inflateStates(pState).m_decomp, inBuf, pStream.next_in, in_bytes, inflateStates(pState).m_dict, 0, inflateStates(pState).m_dict_ofs, out_bytes, decomp_flags)
        inflateStates(pState).m_last_status = status

        pStream.next_in = pStream.next_in + in_bytes: pStream.avail_in = pStream.avail_in - in_bytes
        pStream.total_in = pStream.total_in + in_bytes: pStream.adler = inflateStates(pState).m_decomp.m_check_adler32

        inflateStates(pState).m_dict_avail = out_bytes

        n = inflateStates(pState).m_dict_avail                ' MZ_MIN(pState->m_dict_avail, pStream->avail_out)
        If pStream.avail_out < n Then n = pStream.avail_out
        If n > 0 Then CopyMemory VarPtr(outBuf(pStream.next_out)), VarPtr(inflateStates(pState).m_dict(inflateStates(pState).m_dict_ofs)), n
        pStream.next_out = pStream.next_out + n: pStream.avail_out = pStream.avail_out - n: pStream.total_out = pStream.total_out + n
        inflateStates(pState).m_dict_avail = inflateStates(pState).m_dict_avail - n
        inflateStates(pState).m_dict_ofs = (inflateStates(pState).m_dict_ofs + n) And (TINFL_LZ_DICT_SIZE - 1)

        If status < 0 Then
            mz_inflate = MZ_DATA_ERROR       ' Stream is corrupted (there could be some uncompressed data left in the output dictionary - oh well).
            Exit Function
        ElseIf (status = TINFL_STATUS_NEEDS_MORE_INPUT) And (orig_avail_in = 0) Then
            mz_inflate = MZ_BUF_ERROR        ' Signal caller that we can't make forward progress without supplying more input or by setting flush to MZ_FINISH.
            Exit Function
        ElseIf flush = MZ_FINISH Then
            ' The output buffer MUST be large to hold the remaining uncompressed data when flush==MZ_FINISH.
            If status = TINFL_STATUS_DONE Then
                If inflateStates(pState).m_dict_avail <> 0 Then mz_inflate = MZ_BUF_ERROR Else mz_inflate = MZ_STREAM_END
                Exit Function
            ' status here must be TINFL_STATUS_HAS_MORE_OUTPUT, which means there's at least 1 more byte on the way. If there's no more room left in the output buffer then something is wrong.
            ElseIf pStream.avail_out = 0 Then
                mz_inflate = MZ_BUF_ERROR
                Exit Function
            End If
        ElseIf (status = TINFL_STATUS_DONE) Or (pStream.avail_in = 0) Or (pStream.avail_out = 0) Or (inflateStates(pState).m_dict_avail <> 0) Then
            Exit Do
        End If
    Loop

    If (status = TINFL_STATUS_DONE) And (inflateStates(pState).m_dict_avail = 0) Then
        mz_inflate = MZ_STREAM_END
    Else
        mz_inflate = MZ_OK
    End If
End Function

Public Function mz_inflateEnd(pStream As z_stream) As Long
    ' (if (!pStream) return MZ_STREAM_ERROR;: a VB stream is never NULL)
    If pStream.state <> 0 Then
        def_free_func pStream.state                         ' pStream->zfree(pStream->opaque, pStream->state)
        pStream.state = 0
    End If
    mz_inflateEnd = MZ_OK
End Function

' (VB) def_free_func's half for this pool: the entry's back to free (its dictionary kept for the next stream)
Public Sub miniz_inflateStateFree(ByVal handle As Long)
    inflateStates(handle).inUse = False
End Sub
